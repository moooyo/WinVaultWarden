{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winvaultwarden.local/protocol/browser-passkey-v1.schema.json",
  "title": "WinVaultWarden Browser Passkey Protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/cancel" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/ping" },
    { "$ref": "#/$defs/pong" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameOrigin",
        "topOrigin",
        "tabId",
        "frameId",
        "documentId",
        "publicKeyCredentialsGetAllowed",
        "sameOriginWithAncestors",
        "publicKeyCredentialsCreateAllowed"
      ],
      "properties": {
        "frameOrigin": { "type": "string", "minLength": 1 },
        "topOrigin": { "type": "string", "minLength": 1 },
        "tabId": { "type": "integer", "minimum": 0 },
        "frameId": { "type": "integer", "minimum": 0 },
        "documentId": { "type": "string", "minLength": 1 },
        "publicKeyCredentialsGetAllowed": { "type": "boolean" },
        "sameOriginWithAncestors": { "type": "boolean" },
        "publicKeyCredentialsCreateAllowed": { "type": "boolean" }
      }
    },
    "pagePayload": {
      "description": "Page-authored payload before the isolated relay removes untrusted identity fields.",
      "type": "object",
      "not": {
        "anyOf": [
          { "required": ["origin"] },
          { "required": ["crossOrigin"] },
          { "required": ["context"] },
          { "required": ["frameOrigin"] },
          { "required": ["topOrigin"] },
          { "required": ["sameOriginWithAncestors"] }
        ]
      }
    },
    "payload": {
      "description": "Native-host payload after the background worker overwrites origin fields using trusted browser context.",
      "type": "object",
      "required": ["origin"],
      "properties": {
        "origin": { "type": "string", "minLength": 1 },
        "crossOrigin": { "type": "boolean" },
        "topOrigin": { "type": "string", "minLength": 1 }
      },
      "not": {
        "anyOf": [
          { "required": ["context"] },
          { "required": ["frameOrigin"] },
          { "required": ["sameOriginWithAncestors"] }
        ]
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id", "type", "deadlineUnixMs", "context", "payload"],
      "properties": {
        "v": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["passkey.create", "passkey.get"] },
        "deadlineUnixMs": { "type": "integer", "minimum": 1 },
        "context": { "$ref": "#/$defs/context" },
        "payload": { "$ref": "#/$defs/payload" }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id", "type"],
      "properties": {
        "v": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "cancel" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1 }
      }
    },
    "ping": {
      "description": "Extension-to-native-host readiness handshake; never forwarded to the App.",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id", "type"],
      "properties": {
        "v": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "ping" }
      }
    },
    "pong": {
      "description": "Native-host readiness response.",
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id", "type", "ok", "payload"],
      "properties": {
        "v": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "pong" },
        "ok": { "const": true },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id", "type", "ok"],
      "properties": {
        "v": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["passkey.create", "passkey.get", "error"] },
        "ok": { "type": "boolean" },
        "payload": { "type": ["object", "null"] },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/error" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
