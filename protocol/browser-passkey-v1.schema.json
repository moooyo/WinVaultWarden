{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winvaultwarden.local/protocol/browser-passkey-v1.schema.json",
  "title": "WinVaultWarden Browser Passkey Protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/cancel" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameOrigin",
        "topOrigin",
        "tabId",
        "frameId",
        "documentId",
        "publicKeyCredentialsGetAllowed"
      ],
      "properties": {
        "frameOrigin": { "type": "string", "minLength": 1 },
        "topOrigin": { "type": "string", "minLength": 1 },
        "tabId": { "type": "integer", "minimum": 0 },
        "frameId": { "type": "integer", "minimum": 0 },
        "documentId": { "type": "string", "minLength": 1 },
        "publicKeyCredentialsGetAllowed": { "type": "boolean" }
      }
    },
    "payload": {
      "type": "object",
      "not": {
        "anyOf": [
          { "required": ["origin"] },
          { "required": ["crossOrigin"] },
          { "required": ["context"] },
          { "required": ["frameOrigin"] },
          { "required": ["topOrigin"] }
        ]
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id", "type", "deadlineUnixMs", "context", "payload"],
      "properties": {
        "v": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["passkey.create", "passkey.get"] },
        "deadlineUnixMs": { "type": "integer", "minimum": 1 },
        "context": { "$ref": "#/$defs/context" },
        "payload": { "$ref": "#/$defs/payload" }
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id", "type"],
      "properties": {
        "v": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "cancel" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1 }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "id", "type", "ok"],
      "properties": {
        "v": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["passkey.create", "passkey.get", "error"] },
        "ok": { "type": "boolean" },
        "payload": { "type": ["object", "null"] },
        "error": {
          "oneOf": [
            { "$ref": "#/$defs/error" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
