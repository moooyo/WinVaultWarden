<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="App.Views.GeneratorHistoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:App.ViewModels.Models"
    xmlns:converters="using:App.Converters"
    Title="生成器历史记录" CloseButtonText="关闭" PrimaryButtonText="清除历史记录"
    DefaultButton="Close" PrimaryButtonClick="OnPrimaryButtonClick">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">620</x:Double>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </ContentDialog.Resources>
    <Grid x:Name="GeneratorHistoryContent" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="仅显示本次解锁期间成功复制的内容，保险库锁定后清除。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <StackPanel Grid.Row="1" Padding="24,36" Spacing="12" HorizontalAlignment="Center"
                    Visibility="{x:Bind ViewModel.IsHistoryEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <FontIcon Glyph="&#xE81C;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="还没有复制过内容" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="返回生成器并复制一个结果后，它会显示在这里。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <ListView Grid.Row="1" x:Name="HistoryList" ItemsSource="{x:Bind ViewModel.History}" SelectionMode="None"
                  Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                  HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0,12" /></Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:GeneratorHistoryItem">
                    <Grid MinHeight="56" ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="{x:Bind Value}" FontFamily="{StaticResource MonospaceFontFamily}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind CreatedAtText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="复制" AutomationProperties.Name="复制此历史记录" Click="OnCopyClick" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <InfoBar Grid.Row="2" x:Name="CopyFeedbackBar" IsOpen="{x:Bind ViewModel.HasCopyFeedback, Mode=OneWay}"
                 Message="{x:Bind ViewModel.CopyFeedback, Mode=OneWay}" IsClosable="False" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</ContentDialog>
