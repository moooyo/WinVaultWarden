<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="App.Views.GeneratorWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:App.Converters"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <StackPanel Spacing="16" HorizontalAlignment="Stretch">
        <RadioButtons x:Name="GeneratorModes" MaxColumns="3" Header="生成类型"
                      AutomationProperties.AutomationId="GeneratorModeSelector"
                      SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
            <RadioButton Content="密码" IsEnabled="{x:Bind ViewModel.CanUsePasswordMode, Mode=OneWay}" />
            <RadioButton Content="密码短语" IsEnabled="{x:Bind ViewModel.CanUsePassphraseMode, Mode=OneWay}" />
            <RadioButton Content="用户名" />
        </RadioButtons>
        <InfoBar AutomationProperties.AutomationId="GeneratorPolicyNotice"
                 IsOpen="{x:Bind ViewModel.HasGeneratorPolicyNotice, Mode=OneWay}" IsClosable="False" Severity="Informational"
                 Message="{x:Bind ViewModel.GeneratorPolicyNotice, Mode=OneWay}" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="20">
            <StackPanel Spacing="16">
                <TextBlock Text="{x:Bind ViewModel.GeneratedValueLabel, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                <TextBlock x:Name="GeneratedValueText" Text="{x:Bind ViewModel.GeneratedPassword, Mode=OneWay}" AutomationProperties.AutomationId="GeneratedCredentialValue"
                           FontFamily="{StaticResource MonospaceFontFamily}" FontSize="24" TextWrapping="Wrap" MinHeight="38" />
                <TextBlock Text="{x:Bind ViewModel.GeneratedValueSummary, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.ShowStrength, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Minimum="0" Maximum="1" Value="{x:Bind ViewModel.StrengthFraction, Mode=OneWay}" AutomationProperties.Name="生成结果强度" />
                    <TextBlock Text="{x:Bind ViewModel.StrengthLabel, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Grid ColumnSpacing="8" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Command="{x:Bind ViewModel.RegenerateCommand}" IsEnabled="{x:Bind ViewModel.CanGenerate, Mode=OneWay}" AutomationProperties.AutomationId="GeneratorRegenerateButton">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE895;" FontSize="14" /><TextBlock Text="重新生成" /></StackPanel>
            </Button>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.CopyCommand}" Style="{StaticResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanCopy, Mode=OneWay}" AutomationProperties.AutomationId="GeneratorCopyButton">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C8;" FontSize="14" /><TextBlock Text="{x:Bind ViewModel.CopyLabel, Mode=OneWay}" /></StackPanel>
            </Button>
        </Grid>
        <InfoBar x:Name="CopyFeedbackBar" IsOpen="{x:Bind ViewModel.HasCopyFeedback, Mode=OneWay}" Message="{x:Bind ViewModel.CopyFeedback, Mode=OneWay}"
                 IsClosable="False" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="GeneratorCopyFeedback" />
        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsPasswordMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="密码选项" Style="{StaticResource SectionHeaderTextBlockStyle}" />
            <tk:SettingsCard Header="长度" Description="根据网站要求选择，最长 128 个字符。" HorizontalContentAlignment="Stretch">
                <Grid ColumnSpacing="12" MinWidth="180">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                    <Slider Minimum="{x:Bind ViewModel.MinimumPasswordLength, Mode=OneWay}" Maximum="128" Value="{x:Bind ViewModel.LengthValue, Mode=TwoWay}" StepFrequency="1"
                            AutomationProperties.Name="密码长度滑块" AutomationProperties.AutomationId="PasswordLengthSlider" />
                    <NumberBox Grid.Column="1" Minimum="{x:Bind ViewModel.MinimumPasswordLength, Mode=OneWay}" Maximum="128"
                               Value="{x:Bind ViewModel.LengthValue, Mode=TwoWay}" SpinButtonPlacementMode="Compact"
                               AutomationProperties.Name="密码长度数值" AutomationProperties.AutomationId="PasswordLengthNumberBox" />
                </Grid>
            </tk:SettingsCard>
            <tk:SettingsCard Header="包含字符" Description="选择网站允许的字符。" HorizontalContentAlignment="Stretch">
                <Grid ColumnSpacing="16" RowSpacing="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <CheckBox Content="A–Z" IsChecked="{x:Bind ViewModel.IncludeUppercase, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanToggleUppercase, Mode=OneWay}"
                              AutomationProperties.Name="包含大写字母" AutomationProperties.AutomationId="IncludeUppercaseCheckBox" />
                    <CheckBox Grid.Column="1" Content="a–z" IsChecked="{x:Bind ViewModel.IncludeLowercase, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanToggleLowercase, Mode=OneWay}"
                              AutomationProperties.Name="包含小写字母" AutomationProperties.AutomationId="IncludeLowercaseCheckBox" />
                    <CheckBox Grid.Row="1" Content="0–9" IsChecked="{x:Bind ViewModel.IncludeNumbers, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanToggleNumbers, Mode=OneWay}"
                              AutomationProperties.Name="包含数字" AutomationProperties.AutomationId="IncludeNumbersCheckBox" />
                    <CheckBox Grid.Row="1" Grid.Column="1" Content="!@#$" IsChecked="{x:Bind ViewModel.IncludeSpecial, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanToggleSpecial, Mode=OneWay}"
                              AutomationProperties.Name="包含特殊字符" AutomationProperties.AutomationId="IncludeSpecialCheckBox" />
                </Grid>
            </tk:SettingsCard>
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="GeneratorAdvancedOptions">
                <Expander.Header><StackPanel Spacing="4"><TextBlock Text="高级选项" /><TextBlock Text="{x:Bind ViewModel.AdvancedOptionsSummary, Mode=OneWay}" Style="{StaticResource CaptionSecondaryTextBlockStyle}" /></StackPanel></Expander.Header>
                <StackPanel Spacing="4">
                    <tk:SettingsCard Header="最少数字个数">
                        <NumberBox Width="96" Minimum="{x:Bind ViewModel.PolicyMinimumNumbers, Mode=OneWay}" Maximum="128" SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind ViewModel.MinNumbersValue, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IncludeNumbers, Mode=OneWay}"
                                   AutomationProperties.Name="最少数字个数" AutomationProperties.AutomationId="MinNumbersNumberBox" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="最少特殊字符个数">
                        <NumberBox Width="96" Minimum="{x:Bind ViewModel.PolicyMinimumSpecial, Mode=OneWay}" Maximum="128" SpinButtonPlacementMode="Compact"
                                   Value="{x:Bind ViewModel.MinSpecialValue, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IncludeSpecial, Mode=OneWay}"
                                   AutomationProperties.Name="最少特殊字符个数" AutomationProperties.AutomationId="MinSpecialNumberBox" />
                    </tk:SettingsCard>
                    <tk:SettingsCard Header="避免易混淆字符" Description="排除 0、O、1、l 等外观相近的字符。">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.AvoidAmbiguous, Mode=TwoWay}" AutomationProperties.Name="避免易混淆字符" />
                    </tk:SettingsCard>
                </StackPanel>
            </Expander>
        </StackPanel>
        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsPassphraseMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="密码短语选项" Style="{StaticResource SectionHeaderTextBlockStyle}" />
            <tk:SettingsCard Header="单词数" Description="更多单词可以增加长度与随机性。">
                <NumberBox Width="96" Minimum="{x:Bind ViewModel.MinimumPassphraseWordCount, Mode=OneWay}" Maximum="20" SpinButtonPlacementMode="Compact"
                           Value="{x:Bind ViewModel.PassphraseWordCountValue, Mode=TwoWay}" AutomationProperties.Name="单词数" AutomationProperties.AutomationId="PassphraseWordCountNumberBox" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="单词分隔符" Description="留空时使用连字符（-）。">
                <TextBox Width="120" Text="{x:Bind ViewModel.PassphraseSeparator, Mode=TwoWay}" AutomationProperties.Name="单词分隔符" AutomationProperties.AutomationId="PassphraseSeparatorTextBox" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="首字母大写">
                <ToggleSwitch IsOn="{x:Bind ViewModel.PassphraseCapitalize, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanTogglePassphraseCapitalize, Mode=OneWay}"
                              AutomationProperties.Name="密码短语首字母大写" AutomationProperties.AutomationId="PassphraseCapitalizeToggle" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="包含数字">
                <ToggleSwitch IsOn="{x:Bind ViewModel.PassphraseIncludeNumber, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanTogglePassphraseIncludeNumber, Mode=OneWay}"
                              AutomationProperties.Name="密码短语包含数字" AutomationProperties.AutomationId="PassphraseIncludeNumberToggle" />
            </tk:SettingsCard>
        </StackPanel>
        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsUsernameMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="用户名选项" Style="{StaticResource SectionHeaderTextBlockStyle}" />
            <tk:SettingsCard Header="类型" HorizontalContentAlignment="Stretch">
                <ComboBox HorizontalAlignment="Stretch" MinWidth="0" SelectedIndex="{x:Bind ViewModel.UsernameTypeIndex, Mode=TwoWay}"
                          AutomationProperties.Name="用户名类型" AutomationProperties.AutomationId="UsernameTypeComboBox">
                    <ComboBoxItem Content="随机单词" /><ComboBoxItem Content="加号邮箱" /><ComboBoxItem Content="全域邮箱" />
                </ComboBox>
            </tk:SettingsCard>
            <tk:SettingsCard Header="首字母大写" Visibility="{x:Bind ViewModel.ShowUsernameWordOptions, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.UsernameCapitalize, Mode=TwoWay}" AutomationProperties.Name="用户名首字母大写" AutomationProperties.AutomationId="UsernameCapitalizeToggle" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="包含 4 位数字" Visibility="{x:Bind ViewModel.ShowUsernameWordOptions, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.UsernameIncludeNumber, Mode=TwoWay}" AutomationProperties.Name="用户名包含 4 位数字" AutomationProperties.AutomationId="UsernameIncludeNumberToggle" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="邮箱地址" Description="请先确认邮箱服务支持加号地址。" HorizontalContentAlignment="Stretch"
                             Visibility="{x:Bind ViewModel.ShowUsernameEmail, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBox x:Name="UsernameEmailInput" HorizontalAlignment="Stretch" MinWidth="0" PlaceholderText="name@example.com"
                         Text="{x:Bind ViewModel.UsernameEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="加号邮箱地址" AutomationProperties.AutomationId="UsernameEmailTextBox" />
            </tk:SettingsCard>
            <tk:SettingsCard Header="域名" Description="需要已配置全域收件的邮箱域名。" HorizontalContentAlignment="Stretch"
                             Visibility="{x:Bind ViewModel.ShowUsernameDomain, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBox x:Name="UsernameDomainInput" HorizontalAlignment="Stretch" MinWidth="0" PlaceholderText="example.com"
                         Text="{x:Bind ViewModel.UsernameDomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="全域邮箱域名" AutomationProperties.AutomationId="UsernameDomainTextBox" />
            </tk:SettingsCard>
        </StackPanel>
        <tk:SettingsCard Header="生成器历史记录" Description="{x:Bind ViewModel.HistorySummary, Mode=OneWay}"
                         IsClickEnabled="True" Click="OnHistoryClick" AutomationProperties.AutomationId="GeneratorHistoryCard">
            <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE81C;" /></tk:SettingsCard.HeaderIcon>
            <tk:SettingsCard.ActionIcon><FontIcon Glyph="&#xE76C;" /></tk:SettingsCard.ActionIcon>
        </tk:SettingsCard>
        <TextBlock Text="仅保留最近 20 项成功复制的内容，保险库锁定后立即清除。" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
    </StackPanel>
</UserControl>
