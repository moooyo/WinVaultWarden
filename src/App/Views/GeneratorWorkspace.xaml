<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="App.Views.GeneratorWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:App.Converters"
    xmlns:local="using:App.Views" xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="OptionRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="56" /><Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="Padding" Value="0,8" />
        </Style>
        <Style x:Key="CharacterToggle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="56" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="12,0" />
            <Setter Property="FontFamily" Value="{StaticResource MonospaceFontFamily}" /><Setter Property="FontSize" Value="13" /><Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>
    <StackPanel x:Name="WorkspaceLayout" HorizontalAlignment="Stretch" SizeChanged="OnWorkspaceSizeChanged">
        <Grid Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw">
            <TextBlock x:Name="PrimaryBrushSource" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="TertiaryBrushSource" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="AccentBrushSource" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock x:Name="CautionBrushSource" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            <TextBlock x:Name="CriticalBrushSource" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            <TextBlock x:Name="SuccessBrushSource" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
            <TextBlock x:Name="DividerBrushSource" Foreground="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Grid>
        <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" FontFamily="{StaticResource WardenDisplayFontFamily}" FontSize="28" LineHeight="36" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind ViewModel.PageDescription, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
        <RadioButtons x:Uid="L28DFF2C09ED43922" x:Name="GeneratorModes" MaxColumns="3" Header="生成类型" Margin="0,16,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="GeneratorModeSelector" SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
            <RadioButton x:Uid="L0A45EB498BC2010C" Content="随机密码" IsEnabled="{x:Bind ViewModel.CanUsePasswordMode, Mode=OneWay}" /><RadioButton x:Uid="LE308275A491EA7B7" Content="密码短语" IsEnabled="{x:Bind ViewModel.CanUsePassphraseMode, Mode=OneWay}" /><RadioButton x:Uid="LE3D3441C6C9FBA17" Content="用户名" />
        </RadioButtons>
        <InfoBar Margin="0,16,0,0" AutomationProperties.AutomationId="GeneratorPolicyNotice" Visibility="{x:Bind ViewModel.HasGeneratorPolicyNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}" IsOpen="{x:Bind ViewModel.HasGeneratorPolicyNotice, Mode=OneWay}" IsClosable="False" Severity="Informational" Message="{x:Bind ViewModel.GeneratorPolicyNotice, Mode=OneWay}" />
        <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,28,0,0" Padding="0,28,0,14">
            <TextBlock x:Name="GeneratedValueText" AutomationProperties.AutomationId="GeneratedCredentialValue" FontFamily="{StaticResource MonospaceFontFamily}" FontSize="32" LineHeight="42" CharacterSpacing="20" TextWrapping="Wrap" MinHeight="42" IsTextSelectionEnabled="False" />
        </Border>
        <Grid x:Name="StrengthActions" Padding="0,0,0,32" ColumnSpacing="16" RowSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel x:Name="StrengthPanel" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.ShowStrength, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid x:Uid="L9961B5FD304424E2" Width="136" Height="4" ColumnSpacing="4" AutomationProperties.Name="生成结果强度"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Border x:Name="StrengthSegment1" CornerRadius="2" /><Border x:Name="StrengthSegment2" Grid.Column="1" CornerRadius="2" /><Border x:Name="StrengthSegment3" Grid.Column="2" CornerRadius="2" /><Border x:Name="StrengthSegment4" Grid.Column="3" CornerRadius="2" />
                </Grid>
                <TextBlock x:Name="StrengthText" Text="{x:Bind ViewModel.StrengthLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.EntropyLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="ActionButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Uid="L1AA618E626126E47" Click="OnRegenerateClick" IsEnabled="{x:Bind ViewModel.CanGenerate, Mode=OneWay}" Width="32" Height="32" Padding="0" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="重新生成" AutomationProperties.Name="重新生成" AutomationProperties.AutomationId="GeneratorRegenerateButton"><FontIcon Glyph="&#xE72C;" FontSize="16" /></Button>
                <Button x:Name="NewLoginButton" Click="OnNewLoginClick" IsEnabled="{x:Bind ViewModel.CanCopy, Mode=OneWay}" Height="32" Padding="12,0" AutomationProperties.AutomationId="GeneratorNewLoginButton"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="16" /><TextBlock x:Uid="L06EB3517C5E9A35B" Text="用于新登录" /></StackPanel></Button>
                <Button Command="{x:Bind ViewModel.CopyCommand}" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind ViewModel.CanCopy, Mode=OneWay}" Height="32" Padding="16,0" AutomationProperties.AutomationId="GeneratorCopyButton"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon x:Name="CopyIcon" Glyph="&#xE8C8;" FontSize="16" /><TextBlock Text="{x:Bind ViewModel.CopyLabel, Mode=OneWay}" /></StackPanel></Button>
            </StackPanel>
        </Grid>
        <InfoBar x:Name="CopyFeedbackBar" IsOpen="{x:Bind ViewModel.CopyFailed, Mode=OneWay}" Message="{x:Bind ViewModel.CopyFeedback, Mode=OneWay}" IsClosable="False" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="GeneratorCopyFeedback" />
        <StackPanel BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="{x:Bind ViewModel.IsPasswordMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid Style="{StaticResource OptionRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Uid="LC92C554238457657" Text="长度" VerticalAlignment="Center" />
                <Grid Grid.Column="1" ColumnSpacing="14" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                    <Slider x:Uid="L412E7772666CC1C0" x:Name="LengthSlider" Width="280" Height="32" Minimum="{x:Bind ViewModel.MinimumPasswordLength, Mode=OneWay}" Maximum="{x:Bind ViewModel.PasswordSliderMaximum, Mode=OneWay}" Value="{x:Bind ViewModel.LengthValue, Mode=TwoWay}" StepFrequency="1" AutomationProperties.Name="密码长度滑块" AutomationProperties.AutomationId="PasswordLengthSlider" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Length, Mode=OneWay}" FontFamily="{StaticResource MonospaceFontFamily}" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
            <Grid Style="{StaticResource OptionRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Uid="L3AD8890F835A68C5" Text="字符" /><TextBlock x:Uid="L7090FF5AFF06E98E" Text="至少保留一类" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ToggleButton x:Uid="L419D2BFE7BFF473C" Content="A–Z" IsChecked="{x:Bind ViewModel.IncludeUppercase, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanToggleUppercase, Mode=OneWay}" Style="{StaticResource CharacterToggle}" AutomationProperties.Name="包含大写字母" AutomationProperties.AutomationId="IncludeUppercaseCheckBox" />
                    <ToggleButton x:Uid="L40C47B7726B0C83B" Content="a–z" IsChecked="{x:Bind ViewModel.IncludeLowercase, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanToggleLowercase, Mode=OneWay}" Style="{StaticResource CharacterToggle}" AutomationProperties.Name="包含小写字母" AutomationProperties.AutomationId="IncludeLowercaseCheckBox" />
                    <ToggleButton x:Uid="LFB4210A313550BDE" Content="0–9" IsChecked="{x:Bind ViewModel.IncludeNumbers, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanToggleNumbers, Mode=OneWay}" Style="{StaticResource CharacterToggle}" AutomationProperties.Name="包含数字" AutomationProperties.AutomationId="IncludeNumbersCheckBox" />
                    <ToggleButton x:Uid="L995FECAB6D061B56" Content="!@#$" IsChecked="{x:Bind ViewModel.IncludeSpecial, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanToggleSpecial, Mode=OneWay}" Style="{StaticResource CharacterToggle}" AutomationProperties.Name="包含特殊字符" AutomationProperties.AutomationId="IncludeSpecialCheckBox" />
                </StackPanel>
            </Grid>
            <Grid Style="{StaticResource OptionRow}" Tapped="OnAvoidAmbiguousRowTapped"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Uid="LD6152242B259CA4F" Text="避免易混淆字符" /><TextBlock x:Uid="L433EA2B51737849A" Text="不使用 0 O 1 l I" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><TextBlock Text="{x:Bind local:GeneratorWorkspace.StateLabel(ViewModel.AvoidAmbiguous), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" /><ToggleSwitch x:Uid="L256533D531A8FEB9" MinWidth="0" Width="40" IsOn="{x:Bind ViewModel.AvoidAmbiguous, Mode=TwoWay}" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="避免易混淆字符" /></StackPanel>
            </Grid>
        </StackPanel>
        <StackPanel BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="{x:Bind ViewModel.IsPassphraseMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid Style="{StaticResource OptionRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Uid="L4C05CF29127B2DA0" Text="单词数" VerticalAlignment="Center" />
                <Grid Grid.Column="1" ColumnSpacing="14" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                    <Slider x:Uid="LC5B90BFB8566360C" x:Name="WordsSlider" Width="280" Height="32" Minimum="{x:Bind ViewModel.MinimumPassphraseWordCount, Mode=OneWay}" Maximum="{x:Bind ViewModel.PassphraseSliderMaximum, Mode=OneWay}" Value="{x:Bind ViewModel.PassphraseWordCountValue, Mode=TwoWay}" StepFrequency="1" AutomationProperties.Name="单词数" AutomationProperties.AutomationId="PassphraseWordCountNumberBox" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PassphraseWordCount, Mode=OneWay}" FontFamily="{StaticResource MonospaceFontFamily}" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
            <Grid Style="{StaticResource OptionRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Uid="L26A5FE61FC10C5E6" Text="分隔符" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ToggleButton x:Uid="L0B04C3512788C4CA" x:Name="SeparatorDash" Content="-" Tag="-" MinWidth="40" Height="32" Padding="10,0" Click="OnSeparatorClick" AutomationProperties.Name="连字符分隔符" /><ToggleButton x:Uid="LA3F66B083E561EE4" x:Name="SeparatorDot" Content="." Tag="." MinWidth="40" Height="32" Padding="10,0" Click="OnSeparatorClick" AutomationProperties.Name="句点分隔符" /><ToggleButton x:Uid="LA050B2791579EB84" x:Name="SeparatorUnderscore" Content="_" Tag="_" MinWidth="40" Height="32" Padding="10,0" Click="OnSeparatorClick" AutomationProperties.Name="下划线分隔符" /><ToggleButton x:Uid="L32B6E9A5AAB0E431" x:Name="SeparatorSpace" Content="空格" Tag=" " MinWidth="40" Height="32" Padding="10,0" Click="OnSeparatorClick" AutomationProperties.Name="空格分隔符" />
                </StackPanel>
            </Grid>
            <Grid Style="{StaticResource OptionRow}" Tapped="OnCapitalizeRowTapped"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Uid="LC664CBDC00A27E0E" Text="首字母大写" /><TextBlock x:Uid="L7C8333E44E38F7AE" Text="Otter-Copper" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><TextBlock Text="{x:Bind local:GeneratorWorkspace.StateLabel(ViewModel.PassphraseCapitalize), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" /><ToggleSwitch x:Uid="LA39383C6B87F0932" MinWidth="0" Width="40" IsOn="{x:Bind ViewModel.PassphraseCapitalize, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanTogglePassphraseCapitalize, Mode=OneWay}" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="密码短语首字母大写" AutomationProperties.AutomationId="PassphraseCapitalizeToggle" /></StackPanel></Grid>
            <Grid Style="{StaticResource OptionRow}" Tapped="OnIncludeNumberRowTapped"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock x:Uid="LDED6F250F52DC209" Text="包含数字" /><TextBlock x:Uid="L4B8ACE8AD020A849" Text="在随机一个单词后加一位数字" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><TextBlock Text="{x:Bind local:GeneratorWorkspace.StateLabel(ViewModel.PassphraseIncludeNumber), Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" /><ToggleSwitch x:Uid="L5C1E5FDF78C8E27D" MinWidth="0" Width="40" IsOn="{x:Bind ViewModel.PassphraseIncludeNumber, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanTogglePassphraseIncludeNumber, Mode=OneWay}" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="密码短语包含数字" AutomationProperties.AutomationId="PassphraseIncludeNumberToggle" /></StackPanel></Grid>
        </StackPanel>
        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsUsernameMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <tk:SettingsCard x:Uid="L9D1BD8B47F92B2D4" Header="类型"><ComboBox x:Uid="L2EDB99507E86F5D9" SelectedIndex="{x:Bind ViewModel.UsernameTypeIndex, Mode=TwoWay}" MinWidth="180" AutomationProperties.Name="用户名类型" AutomationProperties.AutomationId="UsernameTypeComboBox"><ComboBoxItem x:Uid="L1250999506F033BD" Content="随机单词" /><ComboBoxItem x:Uid="LAF4E4435A0F3E591" Content="加号邮箱" /><ComboBoxItem x:Uid="L777F6B2E7A4C6443" Content="全域邮箱" /></ComboBox></tk:SettingsCard>
            <tk:SettingsCard x:Uid="LBE9C964F9AF947F3" Header="首字母大写" Visibility="{x:Bind ViewModel.ShowUsernameWordOptions, Mode=OneWay, Converter={StaticResource BoolToVis}}"><ToggleSwitch x:Uid="LF7F81AF2F0625B3B" IsOn="{x:Bind ViewModel.UsernameCapitalize, Mode=TwoWay}" AutomationProperties.Name="用户名首字母大写" AutomationProperties.AutomationId="UsernameCapitalizeToggle" /></tk:SettingsCard>
            <tk:SettingsCard x:Uid="L8AE57086A259AC09" Header="包含 4 位数字" Visibility="{x:Bind ViewModel.ShowUsernameWordOptions, Mode=OneWay, Converter={StaticResource BoolToVis}}"><ToggleSwitch x:Uid="LF704BFB50048B265" IsOn="{x:Bind ViewModel.UsernameIncludeNumber, Mode=TwoWay}" AutomationProperties.Name="用户名包含 4 位数字" AutomationProperties.AutomationId="UsernameIncludeNumberToggle" /></tk:SettingsCard>
            <tk:SettingsCard x:Uid="L32359C242BDCFFA6" Header="邮箱地址" Visibility="{x:Bind ViewModel.ShowUsernameEmail, Mode=OneWay, Converter={StaticResource BoolToVis}}"><TextBox x:Uid="LE85A6C83CF11134A" Width="240" Text="{x:Bind ViewModel.UsernameEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="name@example.com" AutomationProperties.Name="加号邮箱地址" AutomationProperties.AutomationId="UsernameEmailTextBox" /></tk:SettingsCard>
            <tk:SettingsCard x:Uid="LFFB91B69A2E2485C" Header="域名" Visibility="{x:Bind ViewModel.ShowUsernameDomain, Mode=OneWay, Converter={StaticResource BoolToVis}}"><TextBox x:Uid="L4B4772A5648BD57F" Width="240" Text="{x:Bind ViewModel.UsernameDomain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="example.com" AutomationProperties.Name="全域邮箱域名" AutomationProperties.AutomationId="UsernameDomainTextBox" /></tk:SettingsCard>
        </StackPanel>
        <Expander x:Uid="LE028FD7480DBCEF4" Header="高级选项" Margin="0,20,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind ViewModel.IsPasswordMode, Mode=OneWay, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="GeneratorAdvancedOptions">
            <StackPanel Spacing="8">
                <tk:SettingsCard x:Uid="L8F520992674CBC37" Header="长度（扩展范围）"><NumberBox x:Uid="LDD3500EFA7613E08" Width="100" Minimum="{x:Bind ViewModel.MinimumPasswordLength, Mode=OneWay}" Maximum="128" Value="{x:Bind ViewModel.LengthValue, Mode=TwoWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="密码长度数值" AutomationProperties.AutomationId="PasswordLengthNumberBox" /></tk:SettingsCard>
                <tk:SettingsCard x:Uid="L60A06860E25150E9" Header="最少数字个数"><NumberBox x:Uid="LD2463B922456F5F3" Width="100" Minimum="{x:Bind ViewModel.PolicyMinimumNumbers, Mode=OneWay}" Maximum="128" Value="{x:Bind ViewModel.MinNumbersValue, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IncludeNumbers, Mode=OneWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="最少数字个数" AutomationProperties.AutomationId="MinNumbersNumberBox" /></tk:SettingsCard>
                <tk:SettingsCard x:Uid="LBD255611804CD43E" Header="最少特殊字符个数"><NumberBox x:Uid="LED7F0C51BBC52F97" Width="100" Minimum="{x:Bind ViewModel.PolicyMinimumSpecial, Mode=OneWay}" Maximum="128" Value="{x:Bind ViewModel.MinSpecialValue, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IncludeSpecial, Mode=OneWay}" SpinButtonPlacementMode="Compact" AutomationProperties.Name="最少特殊字符个数" AutomationProperties.AutomationId="MinSpecialNumberBox" /></tk:SettingsCard>
            </StackPanel>
        </Expander>
        <Button x:Uid="LDDBB5C564901759F" x:Name="HistoryButton" Content="最近复制" Click="OnHistoryClick" HorizontalAlignment="Left" Margin="0,16,0,0" Style="{StaticResource SubtleButtonStyle}" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
