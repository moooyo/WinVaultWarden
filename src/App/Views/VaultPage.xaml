                                                     HorizontalAlignment="Stretch"
                                                     Password="{x:Bind ViewModel.EditorDisplayDraft.Identity.Ssn, Mode=TwoWay}" />
                                        <PasswordBox Header="护照号"
                                                 HorizontalAlignment="Stretch"
                                                 Password="{x:Bind ViewModel.EditorDisplayDraft.Identity.PassportNumber, Mode=TwoWay}" />
