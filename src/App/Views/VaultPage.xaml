                    <controls:DetailCard >
                        <controls:DetailCard.CardContent>
                            <StackPanel Spacing="0">

                                <Grid MinHeight="52" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions><TextBlock Text="保存到" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><ComboBox x:Name="CipherEditorDestinationBox"

                                          Grid.Column="1" HorizontalAlignment="Left" Width="240" VerticalAlignment="Center"
                                          ItemsSource="{x:Bind ViewModel.EditorDestinations, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.EditorSelectedDestination, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.CanChooseEditorDestination, Mode=OneWay}"
                                          PlaceholderText="没有可写入的位置" AutomationProperties.Name="保存到密码库" >
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:CipherDestinationOption">
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox></Grid>
                                <StackPanel Spacing="6"
                                            Visibility="{x:Bind ViewModel.ShowEditorCollectionOptions, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="集合" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.EditorCollectionOptions, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:CipherCollectionOption">
                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanSelect}" AutomationProperties.Name="{Binding Name}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <Grid MinHeight="52" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions><TextBlock Text="文件夹" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Button x:Name="CipherEditorFolderBox" Grid.Column="1" HorizontalAlignment="Left" Width="240" Height="32" MinHeight="32" VerticalAlignment="Center" Padding="12,0,10,0" AutomationProperties.Name="文件夹">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.EditorFolderLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                    <Button.Flyout><MenuFlyout x:Name="EditorFolderFlyout" Opening="OnEditorFolderFlyoutOpening" Placement="BottomEdgeAlignedLeft" /></Button.Flyout>
                                </Button></Grid>
                                <CheckBox IsChecked="{x:Bind ViewModel.EditorDisplayDraft.Favorite, Mode=TwoWay}" AutomationProperties.Name="收藏条目" >
                                    <TextBlock Text="收藏" />
                                </CheckBox>
                            </StackPanel>
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>

                    <controls:DetailCard>
                        <controls:DetailCard.CardContent>
