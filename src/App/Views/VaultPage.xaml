<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.VaultPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App.Views"
    xmlns:controls="using:App.Controls"
    xmlns:conv="using:App.Converters"
    xmlns:models="using:App.ViewModels.Models">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsed" />
        <DataTemplate x:Key="LoginTemplate" x:DataType="models:LoginDetail">
            <StackPanel Spacing="24">
                <controls:DetailCard>
                    <controls:DetailCard.CardContent>
                        <ItemsControl ItemsSource="{Binding UriRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:LoginUriDetail">
                                    <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="{Binding Label}" Value="{Binding Value}" ShowOpen="True" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:DetailCard.CardContent>
                </controls:DetailCard>
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                        Visibility="{Binding HasSecondaryDetails, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="0">
                    <ItemsControl ItemsSource="{Binding Passkeys}" Visibility="{Binding HasPasskeys, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PasskeyDetail">
                                <Grid MinHeight="56" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="LB20604719825A1C3" Text="通行密钥" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplaySummary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MetadataSummary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid MinHeight="56" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                          Visibility="{Binding HasPasswordHistory, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                        <TextBlock x:Uid="L46A8A8E09D1E2359" Text="密码历史" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PasswordHistorySummary}" />
                            <TextBlock Text="{Binding LatestPasswordHistoryText}" FontSize="12" LineHeight="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Uid="LE4D99D7DB9C518B6" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" MinWidth="32" MinHeight="32"
                                Click="OnPasswordHistoryClick" AutomationProperties.Name="查看密码历史" ToolTipService.ToolTip="查看密码历史"
                                Visibility="{Binding IsDeleted, Converter={StaticResource InverseBoolToVis}}">
                            <FontIcon Glyph="&#xE81C;" FontSize="16" />
                        </Button>
                    </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="CardTemplate" x:DataType="models:CardDetail">
            <controls:DetailCard>
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow x:Uid="L463CA99DDC4462D6" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="持卡人" Value="{Binding Cardholder}" />
                        <controls:FieldRow x:Uid="LC3AEDA156294D671" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="品牌" Value="{Binding Brand}" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="IdentityTemplate" x:DataType="models:IdentityDetail">
            <controls:DetailCard>
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow x:Uid="L57A5BA299597C9CB" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="用户名" Value="{Binding Username}" />
                        <controls:FieldRow x:Uid="LB8CF0F74F857BFD7" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="公司" Value="{Binding Company}" />
                        <controls:FieldRow x:Uid="L7983C255591D43FB" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="证件号" Value="{Binding IdNumber}" IsSecret="True" />
                        <controls:FieldRow x:Uid="L8FC8569A104E2834" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="护照号码" Value="{Binding PassportNumber}" IsSecret="True" />
                        <controls:FieldRow x:Uid="L02E7EE937E8BA649" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="驾驶证号" Value="{Binding LicenseNumber}" IsSecret="True" />
                        <controls:FieldRow x:Uid="L1E01CBC4025CEA94" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="地址" IsMultiline="True" Value="{Binding Address}" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="NoteTemplate" x:DataType="models:NoteDetail">
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1" Padding="0,18,0,20">
                <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Value="{Binding Content}" IsMultiline="True" CopyButtonText="复制全部内容" ShowCopyButtonText="False" FontSize="15" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SshTemplate" x:DataType="models:SshDetail">
            <Grid />
        </DataTemplate>
        <DataTemplate x:Key="BankAccountTemplate" x:DataType="models:BankAccountDetail">
            <controls:DetailCard x:Uid="L4F6C4329AF883210" Title="银行账户">
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow x:Uid="L9A9134EF8823762C" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="银行" Value="{Binding BankName}" />
                        <controls:FieldRow x:Uid="L33C6184BE8E1AAB8" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="账户持有人" Value="{Binding NameOnAccount}" />
                        <controls:FieldRow x:Uid="LB6B5451D5CA4575C" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="账户类型" Value="{Binding AccountType}" />
                        <controls:FieldRow x:Uid="L8A9EC1E4A8DF8064" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="账号" Value="{Binding AccountNumber}" IsSecret="True" />
                        <controls:FieldRow x:Uid="L4C551080A737EAA6" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="路由号码" Value="{Binding RoutingNumber}" IsSecret="True" />
                        <controls:FieldRow x:Uid="L584824D48279CAB5" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="分行号码" Value="{Binding BranchNumber}" IsSecret="True" />
                        <controls:FieldRow x:Uid="L4CCB3C3AB8F556AB" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="PIN" Value="{Binding Pin}" IsSecret="True" />
                        <controls:FieldRow x:Uid="LF50D7198EB3C0895" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="SWIFT / BIC" Value="{Binding SwiftCode}" IsSecret="True" />
                        <controls:FieldRow x:Uid="LABFF01A5C73553CD" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="IBAN" Value="{Binding Iban}" IsSecret="True" />
                        <controls:FieldRow x:Uid="L6B8918552D7E475B" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="银行联系电话" Value="{Binding BankContactPhone}" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="DriversLicenseTemplate" x:DataType="models:DriversLicenseDetail">
            <controls:DetailCard x:Uid="L23395E44AEB15B9A" Title="驾驶证">
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow x:Uid="LD3F9C5CE275DB6C0" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="姓名" Value="{Binding FullName}" />
                        <controls:FieldRow x:Uid="L9AB8CF1CEE0F6E75" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="出生日期" Value="{Binding DateOfBirth}" IsSecret="True" />
                        <controls:FieldRow x:Uid="L02E7EE937E8BA649" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="驾驶证号" Value="{Binding LicenseNumber}" IsSecret="True" />
                        <controls:FieldRow x:Uid="LA631CC4D062D1425" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="签发国家/地区" Value="{Binding IssuingCountry}" />
                        <controls:FieldRow x:Uid="LE3D74201E592C63A" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="签发州/省" Value="{Binding IssuingState}" />
                        <controls:FieldRow x:Uid="LE34085A33AC2C50E" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="签发日期" Value="{Binding IssueDate}" IsSecret="True" />
                        <controls:FieldRow x:Uid="L605B03EE57575FA4" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="到期日期" Value="{Binding ExpirationDate}" IsSecret="True" />
                        <controls:FieldRow x:Uid="L070ED5393A45F98B" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="签发机关" Value="{Binding IssuingAuthority}" />
                        <controls:FieldRow x:Uid="LD6E1D34ABFF5C7C5" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="驾驶证类别" Value="{Binding LicenseClass}" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="PassportTemplate" x:DataType="models:PassportDetail">
            <controls:DetailCard x:Uid="L7C5BE259AC6767A1" Title="护照">
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow x:Uid="LD3F9C5CE275DB6C0" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="姓名" Value="{Binding FullName}" />
                        <controls:FieldRow x:Uid="L9AB8CF1CEE0F6E75" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="出生日期" Value="{Binding DateOfBirth}" IsSecret="True" />
                        <controls:FieldRow x:Uid="L480E4351F8970779" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="性别" Value="{Binding Sex}" IsSecret="True" />
                        <controls:FieldRow x:Uid="LE34025EB19496E79" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="出生地" Value="{Binding BirthPlace}" IsSecret="True" />
                        <controls:FieldRow x:Uid="L70FBCCD0FEFCCB7B" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="国籍" Value="{Binding Nationality}" />
                        <controls:FieldRow x:Uid="LA631CC4D062D1425" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="签发国家/地区" Value="{Binding IssuingCountry}" />
                        <controls:FieldRow x:Uid="L8FC8569A104E2834" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="护照号码" Value="{Binding PassportNumber}" IsSecret="True" />
                        <controls:FieldRow x:Uid="L7A61375C848F7FBC" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="护照类型" Value="{Binding PassportType}" />
                        <controls:FieldRow x:Uid="L1118CDFB579FFBD0" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="身份证件号码" Value="{Binding NationalIdentificationNumber}" IsSecret="True" />
                        <controls:FieldRow x:Uid="L070ED5393A45F98B" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="签发机关" Value="{Binding IssuingAuthority}" />
                        <controls:FieldRow x:Uid="LE34085A33AC2C50E" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="签发日期" Value="{Binding IssueDate}" IsSecret="True" />
                        <controls:FieldRow x:Uid="L605B03EE57575FA4" FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="到期日期" Value="{Binding ExpirationDate}" IsSecret="True" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>

    </Page.Resources>

    <Grid x:Name="VaultLayoutRoot" SizeChanged="OnVaultLayoutSizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="VaultLayoutStates">
                <VisualState x:Name="Wide">
                    <VisualState.Setters>
                        <Setter Target="VaultListColumn.Width" Value="344" />
                        <Setter Target="VaultDetailColumn.Width" Value="*" />
                        <Setter Target="VaultListPane.Visibility" Value="Visible" />
                        <Setter Target="VaultDetailPane.Visibility" Value="Visible" />
                        <Setter Target="VaultNarrowBackButton.Visibility" Value="Collapsed" />
                        <Setter Target="PendingCipherCreateActions.Orientation" Value="Horizontal" />
                        <Setter Target="PendingCipherCreateCheckButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="PendingCipherCreateAbandonButton.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowList">
                    <VisualState.Setters>
                        <Setter Target="VaultListColumn.Width" Value="*" />
                        <Setter Target="VaultDetailColumn.Width" Value="0" />
                        <Setter Target="VaultListPane.Visibility" Value="Visible" />
                        <Setter Target="VaultDetailPane.Visibility" Value="Collapsed" />
                        <Setter Target="VaultNarrowBackButton.Visibility" Value="Collapsed" />
                        <Setter Target="PendingCipherCreateActions.Orientation" Value="Vertical" />
                        <Setter Target="PendingCipherCreateCheckButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PendingCipherCreateAbandonButton.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowDetail">
                    <VisualState.Setters>
                        <Setter Target="VaultListColumn.Width" Value="0" />
                        <Setter Target="VaultDetailColumn.Width" Value="*" />
                        <Setter Target="VaultListPane.Visibility" Value="Collapsed" />
                        <Setter Target="VaultDetailPane.Visibility" Value="Visible" />
                        <Setter Target="VaultNarrowBackButton.Visibility" Value="Visible" />
                        <Setter Target="PendingCipherCreateActions.Orientation" Value="Vertical" />
                        <Setter Target="PendingCipherCreateCheckButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PendingCipherCreateAbandonButton.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="VaultListColumn" Width="344" />
            <ColumnDefinition x:Name="VaultDetailColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="VaultGlobalStatusPanel" Grid.Row="0" Grid.ColumnSpan="2">
            <StackPanel x:Name="VaultBusyPanel"
                        Margin="12,8,12,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressRing x:Name="VaultBusyRing"
                              Width="20"
                              Height="20"
                              AutomationProperties.AutomationId="VaultBusyRing"
                              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.BusyMessage, Mode=OneWay}"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <Border x:Name="PendingCipherCreateRecoveryPanel"
                    Margin="12,8,12,0"
                    Padding="12"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.HasPendingCipherCreate, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.LiveSetting="Polite">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;"
                              FontSize="18"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}"
                              VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.PendingCipherCreateTitle, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="WrapWholeWords" />
                        <TextBlock Text="{x:Bind ViewModel.PendingCipherCreateMessage, Mode=OneWay}"
                                   TextWrapping="WrapWholeWords" />
                        <TextBlock x:Uid="LD5E958CE3B374546" Text="再次同步检查只读取服务器状态，不会重新提交创建请求。"
                                   Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.PendingCipherCreateDraftMessage, Mode=OneWay}"
                                   Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                        <StackPanel x:Name="PendingCipherCreateActions"
                                    Margin="0,4,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button x:Uid="LE3A5FCDDA8C563D0" x:Name="PendingCipherCreateCheckButton"
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.SyncCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanCheckPendingCipherCreate, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    AutomationProperties.Name="再次同步检查待确认条目"
                                    AutomationProperties.AutomationId="PendingCipherCreateCheckButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    <TextBlock x:Uid="L47379C782759B469" Text="再次同步检查" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button x:Uid="LC7BB284841224EC2" x:Name="PendingCipherCreateAbandonButton"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{x:Bind ViewModel.CanAbandonPendingCipherCreate, Mode=OneWay}"
                                    Click="OnAbandonPendingCipherCreateClick"
                                    AutomationProperties.Name="放弃待确认状态"
                                    AutomationProperties.AutomationId="PendingCipherCreateAbandonButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"
                                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock x:Uid="L95C7E0C1511F7BB0" Text="放弃待确认状态…"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Grid x:Name="VaultListPane" Grid.Row="1" Grid.Column="0" Padding="0" RowSpacing="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderThickness="0,0,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Uid="L0E15A9B5BD8E1A57" x:Name="VaultSearchBox" PlaceholderText="搜索名称、网站或用户名"
                                GotFocus="OnSearchGotFocus"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                                QueryIcon="Find"
                                AutomationProperties.Name="搜索保险库"
                                AutomationProperties.AutomationId="VaultSearchBox">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAcceleratorInvoked" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
                <Button x:Uid="LA3F29B2C9E8D4520" Grid.Column="1" Command="{x:Bind ViewModel.SyncCommand}"
                        IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}"
                        AutomationProperties.Name="同步保险库"
                        AutomationProperties.AutomationId="VaultSyncButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                        <TextBlock x:Uid="L0894EFD6D21FF131" Text="同步" />
                    </StackPanel>
                </Button>
            </Grid>

            <CommandBar Grid.Row="0" Height="28" MinHeight="28" DefaultLabelPosition="Right" HorizontalAlignment="Stretch" Margin="20,16,12,4"
                        Background="Transparent">
                <CommandBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{x:Bind ViewModel.WorkspaceTitle, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.FilteredItems.Count, Mode=OneWay}" VerticalAlignment="Center"
                                   FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </CommandBar.Content>
                <AppBarButton x:Uid="LC5C4D55A8F26A8AA" x:Name="AddCipherButton" Icon="Add" Label="新建" Visibility="Collapsed"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanBeginCipherCreate, ViewModel.CanStartVaultOperation), Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem x:Uid="LEC9819CDEFE3DB76" Text="登录" Click="OnAddLoginClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="L4D9D83D9018CA0A0" Text="支付卡" Click="OnAddCardClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="L8917D8C2343DD205" Text="身份" Click="OnAddIdentityClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="LEE95A3954DF6D4F4" Text="笔记" Click="OnAddNoteClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="LB9CAF015D6B7F78D" Text="SSH 密钥" Click="OnAddSshClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="L79A9ED88E3E3753E" Text="银行账户"
                                            Click="OnAddBankAccountClick"
                                            Visibility="{x:Bind ViewModel.CanCreateNewCipherTypes, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE825;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="LAFAA9537B961AA2E" Text="驾驶证"
                                            Click="OnAddDriversLicenseClick"
                                            Visibility="{x:Bind ViewModel.CanCreateNewCipherTypes, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Uid="L037106415B40BF4A" Text="护照"
                                            Click="OnAddPassportClick"
                                            Visibility="{x:Bind ViewModel.CanCreateNewCipherTypes, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Uid="L82F38B6426D94EA7" x:Name="AddFolderMenuItem"
                                            Text="文件夹"
                                            Click="OnAddFolderClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
            <StackPanel Grid.Row="3" Spacing="6" Margin="0,0,0,12"
