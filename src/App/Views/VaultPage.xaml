                                        <TextBox Header="地址行 3" HorizontalAlignment="Stretch"
                                                 Text="{x:Bind ViewModel.EditorDisplayDraft.Identity.Address3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Header="城市" HorizontalAlignment="Stretch"
                                                 Text="{x:Bind ViewModel.EditorDisplayDraft.Identity.City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Header="州 / 省" HorizontalAlignment="Stretch"
                                                 Text="{x:Bind ViewModel.EditorDisplayDraft.Identity.State, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Header="邮政编码" HorizontalAlignment="Stretch"
                                                 Text="{x:Bind ViewModel.EditorDisplayDraft.Identity.PostalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Header="国家 / 地区" HorizontalAlignment="Stretch"
                                                 Text="{x:Bind ViewModel.EditorDisplayDraft.Identity.Country, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
