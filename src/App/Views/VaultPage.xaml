<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.VaultPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App.Views"
    xmlns:controls="using:App.Controls"
    xmlns:conv="using:App.Converters"
    xmlns:models="using:App.ViewModels.Models">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsed" />
        <DataTemplate x:Key="LoginTemplate" x:DataType="models:LoginDetail">
            <StackPanel Spacing="12">
                <controls:DetailCard Title="登录信息">
                    <controls:DetailCard.CardContent>
                        <StackPanel Spacing="2">
                            <controls:FieldRow Label="用户名" Value="{x:Bind Username}" />
                            <controls:FieldRow Label="密码" Value="{x:Bind Password}" IsSecret="True" />
                            <controls:TotpField Secret="{x:Bind TotpSecret}" />
                        </StackPanel>
                    </controls:DetailCard.CardContent>
                </controls:DetailCard>
                <controls:DetailCard Title="自动填充">
                    <controls:DetailCard.CardContent>
                        <controls:FieldRow Label="网址" Value="{x:Bind Uri}" ShowOpen="True" />
                    </controls:DetailCard.CardContent>
                </controls:DetailCard>
                <controls:DetailCard Title="Passkey"
                                     Visibility="{x:Bind HasPasskeys, Converter={StaticResource BoolToVis}}">
                    <controls:DetailCard.CardContent>
                        <ItemsControl ItemsSource="{x:Bind Passkeys}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PasskeyDetail">
                                    <StackPanel Spacing="2">
                                        <controls:FieldRow Label="RP ID" Value="{x:Bind RpId}" />
                                        <controls:FieldRow Label="账号" Value="{x:Bind DisplayName}" />
                                        <controls:FieldRow Label="可发现" Value="{x:Bind DiscoverableText}" />
                                        <controls:FieldRow Label="创建" Value="{x:Bind CreatedText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:DetailCard.CardContent>
                </controls:DetailCard>
                <Expander HorizontalAlignment="Stretch"
                          Visibility="{x:Bind HasPasswordHistory, Converter={StaticResource BoolToVis}}">
                    <Expander.Header>
                        <TextBlock>
                            <Run Text="密码历史 (" /><Run Text="{x:Bind PasswordHistoryCount}" /><Run Text=")" />
                        </TextBlock>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{x:Bind PasswordHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PasswordHistoryItem">
                                <!-- PasswordHistoryItem 无 Reprompt 字段(嵌套 DataTemplate 内 x:Bind/ElementName
                                     均无法跨模板边界读取外层 Page 属性),故经 DataContextChanged 由代码隐藏回填。 -->
                                <controls:FieldRow Label="{x:Bind DateLabel}" Value="{x:Bind Password}" IsSecret="True" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="CardTemplate" x:DataType="models:CardDetail">
            <controls:DetailCard Title="卡信息">
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow Label="持卡人" Value="{x:Bind Cardholder}" />
                        <controls:FieldRow Label="卡号" Value="{x:Bind Number}" IsSecret="True" />
                        <controls:FieldRow Label="有效期" Value="{x:Bind Expiry}" />
                        <controls:FieldRow Label="品牌" Value="{x:Bind Brand}" />
                        <controls:FieldRow Label="CVV" Value="{x:Bind Cvv}" IsSecret="True" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="IdentityTemplate" x:DataType="models:IdentityDetail">
            <controls:DetailCard Title="个人信息">
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow Label="姓名" Value="{x:Bind FullName}" />
                        <controls:FieldRow Label="用户名" Value="{x:Bind Username}" />
                        <controls:FieldRow Label="公司" Value="{x:Bind Company}" />
                        <controls:FieldRow Label="邮箱" Value="{x:Bind Email}" />
                        <controls:FieldRow Label="电话" Value="{x:Bind Phone}" />
                        <controls:FieldRow Label="证件号" Value="{x:Bind IdNumber}" IsSecret="True" />
                        <controls:FieldRow Label="地址" Value="{x:Bind Address}" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="NoteTemplate" x:DataType="models:NoteDetail">
            <controls:DetailCard Title="内容">
                <controls:DetailCard.CardContent>
                    <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" />
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="SshTemplate" x:DataType="models:SshDetail">
            <controls:DetailCard Title="密钥">
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow Label="公钥" Value="{x:Bind PublicKey}" />
                        <controls:FieldRow Label="私钥" Value="{x:Bind PrivateKey}" IsSecret="True" />
                        <controls:FieldRow Label="指纹" Value="{x:Bind Fingerprint}" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>

    </Page.Resources>

    <Grid x:Name="VaultLayoutRoot" SizeChanged="OnVaultLayoutSizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="VaultLayoutStates">
                <VisualState x:Name="Wide">
                    <VisualState.Setters>
                        <Setter Target="VaultListColumn.Width" Value="360" />
                        <Setter Target="VaultDetailColumn.Width" Value="*" />
                        <Setter Target="VaultListPane.Visibility" Value="Visible" />
                        <Setter Target="VaultDetailPane.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowList">
                    <VisualState.Setters>
                        <Setter Target="VaultListColumn.Width" Value="*" />
                        <Setter Target="VaultDetailColumn.Width" Value="0" />
                        <Setter Target="VaultListPane.Visibility" Value="Visible" />
                        <Setter Target="VaultDetailPane.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowDetail">
                    <VisualState.Setters>
                        <Setter Target="VaultListColumn.Width" Value="0" />
                        <Setter Target="VaultDetailColumn.Width" Value="*" />
                        <Setter Target="VaultListPane.Visibility" Value="Collapsed" />
                        <Setter Target="VaultDetailPane.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="VaultListColumn" Width="360" />
            <ColumnDefinition x:Name="VaultDetailColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="VaultBusyPanel"
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Margin="12,8,12,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <ProgressRing x:Name="VaultBusyRing"
                          Width="20"
                          Height="20"
                          AutomationProperties.AutomationId="VaultBusyRing"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.BusyMessage, Mode=OneWay}"
                       VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- 列表 -->
        <Grid x:Name="VaultListPane" Grid.Row="1" Grid.Column="0" Padding="12" RowSpacing="10"
              BorderThickness="0,0,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox PlaceholderText="搜索你的保险库…"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                                QueryIcon="Find"
                                AutomationProperties.Name="搜索保险库"
                                AutomationProperties.AutomationId="VaultSearchBox" />
                <Button Grid.Column="1" Command="{x:Bind ViewModel.SyncCommand}"
                        IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}"
                        AutomationProperties.Name="同步保险库"
                        AutomationProperties.AutomationId="VaultSyncButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                        <TextBlock Text="同步" />
                    </StackPanel>
                </Button>
            </Grid>

            <CommandBar Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Left"
                        Background="Transparent">
                <AppBarButton x:Name="AddCipherButton" Icon="Add" Label="新增"
                              IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="登录" Click="OnAddLoginClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="支付卡" Click="OnAddCardClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="身份" Click="OnAddIdentityClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="笔记" Click="OnAddNoteClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="SSH 密钥" Click="OnAddSshClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="AddFolderMenuItem"
                                            Text="文件夹"
                                            Click="OnAddFolderClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="EnterSelectionButton" Label="选择"
                              Command="{x:Bind ViewModel.ToggleSelectionModeCommand}"
                              Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE762;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Icon="SelectAll" Label="全选"
                              Command="{x:Bind ViewModel.SelectAllCommand}"
                              Click="OnSelectAllClick"
                              IsEnabled="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay}" />
                <AppBarButton x:Name="MoveSelectedButton" Icon="MoveToFolder" Label="移动"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.HasSelection, ViewModel.CanStartVaultOperation), Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="MoveFolderFlyout" Opening="OnMoveSelectedFlyoutOpening" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton Icon="Delete" Label="移到回收站"
                              Command="{x:Bind ViewModel.SoftDeleteSelectedCommand}"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.HasSelection, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsTrashFilterSelected, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                <AppBarButton Icon="Undo" Label="恢复"
                              Command="{x:Bind ViewModel.RestoreSelectedCommand}"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.HasSelection, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsTrashFilterSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <AppBarButton x:Name="PermanentDeleteButton" Icon="Delete" Label="永久删除"
                              Click="OnPermanentDeleteSelectedClick"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.HasSelection, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsTrashFilterSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </CommandBar>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,4,0,0"
                        Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center" Text="项已选" />
                <Button Content="完成" Command="{x:Bind ViewModel.ToggleSelectionModeCommand}" />
            </StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsFolderFilterSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Button x:Name="RenameFolderButton" Content="重命名文件夹" Click="OnRenameFolderClick"
                        IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}" />
                <Button x:Name="DeleteFolderButton" Content="删除文件夹" Click="OnDeleteFolderClick"
                        IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}" />
            </StackPanel>

            <!-- 筛选栏:分面 ToggleButton + 排序 + 保存视图 + 保存/清除 -->
            <StackPanel Grid.Row="2" Spacing="8" Margin="0,4,0,0">
                <InfoBar x:Name="VaultOfflineInfoBar"
                         Severity="Warning"
                         IsOpen="{x:Bind ViewModel.ShowDataStaleInfo, Mode=OneWay}"
                         IsClosable="False"
                         Title="离线"
                         Message="显示的是上次同步的数据,可能已过期。" />
                <InfoBar x:Name="VaultCommittedWarningInfoBar"
                         Severity="Warning"
                         IsOpen="{x:Bind ViewModel.HasOperationWarning, Mode=OneWay}"
                         IsClosable="False"
                         Title="已保存，需要同步"
                         Message="{x:Bind ViewModel.OperationWarning, Mode=OneWay}"
                         AutomationProperties.LiveSetting="Polite" />
                <InfoBar x:Name="VaultSkippedInfoBar"
                         Severity="Informational"
                         IsClosable="True"
                         IsOpen="{x:Bind ViewModel.HasSkippedCiphers, Mode=OneWay}"
                         Message="{x:Bind ViewModel.SkippedCipherMessage, Mode=OneWay}" />
                <!-- 紧凑单行:排序 + 筛选(分面下拉,含激活计数徽标) + 视图(已保存视图 + 保存当前视图) -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="SortComboBox"
                              MinWidth="130"
                              SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"
                              AutomationProperties.Name="排序方式"
                              AutomationProperties.AutomationId="VaultSortComboBox">
                        <ComboBoxItem Content="名称 A→Z" />
                        <ComboBoxItem Content="名称 Z→A" />
                        <ComboBoxItem Content="最近修改" />
                        <ComboBoxItem Content="创建时间" />
                    </ComboBox>

                    <DropDownButton x:Name="FacetFilterButton"
                                    AutomationProperties.Name="筛选"
                                    AutomationProperties.AutomationId="VaultFacetFilterButton">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71C;" FontSize="14" />
                            <TextBlock Text="筛选" />
                            <InfoBadge Value="{x:Bind ViewModel.ActiveFacetCount, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.HasActiveFacets, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout>
                                <StackPanel Spacing="6" MinWidth="200">
                                    <ToggleButton Content="含TOTP"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  IsChecked="{x:Bind ViewModel.FacetTotp, Mode=TwoWay}"
                                                  AutomationProperties.Name="按含 TOTP 筛选"
                                                  AutomationProperties.AutomationId="VaultFacetTotpToggle" />
                                    <ToggleButton Content="含附件"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  IsChecked="{x:Bind ViewModel.FacetAttachment, Mode=TwoWay}"
                                                  AutomationProperties.Name="按含附件筛选"
                                                  AutomationProperties.AutomationId="VaultFacetAttachmentToggle" />
                                    <ToggleButton Content="含网址"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  IsChecked="{x:Bind ViewModel.FacetUri, Mode=TwoWay}"
                                                  AutomationProperties.Name="按含网址筛选"
                                                  AutomationProperties.AutomationId="VaultFacetUriToggle" />
                                    <ToggleButton Content="仅收藏"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  IsChecked="{x:Bind ViewModel.FacetFavoriteOnly, Mode=TwoWay}"
                                                  AutomationProperties.Name="仅显示收藏"
                                                  AutomationProperties.AutomationId="VaultFacetFavoriteOnlyToggle" />
                                    <Border Height="1" Margin="0,2"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Button Content="清除全部筛选"
                                            HorizontalAlignment="Stretch"
                                            Click="OnClearFiltersClick"
                                            Visibility="{x:Bind ViewModel.HasActiveRefinement, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                            AutomationProperties.Name="清除筛选"
                                            AutomationProperties.AutomationId="VaultClearFiltersButton" />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <DropDownButton x:Name="SavedViewsButton"
                                    AutomationProperties.Name="视图"
                                    AutomationProperties.AutomationId="VaultSavedViewsButton">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                            <TextBlock Text="视图" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="SavedViewsFlyout" Opening="OnSavedViewsFlyoutOpening">
                                <MenuFlyoutSeparator x:Name="SavedViewsStaticSeparator" />
                                <MenuFlyoutItem x:Name="SaveCurrentViewMenuItem"
                                                Text="保存当前视图…"
                                                Click="OnSaveCurrentViewClick"
                                                AutomationProperties.Name="保存当前视图"
                                                AutomationProperties.AutomationId="VaultSaveCurrentViewButton">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>

                <InfoBar Severity="Informational" IsClosable="False" IsOpen="True"
                         Message="回收站中的项目不计入密码库，可恢复或永久删除。"
                         Visibility="{x:Bind ViewModel.IsTrashFilterSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <Grid Visibility="{x:Bind ViewModel.IsTrashFilterSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                      ColumnSpacing="8" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.TrashHeader, Mode=OneWay}" VerticalAlignment="Center"
                               Style="{StaticResource SectionHeaderTextBlockStyle}" />
                    <Button Grid.Column="1" Content="清空回收站" Click="OnEmptyRecycleBinClick"
                            IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CanEmptyRecycleBin, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="清空回收站"
                            AutomationProperties.AutomationId="VaultEmptyRecycleBinButton" />
                </Grid>
            </StackPanel>

            <ListView Grid.Row="5"
                      x:Name="CipherList"
                      ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                      SelectionChanged="OnCipherSelectionChanged"
                      SelectionMode="{x:Bind local:VaultPage.SelectionModeFromBool(ViewModel.IsSelectionMode), Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:CipherListItem">
                        <Grid x:Name="RowRoot"
                              ColumnSpacing="10"
                              Padding="4,6"
                              PointerEntered="OnRowPointerEntered"
                              PointerExited="OnRowPointerExited"
                              GotFocus="OnRowGotFocus"
                              LostFocus="OnRowLostFocus"
                              Unloaded="OnRowUnloaded">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32"
                                    Style="{StaticResource IconBadgeBorderStyle}">
                                <controls:FaviconView Domain="{x:Bind IconDomain}"
                                                      FallbackGlyph="{x:Bind Glyph}"
                                                      IconSize="16" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Subtitle}"
                                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2"
                                      Glyph="&#xE735;"
                                      FontSize="14"
                                      Margin="0,0,4,0"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                      Visibility="{x:Bind local:VaultPage.VisibleIfTrue(Favorite)}" />
                            <StackPanel x:Name="RowActions"
                                        Grid.Column="3"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        Opacity="0"
                                        IsHitTestVisible="False"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="复制"
                                        AutomationProperties.AutomationId="VaultRowCopyButton"
                                        ToolTipService.ToolTip="复制主值"
                                        Click="OnRowCopyPrimaryClick">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="更多"
                                        AutomationProperties.AutomationId="VaultRowMoreButton"
                                        ToolTipService.ToolTip="更多操作">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="编辑"
                                                            Click="OnRowEditClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfFalse(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="收藏 / 取消收藏"
                                                            Click="OnRowFavoriteClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfFalse(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE734;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="移到回收站"
                                                            Click="OnRowSoftDeleteClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfFalse(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="恢复"
                                                            Click="OnRowRestoreClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfTrue(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="永久删除"
                                                            Click="OnRowPermanentDeleteClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfTrue(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <InfoBar x:Name="VaultErrorInfoBar"
                     Grid.Row="5"
                     VerticalAlignment="Top"
                     IsClosable="True"
                     Severity="Error"
                     IsOpen="{x:Bind ViewModel.HasOperationError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.OperationError, Mode=OneWay}" />

            <StackPanel x:Name="VaultEmptyPanel"
                        Grid.Row="5"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="{StaticResource SpacingMedium}"
                        Visibility="{x:Bind ViewModel.HasNoItems, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <FontIcon Glyph="&#xE8A1;" FontSize="44"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="保险库为空"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="点击上方&#x201C;新增&#x201D;创建你的第一个条目。"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="VaultNoResultsPanel"
                        Grid.Row="5"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="{StaticResource SpacingMedium}"
                        Visibility="{x:Bind ViewModel.NoResults, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <FontIcon Glyph="&#xE721;" FontSize="44"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="没有匹配项"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="没有符合当前搜索或筛选的条目。"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="5" Text="回收站为空" Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                       Margin="0,8" HorizontalAlignment="Center"
                       Visibility="{x:Bind ViewModel.IsTrashEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- 详情 -->
        <Grid x:Name="VaultDetailPane" Grid.Row="1" Grid.Column="1">
        <ScrollViewer Padding="16">
            <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Stretch">
                <!-- 窄屏详情态返回列表入口:仅 NarrowDetail 可见,由 code-behind 切换。 -->
                <Button x:Name="VaultNarrowBackButton"
                        HorizontalAlignment="Left"
                        Click="OnVaultNarrowBackClick"
                        AutomationProperties.AutomationId="VaultNarrowBackButton"
                        AutomationProperties.Name="返回列表"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" /><TextBlock Text="返回列表" />
                    </StackPanel>
                </Button>
                <StackPanel x:Name="CipherEditorPanel"
                            x:Load="{x:Bind ViewModel.IsEditing, Mode=OneWay}"
                            Spacing="12"
                            Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <ComboBox x:Name="CipherEditorTypeBox"
                                      Header="类型"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnCipherEditorTypeChanged">
                                <ComboBoxItem Content="登录" Tag="Login" />
                                <ComboBoxItem Content="支付卡" Tag="Card" />
                                <ComboBoxItem Content="身份" Tag="Identity" />
                                <ComboBoxItem Content="笔记" Tag="Note" />
                                <ComboBoxItem Content="SSH 密钥" Tag="Ssh" />
                            </ComboBox>
                        </StackPanel>

                        <Button x:Name="CancelCipherEditorButton"
                                Grid.Column="1"
                                Content="取消"
                                VerticalAlignment="Bottom"
                                Click="OnCancelCipherEditorClick" />
                        <Button x:Name="SaveCipherEditorButton"
                                Grid.Column="2"
                                Content="保存"
                                VerticalAlignment="Bottom"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}"
                                Click="OnSaveCipherEditorClick" />
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.EditorError, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.EditorError, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}" />
                    <TextBlock Text="{x:Bind ViewModel.OperationError, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.OperationError, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}" />

                    <controls:DetailCard Title="项目详细信息">
                        <controls:DetailCard.CardContent>
                            <StackPanel Spacing="10">
                                <TextBox Header="项目名称（必填）"
                                         HorizontalAlignment="Stretch"
                                         Text="{x:Bind ViewModel.EditorDraft.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox x:Name="CipherEditorFolderBox"
                                          Header="文件夹"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.FolderFilters, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.EditorSelectedFolder, Mode=TwoWay}"
                                          PlaceholderText="-- 选择 --">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:FilterNode">
                                            <TextBlock Text="{x:Bind Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <CheckBox IsChecked="{x:Bind ViewModel.EditorDraft.Favorite, Mode=TwoWay}">
                                    <TextBlock Text="收藏" />
                                </CheckBox>
                            </StackPanel>
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>

                    <controls:DetailCard Title="登录凭据"
                                         Visibility="{x:Bind ViewModel.EditorDraft.IsLogin, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <controls:DetailCard.CardContent>
                            <StackPanel Spacing="10">
                                <TextBox Header="用户名"
                                         HorizontalAlignment="Stretch"
                                         Text="{x:Bind ViewModel.EditorDraft.Login.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <PasswordBox Header="密码"
                                             HorizontalAlignment="Stretch"
                                             Password="{x:Bind ViewModel.EditorDraft.Login.Password, Mode=TwoWay}" />
                                <PasswordBox x:Name="TotpSecretEditor"
                                             Header="验证器密钥"
                                             HorizontalAlignment="Stretch"
                                             Password="{x:Bind ViewModel.EditorDraft.Login.Totp, Mode=TwoWay}" />
                                <TextBox Header="网站（URI）"
                                         HorizontalAlignment="Stretch"
                                         Text="{x:Bind ViewModel.EditorDraft.Login.PrimaryUri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>

                    <controls:DetailCard Title="支付卡信息"
                                         Visibility="{x:Bind ViewModel.EditorDraft.IsCard, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <controls:DetailCard.CardContent>
                            <StackPanel Spacing="10">
                                <TextBox Header="持卡人"
                                         HorizontalAlignment="Stretch"
                                         Text="{x:Bind ViewModel.EditorDraft.Card.CardholderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <PasswordBox Header="卡号"
                                             HorizontalAlignment="Stretch"
                                             Password="{x:Bind ViewModel.EditorDraft.Card.Number, Mode=TwoWay}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Header="到期月份"
                                             HorizontalAlignment="Stretch"
                                             Text="{x:Bind ViewModel.EditorDraft.Card.ExpMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="1"
                                             Header="到期年份"
                                             HorizontalAlignment="Stretch"
                                             Text="{x:Bind ViewModel.EditorDraft.Card.ExpYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <PasswordBox Header="安全码"
                                             HorizontalAlignment="Stretch"
                                             Password="{x:Bind ViewModel.EditorDraft.Card.Code, Mode=TwoWay}" />
                                <Expander Header="更多支付卡字段">
                                    <TextBox Header="品牌"
                                             HorizontalAlignment="Stretch"
                                             Text="{x:Bind ViewModel.EditorDraft.Card.Brand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Expander>
                            </StackPanel>
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>

                    <controls:DetailCard Title="身份信息"
                                         Visibility="{x:Bind ViewModel.EditorDraft.IsIdentity, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <controls:DetailCard.CardContent>
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Header="名"
                                             HorizontalAlignment="Stretch"
                                             Text="{x:Bind ViewModel.EditorDraft.Identity.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="1"
                                             Header="姓"
                                             HorizontalAlignment="Stretch"
                                             Text="{x:Bind ViewModel.EditorDraft.Identity.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBox Header="电子邮箱"
                                         HorizontalAlignment="Stretch"
                                         Text="{x:Bind ViewModel.EditorDraft.Identity.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Header="电话"
                                         HorizontalAlignment="Stretch"
                                         Text="{x:Bind ViewModel.EditorDraft.Identity.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Header="地址"
                                         HorizontalAlignment="Stretch"
                                         Text="{x:Bind ViewModel.EditorDraft.Identity.Address1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Expander Header="更多身份字段">
                                    <StackPanel Spacing="10">
                                        <TextBox Header="用户名"
                                                 HorizontalAlignment="Stretch"
                                                 Text="{x:Bind ViewModel.EditorDraft.Identity.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Header="公司"
                                                 HorizontalAlignment="Stretch"
                                                 Text="{x:Bind ViewModel.EditorDraft.Identity.Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <PasswordBox Header="社会安全号 / 身份号"
                                                     HorizontalAlignment="Stretch"
                                                     Password="{x:Bind ViewModel.EditorDraft.Identity.Ssn, Mode=TwoWay}" />
                                        <TextBox Header="护照号"
                                                 HorizontalAlignment="Stretch"
                                                 Text="{x:Bind ViewModel.EditorDraft.Identity.PassportNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>

                    <controls:DetailCard Title="SSH 密钥"
                                         Visibility="{x:Bind ViewModel.EditorDraft.IsSshKey, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <controls:DetailCard.CardContent>
                            <StackPanel Spacing="10">
                                <TextBox Header="公钥"
                                         HorizontalAlignment="Stretch"
                                         Text="{x:Bind ViewModel.EditorDraft.SshKey.PublicKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         MinHeight="72"
                                         TextWrapping="Wrap" />
                                <PasswordBox Header="私钥"
                                             HorizontalAlignment="Stretch"
                                             Password="{x:Bind ViewModel.EditorDraft.SshKey.PrivateKey, Mode=TwoWay}" />
                                <TextBox Header="指纹"
                                         HorizontalAlignment="Stretch"
                                         Text="{x:Bind ViewModel.EditorDraft.SshKey.KeyFingerprint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>

                    <controls:DetailCard Title="安全笔记"
                                         Visibility="{x:Bind ViewModel.EditorDraft.IsSecureNote, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <controls:DetailCard.CardContent>
                            <TextBlock Text="安全笔记内容请填写在下方备注中。"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>

                    <controls:DetailCard Title="附加选项">
                        <controls:DetailCard.CardContent>
                            <StackPanel Spacing="10">
                                <TextBox Header="备注"
                                         HorizontalAlignment="Stretch"
                                         Text="{x:Bind ViewModel.EditorDraft.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         MinHeight="96"
                                         TextWrapping="Wrap" />
                                <CheckBox IsChecked="{x:Bind ViewModel.EditorDraft.Reprompt, Mode=TwoWay}">
                                    <TextBlock Text="主密码重新提示" />
                                </CheckBox>
                                <ItemsControl x:Name="CustomFieldsEditorItems"
                                              ItemsSource="{x:Bind ViewModel.EditorDraft.CustomFields, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CustomFieldEditorDraft">
                                            <Grid ColumnSpacing="8" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="8">
                                                    <TextBox Header="名称"
                                                             HorizontalAlignment="Stretch"
                                                             Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <ComboBox x:Name="CustomFieldTypeBox"
                                                              Header="类型"
                                                              HorizontalAlignment="Stretch"
                                                              SelectedIndex="{x:Bind TypeIndex, Mode=TwoWay}">
                                                        <ComboBoxItem Content="文本" Tag="Text" />
                                                        <ComboBoxItem Content="隐藏" Tag="Hidden" />
                                                        <ComboBoxItem Content="布尔值" Tag="Boolean" />
                                                    </ComboBox>
                                                    <TextBox x:Name="CustomFieldTextValueBox"
                                                             Header="值"
                                                             HorizontalAlignment="Stretch"
                                                             Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             x:Load="{x:Bind IsText, Mode=OneWay}" />
                                                    <PasswordBox x:Name="CustomFieldHiddenValueBox"
                                                                 Header="值"
                                                                 HorizontalAlignment="Stretch"
                                                                 Password="{x:Bind Value, Mode=TwoWay}"
                                                                 x:Load="{x:Bind IsHidden, Mode=OneWay}" />
                                                    <CheckBox x:Name="CustomFieldBooleanValueCheckBox"
                                                              Content="已启用"
                                                              IsChecked="{x:Bind BooleanValue, Mode=TwoWay}"
                                                              x:Load="{x:Bind IsBoolean, Mode=OneWay}" />
                                                </StackPanel>
                                                <Button x:Name="RemoveCustomFieldButton"
                                                        Grid.Column="1"
                                                        VerticalAlignment="Top"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        AutomationProperties.Name="删除字段"
                                                        ToolTipService.ToolTip="删除字段"
                                                        Click="OnRemoveCustomFieldClick">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="AddCustomFieldButton"
                                        Content="添加字段"
                                        HorizontalAlignment="Left"
                                        Command="{x:Bind ViewModel.AddCustomFieldCommand}" />
                            </StackPanel>
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>
                </StackPanel>

                <StackPanel Spacing="12"
                            Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Spacing="2"
                            Visibility="{x:Bind ViewModel.HasDetailSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:FaviconView Domain="{x:Bind ViewModel.DetailIconDomain, Mode=OneWay}"
                                              FallbackGlyph="{x:Bind ViewModel.SelectedItem.Glyph, Mode=OneWay}"
                                              IconSize="18"
                                              Width="24" Height="24"
                                              VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.Detail.Name, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <FontIcon Glyph="&#xE735;" FontSize="14"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                  Visibility="{x:Bind local:VaultPage.VisibleIfTrue(ViewModel.Detail.Favorite), Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Detail.FolderName, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <!-- 条目级重提示未解锁时:显示"验证后显示敏感字段"入口(经 Task 3 tracked 主密码对话框)。 -->
                    <Button x:Name="UnlockSensitiveFieldsButton"
                            Content="验证后显示敏感字段"
                            Margin="0,4,0,0"
                            Click="OnUnlockSensitiveFieldsClick"
                            AutomationProperties.AutomationId="VaultUnlockSensitiveFieldsButton"
                            Visibility="{x:Bind ViewModel.ShowSensitiveUnlock, Mode=OneWay,
                                Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <ContentControl x:Name="DetailHost"
                                HorizontalContentAlignment="Stretch" />

                <!-- 共用底部:备注/自定义字段/历史/操作 -->
                <StackPanel Spacing="12"
                            Visibility="{x:Bind ViewModel.HasDetailSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <!-- 备注 -->
                    <StackPanel Spacing="4"
                                Visibility="{x:Bind ViewModel.Detail.Notes, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock Text="备注" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Detail.Notes, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- 附件 -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.Detail.AttachmentHeader, Mode=OneWay}"
                                   Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <TextBlock Text="暂无附件"
                                   Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                                   Visibility="{x:Bind ViewModel.Detail.HasAttachments, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                        <ItemsControl x:Name="AttachmentsItems"
                                      ItemsSource="{x:Bind ViewModel.Detail.Attachments, Mode=OneWay}"
                                      IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.Detail.HasAttachments, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AttachmentItem">
                                    <Grid ColumnSpacing="8" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind FileName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind SizeName}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"
                                                   Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                        <Button Grid.Column="3"
                                                Style="{StaticResource IconButtonStyle}"
                                                AutomationProperties.Name="下载附件"
                                                ToolTipService.ToolTip="下载"
                                                Click="OnDownloadAttachmentClick">
                                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                                        </Button>
                                        <Button Grid.Column="4"
                                                Style="{StaticResource IconButtonStyle}"
                                                AutomationProperties.Name="删除附件"
                                                ToolTipService.ToolTip="删除"
                                                Click="OnDeleteAttachmentClick">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14"
                                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="AddAttachmentButton"
                                Content="添加附件"
                                HorizontalAlignment="Left"
                                IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}"
                                Click="OnAddAttachmentClick" />
                    </StackPanel>
                    <!-- 自定义字段 -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Detail.CustomFields, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:CustomField">
                                <!-- CustomField 无 Reprompt 字段,同 PasswordHistoryItem 理由经 DataContextChanged 回填。 -->
                                <controls:FieldRow Label="{x:Bind Label}" Value="{x:Bind Value}" IsSecret="{x:Bind IsSecret}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 历史 -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="项目历史" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <TextBlock Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                                   Text="{x:Bind ViewModel.Detail.HistoryText, Mode=OneWay}" />
                    </StackPanel>
                    <!-- 操作错误条 -->
                    <TextBlock Text="{x:Bind ViewModel.OperationError, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.OperationError, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}" />
                    <!-- 操作:常规(非回收站) -->
                    <Grid ColumnSpacing="8"
                          Visibility="{x:Bind ViewModel.IsSelectedItemDeleted, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="EditCipherButton" HorizontalAlignment="Stretch" Click="OnEditCipherClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" /><TextBlock Text="编辑" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteCipherButton" Grid.Column="1" HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}"
                                Click="OnDeleteCipherClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="删除" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- 操作:回收站 -->
                    <Grid ColumnSpacing="8"
                          Visibility="{x:Bind ViewModel.IsSelectedItemDeleted, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RestoreCipherButton" HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}"
                                Click="OnRestoreCipherClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7A7;" FontSize="14" /><TextBlock Text="恢复" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PermanentDeleteCipherButton" Grid.Column="1" HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}"
                                Click="OnPermanentDeleteCipherClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="永久删除" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

            <!-- 空状态浮层:在整个右栏内水平+垂直居中(不再随详情内容靠左偏上) -->
            <StackPanel x:Name="VaultNoSelectionPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="{StaticResource SpacingMedium}"
                        Visibility="{x:Bind ViewModel.ShowNoSelectionPlaceholder, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <FontIcon Glyph="&#xE8F1;" FontSize="44"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="未选择任何项目"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="从左侧列表选择一个条目以查看详情。"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
