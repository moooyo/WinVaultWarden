<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.VaultPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App.Views"
    xmlns:controls="using:App.Controls"
    xmlns:conv="using:App.Converters"
    xmlns:models="using:App.ViewModels.Models">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsed" />
        <DataTemplate x:Key="LoginTemplate" x:DataType="models:LoginDetail">
            <StackPanel Spacing="24">
                <controls:DetailCard>
                    <controls:DetailCard.CardContent>
                        <ItemsControl ItemsSource="{Binding UriRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:LoginUriDetail">
                                    <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="{Binding Label}" Value="{Binding Value}" ShowOpen="True" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:DetailCard.CardContent>
                </controls:DetailCard>
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                        Visibility="{Binding HasSecondaryDetails, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="0">
                    <ItemsControl ItemsSource="{Binding Passkeys}" Visibility="{Binding HasPasskeys, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PasskeyDetail">
                                <Grid MinHeight="56" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="通行密钥" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplaySummary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MetadataSummary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid MinHeight="56" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                          Visibility="{Binding HasPasswordHistory, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                        <TextBlock Text="密码历史" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PasswordHistorySummary}" />
                            <TextBlock Text="{Binding LatestPasswordHistoryText}" FontSize="12" LineHeight="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" MinWidth="32" MinHeight="32"
                                Click="OnPasswordHistoryClick" AutomationProperties.Name="查看密码历史" ToolTipService.ToolTip="查看密码历史"
                                Visibility="{Binding IsDeleted, Converter={StaticResource InverseBoolToVis}}">
                            <FontIcon Glyph="&#xE81C;" FontSize="16" />
                        </Button>
                    </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="CardTemplate" x:DataType="models:CardDetail">
            <controls:DetailCard>
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="持卡人" Value="{Binding Cardholder}" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="品牌" Value="{Binding Brand}" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="IdentityTemplate" x:DataType="models:IdentityDetail">
            <controls:DetailCard>
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="用户名" Value="{Binding Username}" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="公司" Value="{Binding Company}" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="证件号" Value="{Binding IdNumber}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="护照号码" Value="{Binding PassportNumber}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="驾驶证号" Value="{Binding LicenseNumber}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="地址" IsMultiline="True" Value="{Binding Address}" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="NoteTemplate" x:DataType="models:NoteDetail">
            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1" Padding="0,18,0,20">
                <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Value="{Binding Content}" IsMultiline="True" CopyButtonText="复制全部内容" ShowCopyButtonText="False" FontSize="15" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SshTemplate" x:DataType="models:SshDetail">
            <Grid />
        </DataTemplate>
        <DataTemplate x:Key="BankAccountTemplate" x:DataType="models:BankAccountDetail">
            <controls:DetailCard Title="银行账户">
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="银行" Value="{Binding BankName}" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="账户持有人" Value="{Binding NameOnAccount}" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="账户类型" Value="{Binding AccountType}" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="账号" Value="{Binding AccountNumber}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="路由号码" Value="{Binding RoutingNumber}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="分行号码" Value="{Binding BranchNumber}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="PIN" Value="{Binding Pin}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="SWIFT / BIC" Value="{Binding SwiftCode}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="IBAN" Value="{Binding Iban}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="银行联系电话" Value="{Binding BankContactPhone}" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="DriversLicenseTemplate" x:DataType="models:DriversLicenseDetail">
            <controls:DetailCard Title="驾驶证">
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="姓名" Value="{Binding FullName}" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="出生日期" Value="{Binding DateOfBirth}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="驾驶证号" Value="{Binding LicenseNumber}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="签发国家/地区" Value="{Binding IssuingCountry}" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="签发州/省" Value="{Binding IssuingState}" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="签发日期" Value="{Binding IssueDate}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="到期日期" Value="{Binding ExpirationDate}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="签发机关" Value="{Binding IssuingAuthority}" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="驾驶证类别" Value="{Binding LicenseClass}" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="PassportTemplate" x:DataType="models:PassportDetail">
            <controls:DetailCard Title="护照">
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="姓名" Value="{Binding FullName}" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="出生日期" Value="{Binding DateOfBirth}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="性别" Value="{Binding Sex}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="出生地" Value="{Binding BirthPlace}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="国籍" Value="{Binding Nationality}" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="签发国家/地区" Value="{Binding IssuingCountry}" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="护照号码" Value="{Binding PassportNumber}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="护照类型" Value="{Binding PassportType}" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="身份证件号码" Value="{Binding NationalIdentificationNumber}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="签发机关" Value="{Binding IssuingAuthority}" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="签发日期" Value="{Binding IssueDate}" IsSecret="True" />
                        <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="到期日期" Value="{Binding ExpirationDate}" IsSecret="True" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>

    </Page.Resources>

    <Grid x:Name="VaultLayoutRoot" SizeChanged="OnVaultLayoutSizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="VaultLayoutStates">
                <VisualState x:Name="Wide">
                    <VisualState.Setters>
                        <Setter Target="VaultListColumn.Width" Value="344" />
                        <Setter Target="VaultDetailColumn.Width" Value="*" />
                        <Setter Target="VaultListPane.Visibility" Value="Visible" />
                        <Setter Target="VaultDetailPane.Visibility" Value="Visible" />
                        <Setter Target="VaultNarrowBackButton.Visibility" Value="Collapsed" />
                        <Setter Target="PendingCipherCreateActions.Orientation" Value="Horizontal" />
                        <Setter Target="PendingCipherCreateCheckButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="PendingCipherCreateAbandonButton.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowList">
                    <VisualState.Setters>
                        <Setter Target="VaultListColumn.Width" Value="*" />
                        <Setter Target="VaultDetailColumn.Width" Value="0" />
                        <Setter Target="VaultListPane.Visibility" Value="Visible" />
                        <Setter Target="VaultDetailPane.Visibility" Value="Collapsed" />
                        <Setter Target="VaultNarrowBackButton.Visibility" Value="Collapsed" />
                        <Setter Target="PendingCipherCreateActions.Orientation" Value="Vertical" />
                        <Setter Target="PendingCipherCreateCheckButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PendingCipherCreateAbandonButton.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowDetail">
                    <VisualState.Setters>
                        <Setter Target="VaultListColumn.Width" Value="0" />
                        <Setter Target="VaultDetailColumn.Width" Value="*" />
                        <Setter Target="VaultListPane.Visibility" Value="Collapsed" />
                        <Setter Target="VaultDetailPane.Visibility" Value="Visible" />
                        <Setter Target="VaultNarrowBackButton.Visibility" Value="Visible" />
                        <Setter Target="PendingCipherCreateActions.Orientation" Value="Vertical" />
                        <Setter Target="PendingCipherCreateCheckButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PendingCipherCreateAbandonButton.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="VaultListColumn" Width="344" />
            <ColumnDefinition x:Name="VaultDetailColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="VaultGlobalStatusPanel" Grid.Row="0" Grid.ColumnSpan="2">
            <StackPanel x:Name="VaultBusyPanel"
                        Margin="12,8,12,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressRing x:Name="VaultBusyRing"
                              Width="20"
                              Height="20"
                              AutomationProperties.AutomationId="VaultBusyRing"
                              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.BusyMessage, Mode=OneWay}"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <Border x:Name="PendingCipherCreateRecoveryPanel"
                    Margin="12,8,12,0"
                    Padding="12"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.HasPendingCipherCreate, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.LiveSetting="Polite">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;"
                              FontSize="18"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}"
                              VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.PendingCipherCreateTitle, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="WrapWholeWords" />
                        <TextBlock Text="{x:Bind ViewModel.PendingCipherCreateMessage, Mode=OneWay}"
                                   TextWrapping="WrapWholeWords" />
                        <TextBlock Text="再次同步检查只读取服务器状态，不会重新提交创建请求。"
                                   Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.PendingCipherCreateDraftMessage, Mode=OneWay}"
                                   Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                        <StackPanel x:Name="PendingCipherCreateActions"
                                    Margin="0,4,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button x:Name="PendingCipherCreateCheckButton"
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.SyncCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanCheckPendingCipherCreate, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    AutomationProperties.Name="再次同步检查待确认条目"
                                    AutomationProperties.AutomationId="PendingCipherCreateCheckButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    <TextBlock Text="再次同步检查" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PendingCipherCreateAbandonButton"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{x:Bind ViewModel.CanAbandonPendingCipherCreate, Mode=OneWay}"
                                    Click="OnAbandonPendingCipherCreateClick"
                                    AutomationProperties.Name="放弃待确认状态"
                                    AutomationProperties.AutomationId="PendingCipherCreateAbandonButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"
                                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="放弃待确认状态…"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Grid x:Name="VaultListPane" Grid.Row="1" Grid.Column="0" Padding="0" RowSpacing="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderThickness="0,0,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="VaultSearchBox" PlaceholderText="搜索名称、网站或用户名"
                                GotFocus="OnSearchGotFocus"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                                QueryIcon="Find"
                                AutomationProperties.Name="搜索保险库"
                                AutomationProperties.AutomationId="VaultSearchBox">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAcceleratorInvoked" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
                <Button Grid.Column="1" Command="{x:Bind ViewModel.SyncCommand}"
                        IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}"
                        AutomationProperties.Name="同步保险库"
                        AutomationProperties.AutomationId="VaultSyncButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                        <TextBlock Text="同步" />
                    </StackPanel>
                </Button>
            </Grid>

            <CommandBar Grid.Row="0" Height="28" MinHeight="28" DefaultLabelPosition="Right" HorizontalAlignment="Stretch" Margin="20,16,12,4"
                        Background="Transparent">
                <CommandBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{x:Bind ViewModel.WorkspaceTitle, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.FilteredItems.Count, Mode=OneWay}" VerticalAlignment="Center"
                                   FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </CommandBar.Content>
                <AppBarButton x:Name="AddCipherButton" Icon="Add" Label="新建" Visibility="Collapsed"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanBeginCipherCreate, ViewModel.CanStartVaultOperation), Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="登录" Click="OnAddLoginClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="支付卡" Click="OnAddCardClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="身份" Click="OnAddIdentityClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="笔记" Click="OnAddNoteClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="SSH 密钥" Click="OnAddSshClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="银行账户"
                                            Click="OnAddBankAccountClick"
                                            Visibility="{x:Bind ViewModel.CanCreateNewCipherTypes, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE825;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="驾驶证"
                                            Click="OnAddDriversLicenseClick"
                                            Visibility="{x:Bind ViewModel.CanCreateNewCipherTypes, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="护照"
                                            Click="OnAddPassportClick"
                                            Visibility="{x:Bind ViewModel.CanCreateNewCipherTypes, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="AddFolderMenuItem"
                                            Text="文件夹"
                                            Click="OnAddFolderClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
            <StackPanel Grid.Row="3" Spacing="6" Margin="0,0,0,12"
                        Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Stretch" Background="Transparent">
                <AppBarButton Icon="SelectAll" Label="全选"
                              Command="{x:Bind ViewModel.SelectAllCommand}"
                              Click="OnSelectAllClick"
                              IsEnabled="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay}" />
                <AppBarButton x:Name="MoveSelectedButton" Icon="MoveToFolder" Label="移动"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanMoveSelection, ViewModel.CanStartVaultOperation), Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="MoveFolderFlyout" Opening="OnMoveSelectedFlyoutOpening" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="TransferSelectedToOrganizationButton"
                              Label="转移到组织"
                              Click="OnTransferSelectedToOrganizationClick"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanTransferSelectionToOrganization, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8AB;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="AddSelectedToCollectionsButton"
                              Label="加入集合"
                              Click="OnAddSelectedToCollectionsClick"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanManageSelectionCollections, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8B7;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="RemoveSelectedFromCollectionsButton"
                              Label="移出集合"
                              Click="OnRemoveSelectedFromCollectionsClick"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanManageSelectionCollections, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="归档"
                              Command="{x:Bind ViewModel.ArchiveSelectedCommand}"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanArchiveSelection, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.ShowArchiveSelectionAction, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE7B8;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Icon="Undo" Label="取消归档"
                              Command="{x:Bind ViewModel.UnarchiveSelectedCommand}"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanUnarchiveSelection, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.ShowUnarchiveSelectionAction, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <AppBarButton Icon="Delete" Label="移到回收站"
                              Command="{x:Bind ViewModel.SoftDeleteSelectedCommand}"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanDeleteSelection, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsTrashFilterSelected, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                <AppBarButton Icon="Undo" Label="恢复"
                              Command="{x:Bind ViewModel.RestoreSelectedCommand}"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanRestoreSelection, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsTrashFilterSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <AppBarButton x:Name="PermanentDeleteButton" Icon="Delete" Label="永久删除"
                              Click="OnPermanentDeleteSelectedClick"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanDeleteSelection, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsTrashFilterSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </CommandBar>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" />
                    <TextBlock VerticalAlignment="Center" Text="项已选" />
                    <Button Content="完成" Command="{x:Bind ViewModel.ToggleSelectionModeCommand}" />
                </StackPanel>
                <InfoBar x:Name="VaultSelectionPlacementErrorInfoBar"
                         Severity="Warning"
                         IsClosable="False"
                         IsOpen="{x:Bind ViewModel.HasSelectionPlacementError, Mode=OneWay}"
                         Message="{x:Bind ViewModel.SelectionPlacementError, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12"
                        Visibility="{x:Bind ViewModel.IsFolderFilterSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Button x:Name="RenameFolderButton" Content="重命名文件夹" Click="OnRenameFolderClick"
                        IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}" />
                <Button x:Name="DeleteFolderButton" Content="删除文件夹" Click="OnDeleteFolderClick"
                        IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="0" Margin="12,0,10,0">
                <InfoBar x:Name="VaultOfflineInfoBar"
                         Severity="Warning"
                         IsOpen="{x:Bind ViewModel.ShowDataStaleInfo, Mode=OneWay}"
                         IsClosable="False"
                         Title="离线"
                         Message="显示的是上次同步的数据,可能已过期。" />
                <InfoBar x:Name="VaultCommittedWarningInfoBar"
                         Severity="Warning"
                         IsOpen="{x:Bind ViewModel.ShowOperationWarningInfo, Mode=OneWay}"
                         IsClosable="False"
                         Title="{x:Bind ViewModel.OperationWarningTitle, Mode=OneWay}"
                         Message="{x:Bind ViewModel.OperationWarning, Mode=OneWay}"
                         AutomationProperties.LiveSetting="Polite" />
                <InfoBar x:Name="VaultSkippedInfoBar"
                         Severity="Informational"
                         IsClosable="True"
                         IsOpen="{x:Bind ViewModel.HasSkippedCiphers, Mode=OneWay}"
                         Message="{x:Bind ViewModel.SkippedCipherMessage, Mode=OneWay}" />
                <InfoBar x:Name="VaultOrganizationUnavailableInfoBar"
                         Severity="Warning"
                         IsClosable="False"
                         IsOpen="{x:Bind ViewModel.HasUnsupportedOrganizationCiphers, Mode=OneWay}"
                         Title="共享保险库不可用"
                         Message="{x:Bind ViewModel.UnsupportedOrganizationCipherMessage, Mode=OneWay}" />
                <Grid x:Name="VaultToolbar" Height="40" ColumnSpacing="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ComboBox x:Name="VaultTypeFilterBox" HorizontalAlignment="Left" Height="30" MinHeight="30" Width="100" Padding="6,0,0,0" Background="Transparent" BorderThickness="0"
                          SelectedIndex="{x:Bind ViewModel.SelectedTypeIndex, Mode=TwoWay}"
                          AutomationProperties.Name="条目类型">
                    <ComboBoxItem Content="全部类型" />
                    <ComboBoxItem Content="登录" />
                    <ComboBoxItem Content="支付卡" />
                    <ComboBoxItem Content="身份" />
                    <ComboBoxItem Content="安全笔记" />
                    <ComboBoxItem Content="SSH 密钥" />
                    <ComboBoxItem Content="银行账户" />
                    <ComboBoxItem Content="驾驶证" />
                    <ComboBoxItem Content="护照" />
                </ComboBox>

                    <ComboBox x:Name="SortComboBox"
                              Grid.Column="1" Width="102" MinWidth="86" Padding="6,0,0,0" Height="30" MinHeight="30" Background="Transparent" BorderThickness="0"
                              SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"
                              AutomationProperties.Name="排序方式"
                              AutomationProperties.AutomationId="VaultSortComboBox">
                        <ComboBoxItem Content="最近使用" />
                        <ComboBoxItem Content="名称 A–Z" />
                        <ComboBoxItem Content="最近修改" />
                        <ComboBoxItem Content="名称 Z–A" />
                        <ComboBoxItem Content="创建时间" />
                    </ComboBox>

                    <Button Grid.Column="3" Width="30" Height="30" MinHeight="30" Padding="5" Style="{StaticResource IconButtonStyle}"
                            AutomationProperties.Name="筛选和已保存视图" ToolTipService.ToolTip="筛选和已保存视图"
                            Visibility="{x:Bind ViewModel.IsTrashFilterSelected, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="FacetFilterButton" Width="30" Height="30" MinHeight="30" Padding="5" Background="Transparent" BorderThickness="0"
                                    AutomationProperties.Name="筛选"
                                    AutomationProperties.AutomationId="VaultFacetFilterButton">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71C;" FontSize="14" />
                            <InfoBadge Value="{x:Bind ViewModel.ActiveFacetCount, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.HasActiveFacets, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="6" MinWidth="200">
                                    <ToggleButton Content="含TOTP"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  IsChecked="{x:Bind ViewModel.FacetTotp, Mode=TwoWay}"
                                                  AutomationProperties.Name="按含 TOTP 筛选"
                                                  AutomationProperties.AutomationId="VaultFacetTotpToggle" />
                                    <ToggleButton Content="含附件"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  IsChecked="{x:Bind ViewModel.FacetAttachment, Mode=TwoWay}"
                                                  AutomationProperties.Name="按含附件筛选"
                                                  AutomationProperties.AutomationId="VaultFacetAttachmentToggle" />
                                    <ToggleButton Content="含网址"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  IsChecked="{x:Bind ViewModel.FacetUri, Mode=TwoWay}"
                                                  AutomationProperties.Name="按含网址筛选"
                                                  AutomationProperties.AutomationId="VaultFacetUriToggle" />
                                    <ToggleButton Content="仅收藏"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  IsChecked="{x:Bind ViewModel.FacetFavoriteOnly, Mode=TwoWay}"
                                                  AutomationProperties.Name="仅显示收藏"
                                                  AutomationProperties.AutomationId="VaultFacetFavoriteOnlyToggle" />
                                    <Border Height="1" Margin="0,2"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Button Content="清除全部筛选"
                                            HorizontalAlignment="Stretch"
                                            Click="OnClearFiltersClick"
                                            Visibility="{x:Bind ViewModel.HasActiveRefinement, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                            AutomationProperties.Name="清除筛选"
                                            AutomationProperties.AutomationId="VaultClearFiltersButton" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button x:Name="SavedViewsButton" Width="30" Height="30" MinHeight="30" Padding="5" Background="Transparent" BorderThickness="0"
                                    AutomationProperties.Name="视图"
                                    AutomationProperties.AutomationId="VaultSavedViewsButton">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="SavedViewsFlyout" Opening="OnSavedViewsFlyoutOpening">
                                <MenuFlyoutSeparator x:Name="SavedViewsStaticSeparator" />
                                <MenuFlyoutItem x:Name="SaveCurrentViewMenuItem"
                                                Text="保存当前视图…"
                                                Click="OnSaveCurrentViewClick"
                                                AutomationProperties.Name="保存当前视图"
                                                AutomationProperties.AutomationId="VaultSaveCurrentViewButton">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="EnterSelectionButton" Grid.Column="4" Width="30" Height="30" MinHeight="30" Padding="5" Style="{StaticResource IconButtonStyle}"
                            Click="OnEnterSelectionClick" AutomationProperties.Name="选择多个条目" ToolTipService.ToolTip="选择多个条目"
                            Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <FontIcon Glyph="&#xE762;" FontSize="16" />
                    </Button>
                    <Button Grid.Column="5" Content="清空回收站" Click="OnEmptyRecycleBinClick" Height="30" MinHeight="30" Padding="8,0"
                            Background="Transparent" BorderThickness="0" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CanEmptyRecycleBin, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="VaultEmptyRecycleBinButton" />
                </Grid>
                <Grid ColumnSpacing="8" Margin="4,0,4,4"
                      Visibility="{x:Bind ViewModel.ShowSearchScopeNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.SearchScopeText, Mode=OneWay}" FontSize="12" LineHeight="16" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="搜索全部条目" Click="OnSearchAllItemsClick" Height="24" MinHeight="24" Padding="0"
                            Background="Transparent" BorderThickness="0" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Grid>

            </StackPanel>

            <ListView Grid.Row="6"
                      x:Name="CipherList"
                      ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}"
                      Margin="6,0,6,8"
                      SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=OneWay}"
                      SingleSelectionFollowsFocus="False"
                      SelectionChanged="OnCipherSelectionChanged"
                      SelectionMode="{x:Bind local:VaultPage.SelectionModeFromBool(ViewModel.IsSelectionMode), Mode=OneWay}">
                <ListView.Header>
                    <Grid Height="52" Margin="0,6,0,0" Padding="12,0,8,0" ColumnSpacing="12" CornerRadius="4"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                          Visibility="{x:Bind local:VaultPage.NewDraftVisibility(ViewModel.IsEditing, ViewModel.CanChangeEditorType), Mode=OneWay}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <controls:FaviconView DisplayName="{x:Bind ViewModel.EditorDisplayDraft.Name, Mode=OneWay}" Kind="{x:Bind ViewModel.EditorDisplayDraft.Type, Mode=OneWay}" TileSize="32" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind local:VaultPage.DraftName(ViewModel.EditorDisplayDraft.Name, ViewModel.EditorDisplayDraft.Type), Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="新建 · 未保存" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </ListView.Header>
                <ListView.Resources>
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="52" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:CipherListItem">
                        <StackPanel>
                            <TextBlock Text="{x:Bind GroupHeader, Mode=OneWay}" Margin="12,14,12,6" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind HasGroupHeader, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        <Grid x:Name="RowRoot" CornerRadius="4" Loaded="OnRowLoaded"
                              ColumnSpacing="12"
                              Height="52" Padding="12,0,8,0"
                              PointerEntered="OnRowPointerEntered"
                              PointerExited="OnRowPointerExited"
                              RightTapped="OnRowRightTapped"
                              GotFocus="OnRowGotFocus"
                              LostFocus="OnRowLostFocus"
                              Unloaded="OnRowUnloaded">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="RowSelectionIndicator" Width="3" Height="16" CornerRadius="2" Margin="-12,0,0,0" HorizontalAlignment="Left"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                            <controls:FaviconView Domain="{Binding IconDomain}" DisplayName="{Binding Name}" Kind="{Binding Kind}"
                                                  FallbackGlyph="{Binding Glyph}" TileSize="32" IconSize="16" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="RowNameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Loaded="OnRowNameLoaded" />
                                <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                            </StackPanel>
                            <StackPanel x:Name="RowStatusIcons" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon x:Name="RowIssueGlyph" Loaded="OnRowIssueLoaded" FontSize="14" Visibility="Collapsed" />
                            <FontIcon x:Name="RowFavorite"
                                      Glyph="&#xE735;"
                                      FontSize="14"
                                      Margin="0,0,4,0"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      Visibility="{x:Bind local:VaultPage.VisibleIfTrue(Favorite)}" />
                            </StackPanel>
                            <StackPanel x:Name="RowActions"
                                        Grid.Column="2" Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        Opacity="0"
                                        IsHitTestVisible="False"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" MinWidth="28" MinHeight="28"
                                        AutomationProperties.Name="复制用户名" ToolTipService.ToolTip="复制用户名"
                                        Visibility="{x:Bind local:VaultPage.VisibleForLogin(Kind)}" Click="OnRowCopyUsernameClick">
                                    <FontIcon Glyph="&#xE77B;" FontSize="16" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        Width="28" Height="28" MinWidth="28" MinHeight="28"
                                        AutomationProperties.Name="复制"
                                        AutomationProperties.AutomationId="VaultRowCopyButton"
                                        ToolTipService.ToolTip="复制主值"
                                        IsEnabled="{Binding CanViewPassword}"
                                        Click="OnRowCopyPrimaryClick">
                                    <FontIcon Glyph="{x:Bind local:VaultPage.PrimaryCopyGlyph(Kind)}" FontSize="16" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Width="28" Height="28" MinWidth="28" MinHeight="28"
                                        AutomationProperties.Name="复制验证码" ToolTipService.ToolTip="复制验证码"
                                        Visibility="{x:Bind local:VaultPage.VisibleIfTrue(HasTotp)}" Click="OnRowCopyTotpClick">
                                    <FontIcon Glyph="&#xE916;" FontSize="16" />
                                </Button>
                                <Button x:Name="RowMoreButton" Style="{StaticResource IconButtonStyle}" Visibility="Collapsed"
                                        AutomationProperties.Name="更多"
                                        AutomationProperties.AutomationId="VaultRowMoreButton"
                                        ToolTipService.ToolTip="更多操作">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="编辑"
                                                            IsEnabled="{Binding CanModify}"
                                                            Click="OnRowEditClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfFalse(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="创建副本"
                                                            IsEnabled="{Binding CanClone}"
                                                            Click="OnRowCloneClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfFalse(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B0;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="收藏 / 取消收藏"
                                                            IsEnabled="{Binding CanFavorite}"
                                                            Click="OnRowFavoriteClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfFalse(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE734;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="归档"
                                                            IsEnabled="{Binding ShowArchiveAction}"
                                                            Click="OnRowArchiveClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfTrue(ShowArchiveAction)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="取消归档"
                                                            IsEnabled="{Binding ShowUnarchiveAction}"
                                                            Click="OnRowUnarchiveClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfTrue(ShowUnarchiveAction)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="移到回收站"
                                                            IsEnabled="{Binding CanDelete}"
                                                            Click="OnRowSoftDeleteClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfFalse(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="恢复"
                                                            IsEnabled="{Binding CanRestore}"
                                                            Click="OnRowRestoreClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfTrue(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="永久删除"
                                                            IsEnabled="{Binding CanDelete}"
                                                            Click="OnRowPermanentDeleteClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfTrue(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <InfoBar x:Name="VaultErrorInfoBar"
                     Grid.Row="5"
                     Margin="0,0,0,12"
                     VerticalAlignment="Top"
                     IsClosable="True"
                     Severity="Error"
                     IsOpen="{x:Bind ViewModel.HasOperationError, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.HasOperationError, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                     Message="{x:Bind ViewModel.OperationError, Mode=OneWay}" />

            <StackPanel x:Name="VaultEmptyPanel"
                        Grid.Row="6"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Spacing="4" Margin="24,56"
                        Visibility="{x:Bind ViewModel.HasNoItems, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}"
                           FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.EmptyStateHint, Mode=OneWay}" MaxWidth="260" TextWrapping="Wrap" LineHeight="16"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <Button Content="导入…" Click="OnEmptyImportClick" Height="32" MinHeight="32" Padding="12,0"
                            Visibility="{x:Bind ViewModel.ShowEmptyImportAction, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Button Content="新建登录" Click="OnAddLoginClick" Height="32" MinHeight="32" Padding="12,0" Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanBeginCipherCreate, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowEmptyCreateAction, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="VaultNoResultsPanel"
                        Grid.Row="6"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Spacing="4" Margin="24,56"
                        Visibility="{x:Bind ViewModel.NoResults, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{x:Bind ViewModel.NoResultsTitle, Mode=OneWay}"
                           FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <TextBlock Text="名称、用户名和网址都会被搜索" MaxWidth="260" TextWrapping="Wrap" LineHeight="16"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <StackPanel Spacing="8" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <Button Content="清除搜索" Click="OnClearSearchClick" Height="32" MinHeight="32" Padding="12,0" HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.ShowClearSearchAction, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Button Content="清除筛选" Click="OnClearFiltersClick" Height="32" MinHeight="32" Padding="12,0" HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.ShowClearRefinementAction, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Button Content="在全部条目中搜索" Click="OnSearchAllItemsClick" Height="32" MinHeight="32" Padding="12,0" HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsSearchScopeLimited, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{x:Bind ViewModel.NewSearchItemLabel, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" Click="OnNewFromSearchClick"
                            Height="32" MinHeight="32" Padding="12,0" MaxWidth="280" HorizontalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.CanBeginCipherCreate, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="6" Spacing="4" Margin="24,56" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsTrashEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="回收站是空的" FontSize="14" HorizontalAlignment="Center" />
                <TextBlock Text="删除的条目会显示在这里，可恢复或永久删除。" MaxWidth="260" TextWrapping="Wrap" TextAlignment="Center" LineHeight="16"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
            </StackPanel>
            <StackPanel Grid.Row="6" Spacing="4" Margin="24,56" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsArchiveEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="没有归档的条目" FontSize="14" HorizontalAlignment="Center" />
                <TextBlock Text="不常用但还想保留的条目可以归档，随时可以取消归档。" MaxWidth="260" TextWrapping="Wrap" TextAlignment="Center" LineHeight="16"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <Grid x:Name="VaultDetailPane" Grid.Row="1" Grid.Column="1"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
                <Button x:Name="VaultNarrowBackButton"
