                    <controls:DetailCard Title="银行账户"
                                         Visibility="{x:Bind ViewModel.EditorDisplayDraft.IsBankAccount, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <controls:DetailCard.CardContent>
                            <StackPanel Spacing="10">
                                <TextBox Header="银行" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.BankAccount.BankName, Mode=TwoWay}" />
                                <TextBox Header="账户持有人" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.BankAccount.NameOnAccount, Mode=TwoWay}" />
                                <TextBox Header="账户类型" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.BankAccount.AccountType, Mode=TwoWay}" />
                                <PasswordBox Header="账号" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.BankAccount.AccountNumber, Mode=TwoWay}" />
                                <PasswordBox Header="路由号码" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.BankAccount.RoutingNumber, Mode=TwoWay}" />
                                <PasswordBox Header="分行号码" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.BankAccount.BranchNumber, Mode=TwoWay}" />
                                <PasswordBox Header="PIN" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.BankAccount.Pin, Mode=TwoWay}" />
                                <PasswordBox Header="SWIFT / BIC" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.BankAccount.SwiftCode, Mode=TwoWay}" />
                                <PasswordBox Header="IBAN" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.BankAccount.Iban, Mode=TwoWay}" />
                                <TextBox Header="银行联系电话" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.BankAccount.BankContactPhone, Mode=TwoWay}" />
                            </StackPanel>
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>

                    <controls:DetailCard Title="驾驶证"
                                         Visibility="{x:Bind ViewModel.EditorDisplayDraft.IsDriversLicense, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <controls:DetailCard.CardContent>
                            <StackPanel Spacing="10">
                                <TextBox Header="名" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.DriversLicense.FirstName, Mode=TwoWay}" />
                                <TextBox Header="中间名" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.DriversLicense.MiddleName, Mode=TwoWay}" />
                                <TextBox Header="姓" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.DriversLicense.LastName, Mode=TwoWay}" />
                                <PasswordBox Header="出生日期" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.DriversLicense.DateOfBirth, Mode=TwoWay}" />
                                <PasswordBox Header="驾驶证号" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.DriversLicense.LicenseNumber, Mode=TwoWay}" />
                                <TextBox Header="签发国家/地区" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.DriversLicense.IssuingCountry, Mode=TwoWay}" />
                                <TextBox Header="签发州/省" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.DriversLicense.IssuingState, Mode=TwoWay}" />
                                <PasswordBox Header="签发日期" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.DriversLicense.IssueDate, Mode=TwoWay}" />
                                <PasswordBox Header="到期日期" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.DriversLicense.ExpirationDate, Mode=TwoWay}" />
                                <TextBox Header="签发机关" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.DriversLicense.IssuingAuthority, Mode=TwoWay}" />
                                <TextBox Header="驾驶证类别" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.DriversLicense.LicenseClass, Mode=TwoWay}" />
                            </StackPanel>
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>

                    <controls:DetailCard Title="护照"
                                         Visibility="{x:Bind ViewModel.EditorDisplayDraft.IsPassport, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <controls:DetailCard.CardContent>
                            <StackPanel Spacing="10">
                                <TextBox Header="姓" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.Passport.Surname, Mode=TwoWay}" />
                                <TextBox Header="名" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.Passport.GivenName, Mode=TwoWay}" />
                                <PasswordBox Header="出生日期" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.Passport.DateOfBirth, Mode=TwoWay}" />
                                <PasswordBox Header="性别" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.Passport.Sex, Mode=TwoWay}" />
                                <PasswordBox Header="出生地" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.Passport.BirthPlace, Mode=TwoWay}" />
                                <TextBox Header="国籍" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.Passport.Nationality, Mode=TwoWay}" />
                                <TextBox Header="签发国家/地区" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.Passport.IssuingCountry, Mode=TwoWay}" />
                                <PasswordBox Header="护照号码" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.Passport.PassportNumber, Mode=TwoWay}" />
                                <TextBox Header="护照类型" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.Passport.PassportType, Mode=TwoWay}" />
                                <PasswordBox Header="身份证件号码" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.Passport.NationalIdentificationNumber, Mode=TwoWay}" />
                                <TextBox Header="签发机关" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.Passport.IssuingAuthority, Mode=TwoWay}" />
                                <PasswordBox Header="签发日期" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.Passport.IssueDate, Mode=TwoWay}" />
                                <PasswordBox Header="到期日期" HorizontalAlignment="Stretch" Password="{x:Bind ViewModel.EditorDisplayDraft.Passport.ExpirationDate, Mode=TwoWay}" />
                            </StackPanel>
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>

                    <controls:DetailCard Title="安全笔记"
                                         Visibility="{x:Bind ViewModel.EditorDisplayDraft.IsSecureNote, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <controls:DetailCard.CardContent>
                            <TextBlock Text="安全笔记内容请填写在下方备注中。"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>

                    <controls:DetailCard Title="备注与安全">
                        <controls:DetailCard.CardContent>
                            <StackPanel Spacing="10">
                                <TextBox Header="备注"
                                         HorizontalAlignment="Stretch"
                                         Text="{x:Bind ViewModel.EditorDisplayDraft.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         MinHeight="96"
                                         TextWrapping="Wrap" />
                                <CheckBox IsChecked="{x:Bind ViewModel.EditorDisplayDraft.Reprompt, Mode=TwoWay}">
                                    <TextBlock Text="主密码重新提示" />
                                </CheckBox>
                                <Expander Header="自定义字段" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="12">
                                <ItemsControl x:Name="CustomFieldsEditorItems"
                                              ItemsSource="{x:Bind ViewModel.EditorDisplayDraft.CustomFields, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CustomFieldEditorDraft">
                                            <Grid ColumnSpacing="8" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="8">
                                                    <TextBox Header="名称"
                                                             HorizontalAlignment="Stretch"
                                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <ComboBox x:Name="CustomFieldTypeBox"
                                                              Header="类型"
                                                              HorizontalAlignment="Stretch"
                                                              SelectedIndex="{Binding TypeIndex, Mode=TwoWay}">
                                                        <ComboBoxItem Content="文本" Tag="Text" />
                                                        <ComboBoxItem Content="隐藏" Tag="Hidden" />
                                                        <ComboBoxItem Content="布尔值" Tag="Boolean" />
                                                        <ComboBoxItem Content="Linked" Tag="Linked" IsEnabled="False" />
                                                        <ComboBoxItem Content="Unsupported" Tag="Unsupported" IsEnabled="False" />
                                                    </ComboBox>
                                                    <TextBox x:Name="CustomFieldTextValueBox"
                                                             Header="值"
                                                             HorizontalAlignment="Stretch"
                                                             Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                                                    <PasswordBox x:Name="CustomFieldHiddenValueBox"
                                                                 Header="值"
                                                                 HorizontalAlignment="Stretch"
                                                                 Password="{Binding HiddenValue, Mode=TwoWay}"
                                                                 Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}" />
                                                    <CheckBox x:Name="CustomFieldBooleanValueCheckBox"
                                                              Content="已启用"
                                                              IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                                              Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <Button x:Name="RemoveCustomFieldButton"
                                                        Grid.Column="1"
                                                        VerticalAlignment="Top"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        AutomationProperties.Name="删除字段"
                                                        ToolTipService.ToolTip="删除字段"
                                                        Click="OnRemoveCustomFieldClick">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="AddCustomFieldButton"
                                        Content="添加字段"
                                        HorizontalAlignment="Left"
                                        Command="{x:Bind ViewModel.AddCustomFieldCommand}" />
                                </StackPanel>
                                </Expander>
                            </StackPanel>
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>
                    </StackPanel>
                </ContentControl>

                <StackPanel Spacing="12"
                            Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Spacing="12"
                            Visibility="{x:Bind ViewModel.HasDetailSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:FaviconView Domain="{x:Bind ViewModel.DetailIconDomain, Mode=OneWay}"
                                              FallbackGlyph="{x:Bind ViewModel.SelectedItem.Glyph, Mode=OneWay}"
                                              IconSize="24"
                                              Width="40" Height="40"
                                              VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Detail.Name, Mode=OneWay}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <FontIcon Grid.Column="2" Glyph="&#xE735;" FontSize="14"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                  Visibility="{x:Bind local:VaultPage.VisibleIfTrue(ViewModel.Detail.Favorite), Mode=OneWay}" />
                    </Grid>
                        <Button x:Name="EditCipherButton" Grid.Column="1" Content="编辑" VerticalAlignment="Center"
                                IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanModifySelectedItem, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsSelectedItemDeleted, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}"
                                Click="OnEditCipherClick" />
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.DetailLocation, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                             Title="只读条目" Message="你可以查看此条目。编辑需要保险库所有者授予权限。"
                             Visibility="{x:Bind ViewModel.ShowReadOnlyNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                             Title="敏感字段已隐藏" Message="此组织条目的权限不允许查看或复制密码。"
                             Visibility="{x:Bind ViewModel.ShowHiddenSecretsNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <!-- Authorization actions remain distinct from revealing a protected value. -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
                                Visibility="{x:Bind ViewModel.ShowSensitiveUnlock, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Button x:Name="UnlockSensitiveFieldsButton"
                            Content="验证后显示敏感字段"
                            Click="OnUnlockSensitiveFieldsClick"
                            AutomationProperties.AutomationId="VaultUnlockSensitiveFieldsButton"
                            Visibility="{x:Bind ViewModel.ShowSensitiveUnlock, Mode=OneWay,
                                Converter={StaticResource BoolToVis}}" />
                    <Button x:Name="ProtectedPasswordCopyButton" Content="复制密码"
                            Click="OnCopyProtectedPasswordClick"
                            Visibility="{x:Bind ViewModel.ShowProtectedPasswordCopy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
                <ContentControl x:Name="DetailHost"
                                HorizontalContentAlignment="Stretch" />

                <!-- 共用底部:备注/自定义字段/历史/操作 -->
                <StackPanel Spacing="12"
                            Visibility="{x:Bind ViewModel.HasDetailSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <!-- 备注 -->
                    <controls:DetailCard Title="备注"
                                Visibility="{x:Bind ViewModel.ShowDetailNotes, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <controls:DetailCard.CardContent>
                            <controls:FieldRow Label="备注" Value="{x:Bind ViewModel.Detail.Notes, Mode=OneWay}" />
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>
                    <!-- 附件 -->
                    <Expander Header="{x:Bind ViewModel.Detail.AttachmentHeader, Mode=OneWay}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="6">
                        <TextBlock Text="暂无附件"
                                   Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                                   Visibility="{x:Bind ViewModel.Detail.HasAttachments, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                        <ItemsControl x:Name="AttachmentsItems"
                                      ItemsSource="{x:Bind ViewModel.Detail.Attachments, Mode=OneWay}"
                                      IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanModifySelectedItem, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.Detail.HasAttachments, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AttachmentItem">
                                    <Grid ColumnSpacing="8" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding Glyph}" FontSize="16"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FileName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SizeName}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"
                                                   Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                        <Button Grid.Column="3"
                                                Style="{StaticResource IconButtonStyle}"
                                                AutomationProperties.Name="下载附件"
                                                ToolTipService.ToolTip="下载"
                                                Click="OnDownloadAttachmentClick">
                                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                                        </Button>
                                        <Button Grid.Column="4"
                                                Style="{StaticResource IconButtonStyle}"
                                                AutomationProperties.Name="删除附件"
                                                ToolTipService.ToolTip="删除"
                                                Click="OnDeleteAttachmentClick">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14"
                                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="AddAttachmentButton"
                                Content="添加附件"
                                HorizontalAlignment="Left"
                                IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanModifySelectedItem, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                                Click="OnAddAttachmentClick" />
                    </StackPanel>
                    </Expander>
                    <!-- 自定义字段 -->
                    <Expander Header="{x:Bind ViewModel.Detail.CustomFieldsHeader, Mode=OneWay}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Visibility="{x:Bind ViewModel.Detail.HasCustomFields, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Detail.CustomFields, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:CustomField">
                                <!-- Protected values are absent until the item authorization succeeds. -->
                                <controls:FieldRow Label="{Binding Label}" Value="{Binding Value}" IsSecret="{Binding IsSecret}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Expander>
                    <!-- 历史 -->
                    <Expander Header="项目历史" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBlock Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                                   Text="{x:Bind ViewModel.Detail.HistoryText, Mode=OneWay}" />
                    </Expander>
                    <!-- 操作错误条 -->
                    <TextBlock Text="{x:Bind ViewModel.OperationError, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.OperationError, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="TransferCipherToOrganizationButton"
                                Click="OnTransferCipherToOrganizationClick"
                                IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.CanTransferSelectedItem, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                                <TextBlock Text="转移到组织" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ManageCipherCollectionsButton"
                                Click="OnManageCipherCollectionsClick"
                                IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.CanManageSelectedItemCollections, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="管理集合" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- 操作:常规(非回收站) -->
                    <Grid ColumnSpacing="8"
                          Visibility="{x:Bind ViewModel.IsSelectedItemDeleted, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DeleteCipherButton" Grid.Column="0" HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanDeleteSelectedItem, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                                Click="OnDeleteCipherClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="删除" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ArchiveCipherButton" Grid.Column="1" HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanArchiveSelectedItem, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                                Click="OnArchiveCipherClick"
                                Visibility="{x:Bind ViewModel.CanArchiveSelectedItem, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7B8;" FontSize="14" /><TextBlock Text="归档" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="UnarchiveCipherButton" Grid.Column="1" HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanUnarchiveSelectedItem, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                                Click="OnUnarchiveCipherClick"
                                Visibility="{x:Bind ViewModel.CanUnarchiveSelectedItem, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7A7;" FontSize="14" /><TextBlock Text="取消归档" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- 操作:回收站 -->
                    <Grid ColumnSpacing="8"
                          Visibility="{x:Bind ViewModel.IsSelectedItemDeleted, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RestoreCipherButton" HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanRestoreSelectedItem, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                                Click="OnRestoreCipherClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7A7;" FontSize="14" /><TextBlock Text="恢复" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PermanentDeleteCipherButton" Grid.Column="1" HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanDeleteSelectedItem, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                                Click="OnPermanentDeleteCipherClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="永久删除" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

            <Border x:Name="CipherEditorFooter" Grid.Row="2" Padding="24,16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                    Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="保存前在此设备加密" TextWrapping="Wrap"
                               VerticalAlignment="Center" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                    <Button x:Name="SaveCipherEditorButton" Grid.Column="1" Content="保存" MinWidth="88"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanSaveEditorDraft, ViewModel.HasValidEditorDraft), Mode=OneWay}"
                            Click="OnSaveCipherEditorClick" />
                    <Button x:Name="CancelCipherEditorButton" Grid.Column="2" Content="取消" MinWidth="80"
                            IsEnabled="{x:Bind ViewModel.CanCancelEditor, Mode=OneWay}"
                            Click="OnCancelCipherEditorClick" />
                </Grid>
            </Border>

            <!-- 空状态浮层:在整个右栏内水平+垂直居中(不再随详情内容靠左偏上) -->
            <StackPanel x:Name="VaultNoSelectionPanel"
                        Grid.Row="1" Margin="24"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="{StaticResource SpacingMedium}"
                        Visibility="{x:Bind ViewModel.ShowNoSelectionPlaceholder, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Border Width="76" Height="76" CornerRadius="20"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE72E;" FontSize="30" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Text="选择一个条目"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="选择登录、支付卡或密钥，查看其详细信息。" TextWrapping="Wrap"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
