                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CustomFieldEditorDraft">
                                            <Grid MinHeight="52" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
                                                <Grid ColumnSpacing="2" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="CustomFieldNameBox" PlaceholderText="字段名称" Height="32" MinHeight="32" Padding="8,0"
                                                             HorizontalAlignment="Stretch" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="自定义字段名称" />
                                                    <Button Grid.Column="1" Width="20" MinWidth="20" Height="32" MinHeight="32" Padding="2" Background="Transparent" BorderThickness="0"
                                                            AutomationProperties.Name="字段类型" ToolTipService.ToolTip="字段类型">
                                                        <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                                        <Button.Flyout>
                                                            <Flyout>
                                                                <ComboBox x:Name="CustomFieldTypeBox" Header="类型" HorizontalAlignment="Stretch" MinWidth="180"
                                                                          SelectedIndex="{Binding TypeIndex, Mode=TwoWay}" AutomationProperties.Name="自定义字段类型" >
                                                                    <ComboBoxItem Content="文本" Tag="Text" />
                                                                    <ComboBoxItem Content="隐藏" Tag="Hidden" />
                                                                    <ComboBoxItem Content="布尔值" Tag="Boolean" />
                                                                    <ComboBoxItem Content="Linked" Tag="Linked" IsEnabled="False" />
                                                                    <ComboBoxItem Content="Unsupported" Tag="Unsupported" IsEnabled="False" />
                                                                </ComboBox>
                                                            </Flyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </Grid>
                                                <TextBox x:Name="CustomFieldTextValueBox" Grid.Column="1" PlaceholderText="值" Height="32" MinHeight="32" VerticalAlignment="Center"
                                                         HorizontalAlignment="Stretch" Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="自定义字段值" />
                                                <PasswordBox x:Name="CustomFieldHiddenValueBox" Grid.Column="1" PlaceholderText="隐藏的值" Height="32" MinHeight="32" VerticalAlignment="Center"
                                                             FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Stretch" PasswordRevealMode="Hidden"
                                                             Password="{Binding HiddenValue, Mode=TwoWay}"
                                                             Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="隐藏字段值" />
                                                <CheckBox x:Name="CustomFieldBooleanValueCheckBox" Grid.Column="1" Content="已启用" VerticalAlignment="Center"
                                                          IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                                          Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="布尔字段值" />
                                                <TextBlock Grid.Column="1" Text="关联字段保留原有设置" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Visibility="{Binding IsLinked, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Grid.Column="1" Text="此字段的原有值将被保留" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Visibility="{Binding IsUnsupported, Converter={StaticResource BoolToVis}}" />
                                                <Grid Grid.Column="2" Width="66" ColumnSpacing="2" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                                    <Button Tag="EditorReveal" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" MinWidth="32" MinHeight="32"
                                                            Click="OnRevealEditorSecretClick" AutomationProperties.Name="显示隐藏字段" ToolTipService.ToolTip="显示"
                                                            Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}">
                                                        <FontIcon Glyph="&#xE890;" FontSize="16" />
                                                    </Button>
                                                    <Button x:Name="RemoveCustomFieldButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" MinWidth="32" MinHeight="32"
                                                            AutomationProperties.Name="删除字段" ToolTipService.ToolTip="删除这个字段" Click="OnRemoveCustomFieldClick">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl x:Name="EditorAttachmentsItems" ItemsSource="{x:Bind ViewModel.Detail.Attachments, Mode=OneWay}"
                                              IsEnabled="{x:Bind ViewModel.CanManageEditorAttachments, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.HasDetailSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:AttachmentItem">
                                            <Grid MinHeight="56" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="附件" Loaded="OnAttachmentLabelLoaded" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SizeName}" FontSize="12" LineHeight="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Grid Grid.Column="2" Width="66" ColumnSpacing="2" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" MinWidth="32" MinHeight="32"
                                                            Click="OnDeleteAttachmentClick" AutomationProperties.Name="删除附件" ToolTipService.ToolTip="删除附件">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid MinHeight="52" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="重新验证" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <CheckBox x:Name="CipherEditorRepromptCheckBox" Grid.Column="1" IsChecked="{x:Bind ViewModel.EditorDisplayDraft.Reprompt, Mode=TwoWay}"
                                              VerticalAlignment="Center" AutomationProperties.Name="主密码重新验证">
                                        <TextBlock Text="查看、复制或编辑前要输入主密码" TextWrapping="Wrap" />
                                    </CheckBox>
                                </Grid>
                                <Grid MinHeight="48" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="添加" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Grid x:Name="EditorAddActions" Grid.Column="1" VerticalAlignment="Center" ColumnSpacing="4" SizeChanged="OnEditorAddActionsSizeChanged">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Button x:Name="AddCustomFieldButton" Height="32" MinHeight="32" Padding="8,0" HorizontalAlignment="Left"
                                                Background="Transparent" BorderThickness="0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Click="OnAddTextCustomFieldClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="文本字段" /></StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Height="32" MinHeight="32" Padding="8,0" HorizontalAlignment="Left"
                                                Background="Transparent" BorderThickness="0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Click="OnAddHiddenCustomFieldClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="隐藏字段" /></StackPanel>
                                        </Button>
                                        <Button x:Name="EditorAddAttachmentButton" Grid.Column="2" Height="32" MinHeight="32" Padding="8,0" HorizontalAlignment="Left"
                                                Background="Transparent" BorderThickness="0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Click="OnAddAttachmentClick"
                                                IsEnabled="{x:Bind ViewModel.CanManageEditorAttachments, Mode=OneWay}" ToolTipService.ToolTip="保存条目更改后添加附件">
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE723;" FontSize="14" /><TextBlock Text="附件…" /></StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                                <TextBlock Text="保存条目后可添加附件。" FontSize="12" LineHeight="16" Margin="128,8,0,0" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind ViewModel.CanChangeEditorType, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <Grid MinHeight="52" ColumnSpacing="16" Padding="0,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="备注" VerticalAlignment="Top" Margin="0,6,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox Grid.Column="1" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.EditorDisplayDraft.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" MinHeight="96" TextWrapping="Wrap" AutomationProperties.Name="备注" />
                                </Grid>
                            </StackPanel>
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>
                    </StackPanel>
                </ContentControl>

                <StackPanel x:Name="DetailViewPanel" Spacing="12"
                            Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Spacing="12"
                            Visibility="{x:Bind ViewModel.HasDetailSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid x:Name="DetailHeaderGrid" ColumnSpacing="16" RowSpacing="8" SizeChanged="OnDetailHeaderSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <controls:FaviconView Domain="{x:Bind ViewModel.DetailIconDomain, Mode=OneWay}"
                                              DisplayName="{x:Bind ViewModel.Detail.Name, Mode=OneWay}"
                                              Kind="{x:Bind ViewModel.Detail.Kind, Mode=OneWay}"
                                              FallbackGlyph="{x:Bind ViewModel.SelectedItem.Glyph, Mode=OneWay}"
                                              TileSize="56" IconSize="24" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="0">
                            <TextBlock Text="{x:Bind ViewModel.Detail.Name, Mode=OneWay}" FontSize="28" LineHeight="36" FontWeight="SemiBold"
                                       FontFamily="{StaticResource WardenDisplayFontFamily}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ViewModel.DetailLocation, Mode=OneWay}" FontSize="12" LineHeight="18"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel x:Name="DetailHeaderActions" Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0"
                                    Visibility="{x:Bind ViewModel.IsSelectedItemDeleted, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                            <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="收藏 / 取消收藏"
                                    AutomationProperties.Name="收藏 / 取消收藏" Click="OnDetailFavoriteClick">
                                <FontIcon Glyph="{x:Bind local:VaultPage.FavoriteGlyph(ViewModel.Detail.Favorite), Mode=OneWay}" FontSize="16" />
                            </Button>
                            <Button x:Name="EditCipherButton" Height="32" MinHeight="32" Padding="12,0" ToolTipService.ToolTip="编辑 · F2"
                                    IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanModifySelectedItem, ViewModel.CanStartVaultOperation), Mode=OneWay}" Click="OnEditCipherClick">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE70F;" FontSize="16" /><TextBlock Text="编辑" /></StackPanel>
                            </Button>
                            <Button x:Name="OpenWebsiteButton" Height="32" MinHeight="32" Padding="14,0" Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind ViewModel.HasDetailWebsite, Mode=OneWay, Converter={StaticResource BoolToVis}}" Click="OnOpenWebsiteClick"
                                    ToolTipService.ToolTip="打开网站" AutomationProperties.Name="打开网站">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A7;" FontSize="16" /><TextBlock x:Name="OpenWebsiteLabel" Text="打开网站" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="更多" AutomationProperties.Name="更多">
                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="创建副本" Click="OnDetailCloneClick" />
                                        <MenuFlyoutItem x:Name="ArchiveCipherButton" Text="归档" Click="OnArchiveCipherClick"
                                            Visibility="{x:Bind ViewModel.CanArchiveSelectedItem, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        <MenuFlyoutItem x:Name="UnarchiveCipherButton" Text="取消归档" Click="OnUnarchiveCipherClick"
                                            Visibility="{x:Bind ViewModel.CanUnarchiveSelectedItem, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        <MenuFlyoutItem x:Name="TransferCipherToOrganizationButton" Text="转移到组织" Click="OnTransferCipherToOrganizationClick"
                                            Visibility="{x:Bind ViewModel.CanTransferSelectedItem, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        <MenuFlyoutItem x:Name="ManageCipherCollectionsButton" Text="管理集合" Click="OnManageCipherCollectionsClick"
                                            Visibility="{x:Bind ViewModel.CanManageSelectedItemCollections, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        <MenuFlyoutItem Text="添加附件" Click="OnAddAttachmentClick" IsEnabled="{x:Bind ViewModel.CanModifySelectedItem, Mode=OneWay}" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="DeleteCipherButton" Text="移到回收站" Click="OnDeleteCipherClick"
                                            IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanDeleteSelectedItem, ViewModel.CanStartVaultOperation), Mode=OneWay}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0"
                                    Visibility="{x:Bind ViewModel.IsSelectedItemDeleted, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Button x:Name="PermanentDeleteCipherButton" Content="永久删除" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Click="OnPermanentDeleteCipherClick" />
                            <Button x:Name="RestoreCipherButton" Content="恢复" Click="OnRestoreCipherClick" />
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="DetailStatusRow" Orientation="Horizontal" Spacing="8" Margin="72,0,0,0">
                        <FontIcon x:Name="DetailStatusIcon" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock x:Name="DetailStatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button x:Name="ChangePasswordButton" Content="更换密码 →" Height="24" MinHeight="24" Padding="8,0"
                                Background="Transparent" BorderThickness="0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Click="OnChangePasswordClick" Visibility="Collapsed" />
                    </StackPanel>
                    <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                             Title="只读条目" Message="你可以查看此条目。编辑需要保险库所有者授予权限。"
                             Visibility="{x:Bind ViewModel.ShowReadOnlyNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <InfoBar Severity="Informational" IsOpen="True" IsClosable="False"
                             Title="敏感字段已隐藏" Message="此组织条目的权限不允许查看或复制密码。"
                             Visibility="{x:Bind ViewModel.ShowHiddenSecretsNotice, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left"
                                Visibility="{x:Bind ViewModel.ShowSensitiveUnlock, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Button x:Name="UnlockSensitiveFieldsButton"
                            Content="验证后显示敏感字段"
                            Click="OnUnlockSensitiveFieldsClick"
                            AutomationProperties.AutomationId="VaultUnlockSensitiveFieldsButton"
                            Visibility="{x:Bind ViewModel.ShowSensitiveUnlock, Mode=OneWay,
                                Converter={StaticResource BoolToVis}}" />
                    <Button x:Name="ProtectedPasswordCopyButton" Content="复制密码"
                            Click="OnCopyProtectedPasswordClick"
                            Visibility="{x:Bind ViewModel.ShowProtectedPasswordCopy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
                <controls:CopyStrip x:Name="DetailCopyStrip" Detail="{x:Bind ViewModel.Detail, Mode=OneWay}" Margin="-12,16,-12,0"
                                    Loaded="OnCopyStripLoaded" Copied="OnCopyStripCopied" />
                <ContentControl x:Name="DetailHost" Margin="0,16,0,0"
                                HorizontalContentAlignment="Stretch" />

                <StackPanel Spacing="0" Margin="0,12,0,0"
                            Visibility="{x:Bind ViewModel.HasDetailSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Visibility="{x:Bind ViewModel.Detail.HasCustomFields, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Detail.CustomFields, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:CustomField">
                                <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="{Binding Label}" Value="{Binding Value}" IsSecret="{Binding IsSecret}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Border>
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Visibility="{x:Bind ViewModel.Detail.HasAttachments, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="0">
                        <TextBlock Text="暂无附件"
                                   Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                                   Visibility="{x:Bind ViewModel.Detail.HasAttachments, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                        <ItemsControl x:Name="AttachmentsItems"
                                      ItemsSource="{x:Bind ViewModel.Detail.Attachments, Mode=OneWay}"
                                      IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanModifySelectedItem, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.Detail.HasAttachments, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AttachmentItem">
                                    <Grid ColumnSpacing="16" MinHeight="56" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="附件" Loaded="OnAttachmentLabelLoaded" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SizeName}" FontSize="12" LineHeight="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="下载附件"
                                                ToolTipService.ToolTip="下载" Click="OnDownloadAttachmentClick">
                                            <FontIcon Glyph="&#xE896;" FontSize="16" />
                                        </Button>
                                        <Button Grid.Column="3" Visibility="Collapsed" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="删除附件"
                                                ToolTipService.ToolTip="删除" Click="OnDeleteAttachmentClick">
                                            <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="AddAttachmentButton"
                                Content="添加附件" Visibility="Collapsed"
                                HorizontalAlignment="Left"
                                IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanModifySelectedItem, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                                Click="OnAddAttachmentClick" />
                    </StackPanel>
                    </Border>
                    <controls:DetailCard
                                Visibility="{x:Bind ViewModel.ShowDetailNotes, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <controls:DetailCard.CardContent>
                            <controls:FieldRow FieldUsed="OnFieldUsed" Loaded="OnFieldRowLoaded" Label="备注" IsMultiline="True" IsReadOnly="{x:Bind ViewModel.Detail.IsDeleted, Mode=OneWay}" Value="{x:Bind ViewModel.Detail.Notes, Mode=OneWay}" />
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>
                    <Border Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                                   Text="{x:Bind ViewModel.Detail.HistoryText, Mode=OneWay}" />
                    </Border>
                    <TextBlock Text="{x:Bind ViewModel.OperationError, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.OperationError, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}" />
                </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

            <StackPanel x:Name="VaultNoSelectionPanel"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="12" Margin="24,56"
                        Visibility="{x:Bind ViewModel.ShowNoSelectionPlaceholder, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <FontIcon Glyph="&#xE8D7;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="没有可显示的条目" TextWrapping="Wrap" LineHeight="16"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
        <Border x:Name="VaultToast" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="24" Padding="16,10" CornerRadius="8" Visibility="Collapsed"
                Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock x:Name="VaultToastText" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="VaultUndoButton" Content="撤销" Click="OnUndoClick" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
