                                </Expander>
                            </StackPanel>
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>

                    <controls:DetailCard Title="SSH 密钥"
                                         Visibility="{x:Bind ViewModel.EditorDisplayDraft.IsSshKey, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <controls:DetailCard.CardContent>
                            <StackPanel Spacing="10">
                                <TextBox Header="公钥"
                                         HorizontalAlignment="Stretch"
                                         Text="{x:Bind ViewModel.EditorDisplayDraft.SshKey.PublicKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         MinHeight="72"
                                         TextWrapping="Wrap" />
