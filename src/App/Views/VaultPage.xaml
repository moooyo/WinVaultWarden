<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.VaultPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App.Views"
    xmlns:controls="using:App.Controls"
    xmlns:conv="using:App.Converters"
    xmlns:models="using:App.ViewModels.Models">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsed" />
        <DataTemplate x:Key="LoginTemplate" x:DataType="models:LoginDetail">
            <StackPanel Spacing="12">
                <controls:DetailCard Title="登录信息">
                    <controls:DetailCard.CardContent>
                        <StackPanel Spacing="2">
                            <controls:FieldRow Label="用户名" Value="{Binding Username}" HideWhenEmpty="False" />
                            <StackPanel Visibility="{Binding SensitiveUnlocked, Converter={StaticResource BoolToVis}}">
                                <controls:FieldRow Label="密码" Value="{Binding Password}" IsSecret="True" HideWhenEmpty="False"
                                                   CopyButtonText="复制密码" EmptyValueText="{Binding PasswordEmptyText}" />
                            </StackPanel>
                            <StackPanel Padding="0,10" Spacing="5"
                                        Visibility="{Binding SensitiveUnlocked, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="密码" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                <TextBlock Text="{Binding PasswordEmptyText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <controls:TotpField Secret="{Binding TotpSecret}" />
                        </StackPanel>
                    </controls:DetailCard.CardContent>
                </controls:DetailCard>
                <controls:DetailCard Title="网站">
                    <controls:DetailCard.CardContent>
                        <ItemsControl ItemsSource="{Binding DisplayUris}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <controls:FieldRow Label="网址" Value="{Binding}" ShowOpen="True" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:DetailCard.CardContent>
                </controls:DetailCard>
                <Expander Header="Passkey" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                     Visibility="{Binding HasPasskeys, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Passkeys}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PasskeyDetail">
                                    <StackPanel Spacing="2">
                                        <controls:FieldRow Label="RP ID" Value="{Binding RpId}" />
                                        <controls:FieldRow Label="账号" Value="{Binding DisplayName}" />
                                        <controls:FieldRow Label="可发现" Value="{Binding DiscoverableText}" />
                                        <controls:FieldRow Label="创建" Value="{Binding CreatedText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </Expander>
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Visibility="{Binding HasPasswordHistory, Converter={StaticResource BoolToVis}}">
                    <Expander.Header>
                        <TextBlock>
                            <Run Text="密码历史 (" /><Run Text="{Binding PasswordHistoryCount}" /><Run Text=")" />
                        </TextBlock>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding PasswordHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PasswordHistoryItem">
                                <!-- Password history values come from the authorized detail projection. -->
                                <controls:FieldRow Label="{Binding DateLabel}" Value="{Binding Password}" IsSecret="True" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="CardTemplate" x:DataType="models:CardDetail">
            <controls:DetailCard Title="卡信息">
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow Label="持卡人" Value="{Binding Cardholder}" />
                        <controls:FieldRow Label="卡号" Value="{Binding Number}" IsSecret="True" />
                        <controls:FieldRow Label="有效期" Value="{Binding Expiry}" />
                        <controls:FieldRow Label="品牌" Value="{Binding Brand}" />
                        <controls:FieldRow Label="CVV" Value="{Binding Cvv}" IsSecret="True" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="IdentityTemplate" x:DataType="models:IdentityDetail">
            <controls:DetailCard Title="个人信息">
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow Label="姓名" Value="{Binding FullName}" />
                        <controls:FieldRow Label="用户名" Value="{Binding Username}" />
                        <controls:FieldRow Label="公司" Value="{Binding Company}" />
                        <controls:FieldRow Label="邮箱" Value="{Binding Email}" />
                        <controls:FieldRow Label="电话" Value="{Binding Phone}" />
                        <controls:FieldRow Label="证件号" Value="{Binding IdNumber}" IsSecret="True" />
                        <controls:FieldRow Label="护照号码" Value="{Binding PassportNumber}" IsSecret="True" />
                        <controls:FieldRow Label="驾驶证号" Value="{Binding LicenseNumber}" IsSecret="True" />
                        <controls:FieldRow Label="地址" Value="{Binding Address}" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="NoteTemplate" x:DataType="models:NoteDetail">
            <controls:DetailCard Title="内容">
                <controls:DetailCard.CardContent>
                    <controls:FieldRow Label="笔记" Value="{Binding Content}" CopyButtonText="复制笔记" />
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="SshTemplate" x:DataType="models:SshDetail">
            <controls:DetailCard Title="密钥">
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow Label="公钥" Value="{Binding PublicKey}" />
                        <controls:FieldRow Label="私钥" Value="{Binding PrivateKey}" IsSecret="True" />
                        <controls:FieldRow Label="指纹" Value="{Binding Fingerprint}" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="BankAccountTemplate" x:DataType="models:BankAccountDetail">
            <controls:DetailCard Title="银行账户">
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow Label="银行" Value="{Binding BankName}" />
                        <controls:FieldRow Label="账户持有人" Value="{Binding NameOnAccount}" />
                        <controls:FieldRow Label="账户类型" Value="{Binding AccountType}" />
                        <controls:FieldRow Label="账号" Value="{Binding AccountNumber}" IsSecret="True" />
                        <controls:FieldRow Label="路由号码" Value="{Binding RoutingNumber}" IsSecret="True" />
                        <controls:FieldRow Label="分行号码" Value="{Binding BranchNumber}" IsSecret="True" />
                        <controls:FieldRow Label="PIN" Value="{Binding Pin}" IsSecret="True" />
                        <controls:FieldRow Label="SWIFT / BIC" Value="{Binding SwiftCode}" IsSecret="True" />
                        <controls:FieldRow Label="IBAN" Value="{Binding Iban}" IsSecret="True" />
                        <controls:FieldRow Label="银行联系电话" Value="{Binding BankContactPhone}" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="DriversLicenseTemplate" x:DataType="models:DriversLicenseDetail">
            <controls:DetailCard Title="驾驶证">
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow Label="姓名" Value="{Binding FullName}" />
                        <controls:FieldRow Label="出生日期" Value="{Binding DateOfBirth}" IsSecret="True" />
                        <controls:FieldRow Label="驾驶证号" Value="{Binding LicenseNumber}" IsSecret="True" />
                        <controls:FieldRow Label="签发国家/地区" Value="{Binding IssuingCountry}" />
                        <controls:FieldRow Label="签发州/省" Value="{Binding IssuingState}" />
                        <controls:FieldRow Label="签发日期" Value="{Binding IssueDate}" IsSecret="True" />
                        <controls:FieldRow Label="到期日期" Value="{Binding ExpirationDate}" IsSecret="True" />
                        <controls:FieldRow Label="签发机关" Value="{Binding IssuingAuthority}" />
                        <controls:FieldRow Label="驾驶证类别" Value="{Binding LicenseClass}" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>
        <DataTemplate x:Key="PassportTemplate" x:DataType="models:PassportDetail">
            <controls:DetailCard Title="护照">
                <controls:DetailCard.CardContent>
                    <StackPanel Spacing="2">
                        <controls:FieldRow Label="姓名" Value="{Binding FullName}" />
                        <controls:FieldRow Label="出生日期" Value="{Binding DateOfBirth}" IsSecret="True" />
                        <controls:FieldRow Label="性别" Value="{Binding Sex}" IsSecret="True" />
                        <controls:FieldRow Label="出生地" Value="{Binding BirthPlace}" IsSecret="True" />
                        <controls:FieldRow Label="国籍" Value="{Binding Nationality}" />
                        <controls:FieldRow Label="签发国家/地区" Value="{Binding IssuingCountry}" />
                        <controls:FieldRow Label="护照号码" Value="{Binding PassportNumber}" IsSecret="True" />
                        <controls:FieldRow Label="护照类型" Value="{Binding PassportType}" />
                        <controls:FieldRow Label="身份证件号码" Value="{Binding NationalIdentificationNumber}" IsSecret="True" />
                        <controls:FieldRow Label="签发机关" Value="{Binding IssuingAuthority}" />
                        <controls:FieldRow Label="签发日期" Value="{Binding IssueDate}" IsSecret="True" />
                        <controls:FieldRow Label="到期日期" Value="{Binding ExpirationDate}" IsSecret="True" />
                    </StackPanel>
                </controls:DetailCard.CardContent>
            </controls:DetailCard>
        </DataTemplate>

    </Page.Resources>

    <Grid x:Name="VaultLayoutRoot" SizeChanged="OnVaultLayoutSizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="VaultLayoutStates">
                <VisualState x:Name="Wide">
                    <VisualState.Setters>
                        <Setter Target="VaultListColumn.Width" Value="360" />
                        <Setter Target="VaultDetailColumn.Width" Value="*" />
                        <Setter Target="VaultListPane.Visibility" Value="Visible" />
                        <Setter Target="VaultDetailPane.Visibility" Value="Visible" />
                        <Setter Target="VaultNarrowBackButton.Visibility" Value="Collapsed" />
                        <Setter Target="PendingCipherCreateActions.Orientation" Value="Horizontal" />
                        <Setter Target="PendingCipherCreateCheckButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="PendingCipherCreateAbandonButton.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowList">
                    <VisualState.Setters>
                        <Setter Target="VaultListColumn.Width" Value="*" />
                        <Setter Target="VaultDetailColumn.Width" Value="0" />
                        <Setter Target="VaultListPane.Visibility" Value="Visible" />
                        <Setter Target="VaultDetailPane.Visibility" Value="Collapsed" />
                        <Setter Target="VaultNarrowBackButton.Visibility" Value="Collapsed" />
                        <Setter Target="PendingCipherCreateActions.Orientation" Value="Vertical" />
                        <Setter Target="PendingCipherCreateCheckButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PendingCipherCreateAbandonButton.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowDetail">
                    <VisualState.Setters>
                        <Setter Target="VaultListColumn.Width" Value="0" />
                        <Setter Target="VaultDetailColumn.Width" Value="*" />
                        <Setter Target="VaultListPane.Visibility" Value="Collapsed" />
                        <Setter Target="VaultDetailPane.Visibility" Value="Visible" />
                        <Setter Target="VaultNarrowBackButton.Visibility" Value="Visible" />
                        <Setter Target="PendingCipherCreateActions.Orientation" Value="Vertical" />
                        <Setter Target="PendingCipherCreateCheckButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="PendingCipherCreateAbandonButton.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="VaultListColumn" Width="360" />
            <ColumnDefinition x:Name="VaultDetailColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="VaultGlobalStatusPanel" Grid.Row="0" Grid.ColumnSpan="2">
            <StackPanel x:Name="VaultBusyPanel"
                        Margin="12,8,12,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressRing x:Name="VaultBusyRing"
                              Width="20"
                              Height="20"
                              AutomationProperties.AutomationId="VaultBusyRing"
                              IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.BusyMessage, Mode=OneWay}"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>

            <Border x:Name="PendingCipherCreateRecoveryPanel"
                    Margin="12,8,12,0"
                    Padding="12"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.HasPendingCipherCreate, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.LiveSetting="Polite">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;"
                              FontSize="18"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}"
                              VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.PendingCipherCreateTitle, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextWrapping="WrapWholeWords" />
                        <TextBlock Text="{x:Bind ViewModel.PendingCipherCreateMessage, Mode=OneWay}"
                                   TextWrapping="WrapWholeWords" />
                        <TextBlock Text="再次同步检查只读取服务器状态，不会重新提交创建请求。"
                                   Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.PendingCipherCreateDraftMessage, Mode=OneWay}"
                                   Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                        <StackPanel x:Name="PendingCipherCreateActions"
                                    Margin="0,4,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button x:Name="PendingCipherCreateCheckButton"
                                    HorizontalAlignment="Left"
                                    Command="{x:Bind ViewModel.SyncCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanCheckPendingCipherCreate, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    AutomationProperties.Name="再次同步检查待确认条目"
                                    AutomationProperties.AutomationId="PendingCipherCreateCheckButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    <TextBlock Text="再次同步检查" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PendingCipherCreateAbandonButton"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{x:Bind ViewModel.CanAbandonPendingCipherCreate, Mode=OneWay}"
                                    Click="OnAbandonPendingCipherCreateClick"
                                    AutomationProperties.Name="放弃待确认状态"
                                    AutomationProperties.AutomationId="PendingCipherCreateAbandonButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"
                                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="放弃待确认状态…"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 列表 -->
        <Grid x:Name="VaultListPane" Grid.Row="1" Grid.Column="0" Padding="16,20,12,12" RowSpacing="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderThickness="0,0,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="VaultSearchBox" PlaceholderText="搜索名称、网站或用户名"
                                GotFocus="OnSearchGotFocus"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                                QueryIcon="Find"
                                AutomationProperties.Name="搜索保险库"
                                AutomationProperties.AutomationId="VaultSearchBox">
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnSearchAcceleratorInvoked" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
                <Button Grid.Column="1" Command="{x:Bind ViewModel.SyncCommand}"
                        IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}"
                        AutomationProperties.Name="同步保险库"
                        AutomationProperties.AutomationId="VaultSyncButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                        <TextBlock Text="同步" />
                    </StackPanel>
                </Button>
            </Grid>

            <CommandBar Grid.Row="0" DefaultLabelPosition="Right" HorizontalAlignment="Stretch" Margin="0,0,0,16"
                        Background="Transparent">
                <CommandBar.Content>
                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{x:Bind ViewModel.WorkspaceTitle, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.VisibleItemCountText, Mode=OneWay}"
                                   Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                    </StackPanel>
                </CommandBar.Content>
                <AppBarButton x:Name="AddCipherButton" Icon="Add" Label="新增"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanBeginCipherCreate, ViewModel.CanStartVaultOperation), Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="登录" Click="OnAddLoginClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="支付卡" Click="OnAddCardClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8C7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="身份" Click="OnAddIdentityClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="笔记" Click="OnAddNoteClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="SSH 密钥" Click="OnAddSshClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="银行账户"
                                            Click="OnAddBankAccountClick"
                                            Visibility="{x:Bind ViewModel.CanCreateNewCipherTypes, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE825;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="驾驶证"
                                            Click="OnAddDriversLicenseClick"
                                            Visibility="{x:Bind ViewModel.CanCreateNewCipherTypes, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="护照"
                                            Click="OnAddPassportClick"
                                            Visibility="{x:Bind ViewModel.CanCreateNewCipherTypes, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8A5;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="AddFolderMenuItem"
                                            Text="文件夹"
                                            Click="OnAddFolderClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="EnterSelectionButton" Label="选择"
                              Command="{x:Bind ViewModel.ToggleSelectionModeCommand}"
                              Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE762;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
            <StackPanel Grid.Row="3" Spacing="6" Margin="0,0,0,12"
                        Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Stretch" Background="Transparent">
                <AppBarButton Icon="SelectAll" Label="全选"
                              Command="{x:Bind ViewModel.SelectAllCommand}"
                              Click="OnSelectAllClick"
                              IsEnabled="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay}" />
                <AppBarButton x:Name="MoveSelectedButton" Icon="MoveToFolder" Label="移动"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanMoveSelection, ViewModel.CanStartVaultOperation), Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <MenuFlyout x:Name="MoveFolderFlyout" Opening="OnMoveSelectedFlyoutOpening" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Name="TransferSelectedToOrganizationButton"
                              Label="转移到组织"
                              Click="OnTransferSelectedToOrganizationClick"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanTransferSelectionToOrganization, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8AB;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="AddSelectedToCollectionsButton"
                              Label="加入集合"
                              Click="OnAddSelectedToCollectionsClick"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanManageSelectionCollections, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8B7;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="RemoveSelectedFromCollectionsButton"
                              Label="移出集合"
                              Click="OnRemoveSelectedFromCollectionsClick"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanManageSelectionCollections, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsSelectionMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="归档"
                              Command="{x:Bind ViewModel.ArchiveSelectedCommand}"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanArchiveSelection, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.ShowArchiveSelectionAction, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE7B8;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Icon="Undo" Label="取消归档"
                              Command="{x:Bind ViewModel.UnarchiveSelectedCommand}"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanUnarchiveSelection, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.ShowUnarchiveSelectionAction, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <AppBarButton Icon="Delete" Label="移到回收站"
                              Command="{x:Bind ViewModel.SoftDeleteSelectedCommand}"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanDeleteSelection, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsTrashFilterSelected, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                <AppBarButton Icon="Undo" Label="恢复"
                              Command="{x:Bind ViewModel.RestoreSelectedCommand}"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanRestoreSelection, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsTrashFilterSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <AppBarButton x:Name="PermanentDeleteButton" Icon="Delete" Label="永久删除"
                              Click="OnPermanentDeleteSelectedClick"
                              IsEnabled="{x:Bind local:VaultPage.CanBatchOperate(ViewModel.CanDeleteSelection, ViewModel.CanStartVaultOperation), Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsTrashFilterSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            </CommandBar>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" />
                    <TextBlock VerticalAlignment="Center" Text="项已选" />
                    <Button Content="完成" Command="{x:Bind ViewModel.ToggleSelectionModeCommand}" />
                </StackPanel>
                <InfoBar x:Name="VaultSelectionPlacementErrorInfoBar"
                         Severity="Warning"
                         IsClosable="False"
                         IsOpen="{x:Bind ViewModel.HasSelectionPlacementError, Mode=OneWay}"
                         Message="{x:Bind ViewModel.SelectionPlacementError, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12"
                        Visibility="{x:Bind ViewModel.IsFolderFilterSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Button x:Name="RenameFolderButton" Content="重命名文件夹" Click="OnRenameFolderClick"
                        IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}" />
                <Button x:Name="DeleteFolderButton" Content="删除文件夹" Click="OnDeleteFolderClick"
                        IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}" />
            </StackPanel>

            <!-- 筛选栏:分面 ToggleButton + 排序 + 保存视图 + 保存/清除 -->
            <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,12">
                <InfoBar x:Name="VaultOfflineInfoBar"
                         Severity="Warning"
                         IsOpen="{x:Bind ViewModel.ShowDataStaleInfo, Mode=OneWay}"
                         IsClosable="False"
                         Title="离线"
                         Message="显示的是上次同步的数据,可能已过期。" />
                <InfoBar x:Name="VaultCommittedWarningInfoBar"
                         Severity="Warning"
                         IsOpen="{x:Bind ViewModel.ShowOperationWarningInfo, Mode=OneWay}"
                         IsClosable="False"
                         Title="{x:Bind ViewModel.OperationWarningTitle, Mode=OneWay}"
                         Message="{x:Bind ViewModel.OperationWarning, Mode=OneWay}"
                         AutomationProperties.LiveSetting="Polite" />
                <InfoBar x:Name="VaultSkippedInfoBar"
                         Severity="Informational"
                         IsClosable="True"
                         IsOpen="{x:Bind ViewModel.HasSkippedCiphers, Mode=OneWay}"
                         Message="{x:Bind ViewModel.SkippedCipherMessage, Mode=OneWay}" />
                <InfoBar x:Name="VaultOrganizationUnavailableInfoBar"
                         Severity="Warning"
                         IsClosable="False"
                         IsOpen="{x:Bind ViewModel.HasUnsupportedOrganizationCiphers, Mode=OneWay}"
                         Title="共享保险库不可用"
                         Message="{x:Bind ViewModel.UnsupportedOrganizationCipherMessage, Mode=OneWay}" />
                <ComboBox x:Name="VaultTypeFilterBox" HorizontalAlignment="Stretch"
                          SelectedIndex="{x:Bind ViewModel.SelectedTypeIndex, Mode=TwoWay}"
                          AutomationProperties.Name="条目类型">
                    <ComboBoxItem Content="所有类型" />
                    <ComboBoxItem Content="登录" />
                    <ComboBoxItem Content="支付卡" />
                    <ComboBoxItem Content="身份" />
                    <ComboBoxItem Content="笔记" />
                    <ComboBoxItem Content="SSH 密钥" />
                    <ComboBoxItem Content="银行账户" />
                    <ComboBoxItem Content="驾驶证" />
                    <ComboBoxItem Content="护照" />
                </ComboBox>
                <!-- Refinements retain their values within the current vault scope. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="SortComboBox"
                              MinWidth="130"
                              SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"
                              AutomationProperties.Name="排序方式"
                              AutomationProperties.AutomationId="VaultSortComboBox">
                        <ComboBoxItem Content="名称 A→Z" />
                        <ComboBoxItem Content="名称 Z→A" />
                        <ComboBoxItem Content="最近修改" />
                        <ComboBoxItem Content="创建时间" />
                    </ComboBox>

                    <DropDownButton x:Name="FacetFilterButton"
                                    AutomationProperties.Name="筛选"
                                    AutomationProperties.AutomationId="VaultFacetFilterButton">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71C;" FontSize="14" />
                            <TextBlock Text="筛选" />
                            <InfoBadge Value="{x:Bind ViewModel.ActiveFacetCount, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.HasActiveFacets, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout>
                                <StackPanel Spacing="6" MinWidth="200">
                                    <ToggleButton Content="含TOTP"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  IsChecked="{x:Bind ViewModel.FacetTotp, Mode=TwoWay}"
                                                  AutomationProperties.Name="按含 TOTP 筛选"
                                                  AutomationProperties.AutomationId="VaultFacetTotpToggle" />
                                    <ToggleButton Content="含附件"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  IsChecked="{x:Bind ViewModel.FacetAttachment, Mode=TwoWay}"
                                                  AutomationProperties.Name="按含附件筛选"
                                                  AutomationProperties.AutomationId="VaultFacetAttachmentToggle" />
                                    <ToggleButton Content="含网址"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  IsChecked="{x:Bind ViewModel.FacetUri, Mode=TwoWay}"
                                                  AutomationProperties.Name="按含网址筛选"
                                                  AutomationProperties.AutomationId="VaultFacetUriToggle" />
                                    <ToggleButton Content="仅收藏"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  IsChecked="{x:Bind ViewModel.FacetFavoriteOnly, Mode=TwoWay}"
                                                  AutomationProperties.Name="仅显示收藏"
                                                  AutomationProperties.AutomationId="VaultFacetFavoriteOnlyToggle" />
                                    <Border Height="1" Margin="0,2"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Button Content="清除全部筛选"
                                            HorizontalAlignment="Stretch"
                                            Click="OnClearFiltersClick"
                                            Visibility="{x:Bind ViewModel.HasActiveRefinement, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                            AutomationProperties.Name="清除筛选"
                                            AutomationProperties.AutomationId="VaultClearFiltersButton" />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <DropDownButton x:Name="SavedViewsButton"
                                    AutomationProperties.Name="视图"
                                    AutomationProperties.AutomationId="VaultSavedViewsButton">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A9;" FontSize="14" />
                            <TextBlock Text="视图" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="SavedViewsFlyout" Opening="OnSavedViewsFlyoutOpening">
                                <MenuFlyoutSeparator x:Name="SavedViewsStaticSeparator" />
                                <MenuFlyoutItem x:Name="SaveCurrentViewMenuItem"
                                                Text="保存当前视图…"
                                                Click="OnSaveCurrentViewClick"
                                                AutomationProperties.Name="保存当前视图"
                                                AutomationProperties.AutomationId="VaultSaveCurrentViewButton">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74E;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>

                <InfoBar Severity="Informational" IsClosable="False" IsOpen="True"
                         Message="回收站中的项目不计入密码库，可恢复或永久删除。"
                         Visibility="{x:Bind ViewModel.IsTrashFilterSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <Grid Visibility="{x:Bind ViewModel.IsTrashFilterSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                      ColumnSpacing="8" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.TrashHeader, Mode=OneWay}" VerticalAlignment="Center"
                               Style="{StaticResource SectionHeaderTextBlockStyle}" />
                    <Button Grid.Column="1" Content="清空回收站" Click="OnEmptyRecycleBinClick"
                            IsEnabled="{x:Bind ViewModel.CanStartVaultOperation, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CanEmptyRecycleBin, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="清空回收站"
                            AutomationProperties.AutomationId="VaultEmptyRecycleBinButton" />
                </Grid>
            </StackPanel>

            <ListView Grid.Row="6"
                      x:Name="CipherList"
                      ItemsSource="{x:Bind ViewModel.FilteredItems, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                      SingleSelectionFollowsFocus="False"
                      SelectionChanged="OnCipherSelectionChanged"
                      SelectionMode="{x:Bind local:VaultPage.SelectionModeFromBool(ViewModel.IsSelectionMode), Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:CipherListItem">
                        <Grid x:Name="RowRoot"
                              ColumnSpacing="10"
                              Padding="4,10"
                              PointerEntered="OnRowPointerEntered"
                              PointerExited="OnRowPointerExited"
                              GotFocus="OnRowGotFocus"
                              LostFocus="OnRowLostFocus"
                              Unloaded="OnRowUnloaded">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36"
                                    Style="{StaticResource IconBadgeBorderStyle}">
                                <controls:FaviconView Domain="{Binding IconDomain}"
                                                      FallbackGlyph="{Binding Glyph}"
                                                      IconSize="16" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Subtitle}"
                                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2"
                                      Glyph="&#xE735;"
                                      FontSize="14"
                                      Margin="0,0,4,0"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                      Visibility="{x:Bind local:VaultPage.VisibleIfTrue(Favorite)}" />
                            <StackPanel x:Name="RowActions"
                                        Grid.Column="3"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        Opacity="0"
                                        IsHitTestVisible="False"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="复制"
                                        AutomationProperties.AutomationId="VaultRowCopyButton"
                                        ToolTipService.ToolTip="复制主值"
                                        IsEnabled="{Binding CanViewPassword}"
                                        Click="OnRowCopyPrimaryClick">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}"
                                        AutomationProperties.Name="更多"
                                        AutomationProperties.AutomationId="VaultRowMoreButton"
                                        ToolTipService.ToolTip="更多操作">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="编辑"
                                                            IsEnabled="{Binding CanModify}"
                                                            Click="OnRowEditClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfFalse(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="创建副本"
                                                            IsEnabled="{Binding CanClone}"
                                                            Click="OnRowCloneClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfFalse(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B0;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="收藏 / 取消收藏"
                                                            IsEnabled="{Binding CanFavorite}"
                                                            Click="OnRowFavoriteClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfFalse(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE734;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="归档"
                                                            IsEnabled="{Binding ShowArchiveAction}"
                                                            Click="OnRowArchiveClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfTrue(ShowArchiveAction)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="取消归档"
                                                            IsEnabled="{Binding ShowUnarchiveAction}"
                                                            Click="OnRowUnarchiveClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfTrue(ShowUnarchiveAction)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="移到回收站"
                                                            IsEnabled="{Binding CanDelete}"
                                                            Click="OnRowSoftDeleteClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfFalse(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="恢复"
                                                            IsEnabled="{Binding CanRestore}"
                                                            Click="OnRowRestoreClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfTrue(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="永久删除"
                                                            IsEnabled="{Binding CanDelete}"
                                                            Click="OnRowPermanentDeleteClick"
                                                            Visibility="{x:Bind local:VaultPage.VisibleIfTrue(IsDeleted)}">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <InfoBar x:Name="VaultErrorInfoBar"
                     Grid.Row="5"
                     Margin="0,0,0,12"
                     VerticalAlignment="Top"
                     IsClosable="True"
                     Severity="Error"
                     IsOpen="{x:Bind ViewModel.HasOperationError, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.HasOperationError, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                     Message="{x:Bind ViewModel.OperationError, Mode=OneWay}" />

            <StackPanel x:Name="VaultEmptyPanel"
                        Grid.Row="6"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="{StaticResource SpacingMedium}"
                        Visibility="{x:Bind ViewModel.HasNoItems, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <FontIcon Glyph="&#xE8A1;" FontSize="44"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="保险库为空"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="点击上方&#x201C;新增&#x201D;创建你的第一个条目。"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="VaultNoResultsPanel"
                        Grid.Row="6"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="{StaticResource SpacingMedium}"
                        Visibility="{x:Bind ViewModel.NoResults, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <FontIcon Glyph="&#xE721;" FontSize="44"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="没有匹配项"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="没有符合当前搜索或筛选的条目。"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="6" Text="回收站为空" Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                       Margin="0,8" HorizontalAlignment="Center"
                       Visibility="{x:Bind ViewModel.IsTrashEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Row="6" Text="归档为空" Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                       Margin="0,8" HorizontalAlignment="Center"
                       Visibility="{x:Bind ViewModel.IsArchiveEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- 详情 -->
        <Grid x:Name="VaultDetailPane" Grid.Row="1" Grid.Column="1"
              Background="{ThemeResource LayerFillColorAltBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
                <Button x:Name="VaultNarrowBackButton"
                        Grid.Row="0" Margin="24,12,24,0"
                        HorizontalAlignment="Left"
                        IsEnabled="{x:Bind ViewModel.CanCancelEditor, Mode=OneWay}"
                        Click="OnVaultNarrowBackClick"
                        AutomationProperties.AutomationId="VaultNarrowBackButton"
                        AutomationProperties.Name="返回列表"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" /><TextBlock Text="返回列表" />
                    </StackPanel>
                </Button>
        <ScrollViewer x:Name="VaultDetailScroll" Grid.Row="1" Padding="24,20,24,24">
            <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Stretch">
                <ContentControl x:Name="CipherEditorPanel"
                                IsEnabled="{x:Bind ViewModel.CanEditEditorDraft, Mode=OneWay}"
                                HorizontalContentAlignment="Stretch"
                                Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}"
                                       Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <ComboBox x:Name="CipherEditorTypeBox"
                                      Header="类型"
                                      HorizontalAlignment="Stretch"
                                      IsEnabled="{x:Bind ViewModel.CanChangeEditorType, Mode=OneWay}"
                                      SelectionChanged="OnCipherEditorTypeChanged">
                                <ComboBoxItem Content="登录" Tag="Login" />
                                <ComboBoxItem Content="支付卡" Tag="Card" />
                                <ComboBoxItem Content="身份" Tag="Identity" />
                                <ComboBoxItem Content="笔记" Tag="Note" />
                                <ComboBoxItem Content="SSH 密钥" Tag="Ssh" />
                                <ComboBoxItem Content="银行账户" Tag="BankAccount"
                                              Visibility="{x:Bind ViewModel.CanCreateNewCipherTypes, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <ComboBoxItem Content="驾驶证" Tag="DriversLicense"
                                              Visibility="{x:Bind ViewModel.CanCreateNewCipherTypes, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <ComboBoxItem Content="护照" Tag="Passport"
                                              Visibility="{x:Bind ViewModel.CanCreateNewCipherTypes, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            </ComboBox>
                        </StackPanel>

                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.EditorError, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.EditorError, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}" />
                    <TextBlock Text="{x:Bind ViewModel.OperationError, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.OperationError, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}" />

                    <controls:DetailCard Title="项目详细信息">
                        <controls:DetailCard.CardContent>
                            <StackPanel Spacing="10">
                                <TextBox x:Name="CipherEditorNameBox" Header="项目名称（必填）"
                                         HorizontalAlignment="Stretch"
                                         Text="{x:Bind ViewModel.EditorDisplayDraft.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox x:Name="CipherEditorDestinationBox"
                                          Header="保存到"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.EditorDestinations, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.EditorSelectedDestination, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.CanChooseEditorDestination, Mode=OneWay}"
                                          PlaceholderText="没有可写入的位置">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:CipherDestinationOption">
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Spacing="6"
                                            Visibility="{x:Bind ViewModel.ShowEditorCollectionOptions, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="集合" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.EditorCollectionOptions, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:CipherCollectionOption">
                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanSelect}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <ComboBox x:Name="CipherEditorFolderBox"
                                          Header="文件夹"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{x:Bind ViewModel.FolderFilters, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.EditorSelectedFolder, Mode=TwoWay}"
                                          PlaceholderText="-- 选择 --">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:FilterNode">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <CheckBox IsChecked="{x:Bind ViewModel.EditorDisplayDraft.Favorite, Mode=TwoWay}">
                                    <TextBlock Text="收藏" />
                                </CheckBox>
                            </StackPanel>
                        </controls:DetailCard.CardContent>
                    </controls:DetailCard>

                    <controls:DetailCard Title="登录凭据"
                                         Visibility="{x:Bind ViewModel.EditorDisplayDraft.IsLogin, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <controls:DetailCard.CardContent>
                            <StackPanel Spacing="10">
                                <TextBox Header="用户名"
                                         HorizontalAlignment="Stretch"
                                         Text="{x:Bind ViewModel.EditorDisplayDraft.Login.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <PasswordBox Header="密码"
                                             HorizontalAlignment="Stretch"
                                             Password="{x:Bind ViewModel.EditorDisplayDraft.Login.Password, Mode=TwoWay}" />
                                <PasswordBox x:Name="TotpSecretEditor"
                                             Header="验证器密钥"
                                             HorizontalAlignment="Stretch"
                                             Password="{x:Bind ViewModel.EditorDisplayDraft.Login.Totp, Mode=TwoWay}" />
                                <TextBlock Text="用于生成一次性验证码的设置密钥。"
                                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                <Expander Header="网站" IsExpanded="True"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="12">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.EditorDisplayDraft.Login.Uris, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:LoginUriEditorDraft">
                                                    <StackPanel Spacing="8" Margin="0,0,0,16">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Header="网站地址" HorizontalAlignment="Stretch"
                                                                     Text="{Binding Uri, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <Button Grid.Column="1" VerticalAlignment="Bottom"
                                                                    AutomationProperties.Name="删除网站地址"
                                                                    ToolTipService.ToolTip="删除网站地址"
                                                                    Click="OnRemoveWebsiteClick">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                            </Button>
                                                        </Grid>
                                                        <Expander Header="{Binding MatchSummary, Mode=OneWay}"
                                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                            <ComboBox Header="匹配规则" HorizontalAlignment="Stretch"
                                                                      SelectedIndex="{Binding MatchIndex, Mode=TwoWay}">
                                                                <ComboBoxItem Content="默认" />
                                                                <ComboBoxItem Content="基础域名" />
                                                                <ComboBoxItem Content="主机" />
                                                                <ComboBoxItem Content="开头匹配" />
                                                                <ComboBoxItem Content="完全匹配" />
                                                                <ComboBoxItem Content="正则表达式" />
                                                                <ComboBoxItem Content="不匹配" />
                                                            </ComboBox>
