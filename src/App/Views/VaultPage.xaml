                                        <TextBox Header="公司"
                                                 HorizontalAlignment="Stretch"
                                                 Text="{x:Bind ViewModel.EditorDisplayDraft.Identity.Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
