                                    <Border Width="32" Height="32" CornerRadius="6" VerticalAlignment="Center"
                                        Background="{ThemeResource WardenTileBrush}">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16"
                                            Foreground="{ThemeResource WardenPrimaryTextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="14" LineHeight="20"
                                            Foreground="{ThemeResource WardenPrimaryTextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Description}" FontSize="12" LineHeight="16"
                                            Foreground="{ThemeResource WardenSecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <HyperlinkButton x:Uid="LC4F5A65AF981378B" x:Name="TwoFactorPickerBackButton" Content="返回"
                    AutomationProperties.AutomationId="TwoFactorPickerBackButton"
                    HorizontalAlignment="Center" MinHeight="32" Padding="10,0" Margin="0,16,0,0"
                    Click="OnCloseTwoFactorPickerClick" />
            </StackPanel>
            <StackPanel x:Name="HelloEnrollmentPanel" MaxWidth="360" HorizontalAlignment="Stretch"
                VerticalAlignment="Center" Visibility="Collapsed">
                <Border Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Center"
                    Background="{ThemeResource WardenTileBrush}">
                    <FontIcon Glyph="&#xE77B;" FontSize="24" Foreground="{ThemeResource WardenPrimaryTextBrush}" />
                </Border>
                <TextBlock x:Uid="L31F7821477107B7C" Text="下次用 Windows Hello 解锁？" Margin="0,16,0,0"
                    FontFamily="{StaticResource WardenDisplayFontFamily}" FontSize="20" LineHeight="28"
                    FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Uid="L283CBE27EE9B321D" Text="用面部、指纹或 PIN 代替主密码，主密码仍然可以用。" Margin="0,4,0,0"
                    Foreground="{ThemeResource WardenSecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <InfoBar x:Name="HelloEnrollmentStatus" IsOpen="False" IsClosable="False" Margin="0,20,0,0"
                    Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="EnableHelloEnrollmentButton" Margin="0,28,0,0" MinHeight="32"
                    Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" IsEnabled="False"
                    Click="OnEnableHelloEnrollmentClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE77B;" FontSize="16" />
                        <TextBlock x:Uid="LC2458D6C0F54894E" x:Name="HelloEnrollmentButtonText" Text="开启 Windows Hello" />
                    </StackPanel>
                </Button>
                <Button x:Uid="LA1AE5669A2099D84" x:Name="SkipHelloEnrollmentButton" Content="以后再说" Margin="0,8,0,0"
                    MinHeight="32" HorizontalAlignment="Stretch" Click="OnSkipHelloEnrollmentClick" />
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
