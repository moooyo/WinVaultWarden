<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.LoginPage"
    Unloaded="OnUnloaded"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:App.ViewModels"
    xmlns:services="using:App.Services"
    xmlns:converters="using:App.Converters"
    xmlns:views="using:App.Views">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter"
            Invoked="OnSubmitAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="OnAuthBackAccelerator" />
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <views:LoginStatusKindToInfoBarSeverityConverter x:Key="LoginStatusKindToInfoBarSeverityConverter" />
        <x:Double x:Key="TextControlThemeMinHeight">32</x:Double>
        <Thickness x:Key="TextControlHeaderMargin">0,0,0,6</Thickness>
        <Style x:Key="AuthServerSegmentStyle" TargetType="ListBoxItem">
            <Setter Property="Width" Value="120" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="SegmentRoot" Background="Transparent" CornerRadius="4">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters><Setter Target="SegmentRoot.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" /></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="SegmentRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="SegmentContent.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SegmentRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="SegmentContent.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters><Setter Target="SegmentRoot.Opacity" Value="0.45" /></VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="SegmentContent" Content="{TemplateBinding Content}"
                                FontSize="13" Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid x:Name="LoginSurface"
        Padding="32"
        Background="{ThemeResource WardenLayerBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideForm">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="400" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowForm">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LoginSurface.Padding" Value="16,32,16,32" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer x:Name="LoginScrollViewer" VerticalScrollBarVisibility="Auto"
            VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled">
            <Grid HorizontalAlignment="Stretch">
            <StackPanel x:Name="LoginForm"
                MaxWidth="360"
                MinWidth="0"
                Spacing="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Margin="0,0,0,0">
                <Border x:Name="LoginAppIcon"
                    Width="48" Height="48" CornerRadius="10"
                    HorizontalAlignment="Center">
                    <Border.Background><ImageBrush ImageSource="ms-appx:///Assets/Square150x150Logo.png" Stretch="UniformToFill" /></Border.Background>
                </Border>
                <Border x:Name="LoginStepIcon"
                    Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Center"
                    Background="{ThemeResource WardenTileBrush}" Visibility="Collapsed">
                    <FontIcon x:Name="LoginStepGlyph" Glyph="&#xEA18;" FontSize="24"
                        Foreground="{ThemeResource WardenPrimaryTextBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="LoginAvatar"
                    Width="64" Height="64" CornerRadius="32"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource WardenTileBrush}"
                    Visibility="Collapsed">
                    <TextBlock Text="{x:Bind ViewModel.AccountInitial, Mode=OneWay}"
                        FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="LoginTitle" Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}"
                    Margin="0,16,0,0"
                    FontFamily="Segoe UI Variable Display" FontSize="20" LineHeight="28" FontWeight="SemiBold"
                    AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap"
                    HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock x:Name="LoginSubtitle" Text="{x:Bind ViewModel.FormSubtitle, Mode=OneWay}"
                    Margin="0,4,0,0" FontSize="13" LineHeight="20"
                    Foreground="{ThemeResource WardenSecondaryTextBrush}"
                    HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <InfoBar x:Name="LoginStatusInfoBar"
                    Margin="0,28,0,0"
                    IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                    IsClosable="False"
                    AutomationProperties.LiveSetting="Polite"
                    Severity="{x:Bind ViewModel.StatusKind, Mode=OneWay, Converter={StaticResource LoginStatusKindToInfoBarSeverityConverter}}"
                    Message="{x:Bind ViewModel.Status, Mode=OneWay}" />
                <StackPanel x:Name="LoginAccountStage"
                    Margin="0,28,0,0"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsAccountStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel x:Name="SavedAccountsPanel"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.ShowSavedAccounts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="已保存账户"
                            Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SavedAccounts, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:SavedAccountOption">
                                    <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="10,8"
                                        Click="OnSavedAccountClick">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind Initial}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Email}"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ServerUrl}"
                                                    Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="14"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="服务器" />
                        <ListBox x:Name="ServerOptionBox"
                            AutomationProperties.Name="服务器"
                            HorizontalAlignment="Stretch" Height="32" Padding="0"
                            BorderThickness="0" Background="Transparent"
                            ItemContainerStyle="{StaticResource AuthServerSegmentStyle}"
                            SelectedIndex="{x:Bind ViewModel.SelectedServerOptionIndex, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanEditServer, Mode=OneWay}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBoxItem Content="bitwarden.com" />
                            <ListBoxItem Content="bitwarden.eu" />
                            <ListBoxItem Content="自托管" />
                        </ListBox>
                    </StackPanel>
                    <TextBox x:Name="ServerUrlTextBox"
                        Header="服务器地址"
                        FontFamily="{StaticResource MonospaceFontFamily}"
                        LostFocus="OnAccountIdentityLostFocus"
                        PlaceholderText="https://vault.example.com"
                        Text="{x:Bind ViewModel.ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{x:Bind ViewModel.CanEditServer, Mode=OneWay}"
                        MinHeight="32"
                        Visibility="{x:Bind ViewModel.ShowCustomServerUrl, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock x:Name="ServerErrorText" Margin="0,-10,0,0" FontSize="12" LineHeight="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                    <TextBlock x:Name="ServerUrlHelper" Margin="0,-10,0,0"
                        Text="Vaultwarden 或自建的 Bitwarden 服务器"
                        Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                        Visibility="{x:Bind ViewModel.ShowCustomServerUrl, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBox x:Name="EmailTextBox"
                        Header="邮箱"
                        PlaceholderText="name@example.com"
                        Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{x:Bind ViewModel.CanEditServer, Mode=OneWay}"
                        MinHeight="32"
                        InputScope="EmailSmtpAddress" LostFocus="OnAccountIdentityLostFocus" />
                    <TextBlock x:Name="EmailErrorText" Margin="0,-10,0,0" FontSize="12" LineHeight="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                    <CheckBox x:Name="RememberEmailBox" Content="记住邮箱" IsChecked="True"
                        Checked="OnRememberEmailChanged" Unchecked="OnRememberEmailChanged" />
                </StackPanel>
                <StackPanel x:Name="AccountDeletionRecoveryStage"
                    Margin="0,28,0,0"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsAccountDeletionRecoveryStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <InfoBar x:Name="AccountDeletionRecoveryInfoBar"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Title="{x:Bind ViewModel.AccountDeletionRecoveryTitle, Mode=OneWay}"
                        Message="{x:Bind ViewModel.AccountDeletionRecoveryMessage, Mode=OneWay}" />
                    <Button x:Name="RetryConfirmedAccountDeletionCleanupButton"
                        AutomationProperties.AutomationId="RetryConfirmedAccountDeletionCleanupButton"
                        Content="重试本地清理"
                        Command="{x:Bind ViewModel.RetryConfirmedAccountDeletionCleanupCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanRunAccountDeletionRecoveryAction, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowRetryConfirmedAccountDeletionCleanup, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        MinHeight="32"
                        HorizontalAlignment="Stretch" />
                    <Button x:Name="ClearPendingAccountDeletionLocalDataButton"
                        AutomationProperties.AutomationId="ClearPendingAccountDeletionLocalDataButton"
                        Content="仅清除此设备"
                        Click="OnClearPendingAccountDeletionClick"
                        IsEnabled="{x:Bind ViewModel.CanRunAccountDeletionRecoveryAction, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowClearPendingAccountDeletion, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        MinHeight="32"
                        HorizontalAlignment="Stretch" />
                    <Button x:Name="ContinueFromAccountDeletionRecoveryButton"
                        AutomationProperties.AutomationId="ContinueFromAccountDeletionRecoveryButton"
                        Content="{x:Bind ViewModel.AccountDeletionRecoveryContinueText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ContinueFromAccountDeletionRecoveryCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanContinueFromAccountDeletionRecovery, Mode=OneWay}"
                        MinHeight="32"
                        HorizontalAlignment="Stretch" />
                    <Button x:Name="RequestFullLocalResetButton"
                        AutomationProperties.AutomationId="RequestFullLocalResetButton"
                        Content="清除全部本机数据并退出"
                        Click="OnRequestFullLocalResetClick"
                        IsEnabled="{x:Bind ViewModel.CanRequestFullLocalReset, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowFullLocalResetAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        MinHeight="32"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel x:Name="LoginPasswordStage"
                    Margin="0,28,0,0"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsPasswordStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel x:Name="LoginWithDeviceQuarantinePanel"
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.ShowLoginWithDeviceQuarantineNotice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <InfoBar x:Name="LoginWithDeviceQuarantineInfoBar"
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Warning"
                            Title="{x:Bind ViewModel.LoginWithDeviceQuarantineTitle, Mode=OneWay}"
                            Message="{x:Bind ViewModel.LoginWithDeviceQuarantineMessage, Mode=OneWay}" />
                        <Button x:Name="ClearLoginWithDeviceQuarantineButton"
                            AutomationProperties.AutomationId="ClearLoginWithDeviceQuarantineButton"
                            Content="检查/撤销其他设备会话后清除此隔离"
                            Click="OnClearLoginWithDeviceQuarantineClick"
                            IsEnabled="{x:Bind ViewModel.CanClearLoginWithDeviceQuarantine, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowLoginWithDeviceQuarantineClearAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Stretch"
                            MinHeight="32" />
                    </StackPanel>
                    <Grid>
                    <PasswordBox x:Name="MasterPasswordBox"
                        Header="主密码"
                        MinHeight="32" Padding="10,4,36,4" PasswordRevealMode="Hidden"
                        Password="{x:Bind ViewModel.MasterPassword, Mode=TwoWay}" />
                        <ToggleButton x:Name="RevealMasterPasswordBoxButton" Tag="MasterPasswordBox"
                            AutomationProperties.Name="显示主密码" ToolTipService.ToolTip="显示主密码"
                            Checked="OnPasswordRevealChanged" Unchecked="OnPasswordRevealChanged"
                            Background="Transparent" BorderThickness="0" Width="32" Height="32"
                            MinWidth="32" MinHeight="32" Padding="0" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                            <FontIcon Glyph="&#xE890;" FontSize="16" />
                        </ToggleButton>
                    </Grid>
                    <TextBlock x:Name="MasterPasswordErrorText" Margin="0,-10,0,0" FontSize="12" LineHeight="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel x:Name="LoginWithDeviceStage"
                    Margin="0,28,0,0"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsLoginWithDeviceStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border BorderThickness="0,1" BorderBrush="{ThemeResource WardenLineBrush}"
                        Padding="0,14,0,16"
                        Visibility="{x:Bind ViewModel.HasLoginWithDeviceFingerprint, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="指纹短语" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                            <TextBox x:Name="LoginWithDeviceFingerprintBox"
                                AutomationProperties.AutomationId="LoginWithDeviceFingerprintBox"
                                AutomationProperties.Name="指纹短语"
                                Text="{x:Bind ViewModel.LoginWithDeviceFingerprint, Mode=OneWay}"
                                IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="0"
                                Background="Transparent" FontFamily="{StaticResource MonospaceFontFamily}"
                                FontSize="18" FontWeight="SemiBold"
                                Visibility="{x:Bind ViewModel.HasLoginWithDeviceFingerprint, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="在另一台设备上批准前，确认那里显示的是同样的短语。"
                                FontSize="12" LineHeight="18" Foreground="{ThemeResource WardenSecondaryTextBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE823;" FontSize="16" Foreground="{ThemeResource WardenSecondaryTextBrush}" />
                        <TextBlock x:Name="DeviceApprovalWaitingText" Text="正在等待批准"
                            Foreground="{ThemeResource WardenSecondaryTextBrush}"
                            AutomationProperties.LiveSetting="Off" />
                    </StackPanel>
                    <TextBlock x:Name="LoginWithDeviceExpiryText"
                        AutomationProperties.AutomationId="LoginWithDeviceExpiryText"
                        Text="{x:Bind ViewModel.LoginWithDeviceExpiryText, Mode=OneWay}"
                        Visibility="Collapsed" />
                    <Button x:Name="CancelLoginWithDeviceButton"
                        AutomationProperties.AutomationId="CancelLoginWithDeviceButton"
                        Content="改用主密码"
                        Command="{x:Bind ViewModel.CancelLoginWithDeviceCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowCancelLoginWithDevice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        MinHeight="32"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel x:Name="LoginDeviceVerificationStage"
                    Margin="0,28,0,0"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsDeviceVerificationStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBox x:Name="DeviceVerificationCodeTextBox"
                        AutomationProperties.AutomationId="DeviceVerificationCodeTextBox"
                        Header="设备验证码"
                        PlaceholderText="输入邮箱中的验证码"
                        Text="{x:Bind ViewModel.DeviceVerificationCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        InputScope="Number"
                        MaxLength="16"
                        MinHeight="32" />
                    <TextBlock x:Name="DeviceVerificationErrorText" Margin="0,-10,0,0" FontSize="12" LineHeight="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                    <HyperlinkButton x:Name="ResendNewDeviceCodeButton"
                        AutomationProperties.AutomationId="ResendNewDeviceCodeButton"
                        Content="重新发送验证码"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.ResendNewDeviceCodeCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanResendNewDeviceCode, Mode=OneWay}" />
                </StackPanel>
                <StackPanel x:Name="LoginPasswordChangeRequiredStage"
                    Margin="0,28,0,0"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsPasswordChangeRequiredStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <InfoBar IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Title="需要更新主密码"
                        Message="{x:Bind ViewModel.RequiredPasswordPolicySummary, Mode=OneWay}" />
                    <PasswordBox x:Name="NewMasterPasswordBox"
                        AutomationProperties.AutomationId="NewMasterPasswordBox"
                        Header="新主密码"
                        Password="{x:Bind ViewModel.NewMasterPassword, Mode=TwoWay}"
                        MinHeight="32" />
                    <PasswordBox x:Name="ConfirmNewMasterPasswordBox"
                        AutomationProperties.AutomationId="ConfirmNewMasterPasswordBox"
                        Header="确认新主密码"
                        Password="{x:Bind ViewModel.ConfirmNewMasterPassword, Mode=TwoWay}"
                        MinHeight="32" />
                    <TextBox x:Name="MasterPasswordHintTextBox"
                        AutomationProperties.AutomationId="MasterPasswordHintTextBox"
                        Header="密码提示（可选）"
                        Text="{x:Bind ViewModel.MasterPasswordHint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="50"
                        MinHeight="32" />
                    <Button Content="切换账户"
                        Command="{x:Bind ViewModel.SwitchAccountCommand, Mode=OneWay}"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel x:Name="LoginTwoFactorStage"
                    Margin="0,28,0,0"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsTwoFactorStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <InfoBar x:Name="LoginWithDeviceTwoFactorExpiryInfoBar"
                        IsOpen="{x:Bind ViewModel.ShowLoginWithDeviceTwoFactorExpiry, Mode=OneWay}"
                        IsClosable="False"
                        Severity="Informational"
                        Title="设备登录请求有效期"
                        Message="{x:Bind ViewModel.LoginWithDeviceExpiryText, Mode=OneWay}" />
                    <TextBox x:Name="TwoFactorCodeTextBox"
                        Header="{x:Bind ViewModel.TwoFactorInputHeader, Mode=OneWay}"
                        Width="200" HorizontalAlignment="Left"
                        FontFamily="{StaticResource MonospaceFontFamily}"
                        PlaceholderText="{x:Bind ViewModel.TwoFactorInputPlaceholder, Mode=OneWay}"
                        Text="{x:Bind ViewModel.TwoFactorCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        MinHeight="32"
                        MaxLength="128"
                        Visibility="{x:Bind ViewModel.ShowTwoFactorCodeInput, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock x:Name="TwoFactorErrorText" Margin="0,-10,0,0" FontSize="12" LineHeight="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                    <InfoBar x:Name="RecoveryCodeWarningInfoBar"
                        IsOpen="{x:Bind ViewModel.ShowRecoveryCodeWarning, Mode=OneWay}"
                        IsClosable="False"
                        Severity="Warning"
                        Title="恢复代码会停用两步验证"
                        Message="验证成功后，账户当前配置的所有两步验证方式都会被移除。" />
                    <CheckBox Content="记住此设备"
                        IsChecked="{x:Bind ViewModel.RememberDevice, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.ShowRememberDevice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <HyperlinkButton x:Name="ResendEmailCodeButton"
                        Content="重发验证码"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.ResendEmailCodeCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowResendEmailCode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <HyperlinkButton x:Name="RecoveryCodeModeButton"
                        AutomationProperties.AutomationId="TwoFactorChangeMethodButton"
                        Content="换一种方式"
                        HorizontalAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.CanUsePrimaryAction, Mode=OneWay}"
                        Click="OnOpenTwoFactorPickerClick" />
                </StackPanel>
                <StackPanel x:Name="LoginTrustedDeviceApprovalStage"
                    Margin="0,28,0,0"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsTrustedDeviceApprovalStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ComboBox x:Name="DeviceApprovalMethodBox"
                        AutomationProperties.AutomationId="DeviceApprovalMethodBox"
                        Header="批准方式"
                        ItemsSource="{x:Bind ViewModel.ApprovalMethodOptions, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedApprovalMethodIndex, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.ShowApprovalMethodPicker, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrustedDeviceApprovalMethodOption">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox x:Name="DeviceApprovalFingerprintBox"
                        AutomationProperties.AutomationId="DeviceApprovalFingerprintBox"
                        Header="指纹短语"
                        Text="{x:Bind ViewModel.ApprovalFingerprint, Mode=OneWay}"
                        IsReadOnly="True"
                        TextWrapping="Wrap"
                        FontFamily="Consolas"
                        Visibility="{x:Bind ViewModel.HasApprovalFingerprint, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <CheckBox Content="批准后信任此设备"
                        IsChecked="{x:Bind ViewModel.TrustCurrentDeviceAfterApproval, Mode=TwoWay}" />
                    <Button Content="取消等待"
                        Command="{x:Bind ViewModel.CancelTrustedDeviceApprovalCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowCancelDeviceApproval, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        HorizontalAlignment="Stretch" />
                    <Button Content="切换账户"
                        Command="{x:Bind ViewModel.SwitchAccountCommand, Mode=OneWay}"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel x:Name="LoginTdeV2JitProvisioningStage"
                    Margin="0,28,0,0"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsTdeV2JitProvisioningStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="此企业账户尚未建立加密密钥。继续后将完成账户恢复注册。"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                    <CheckBox Content="同时信任此设备"
                        IsEnabled="{x:Bind ViewModel.CanChooseTrustCurrentDeviceAfterJit, Mode=OneWay}"
                        IsChecked="{x:Bind ViewModel.TrustCurrentDeviceAfterApproval, Mode=TwoWay}" />
                    <Button Content="切换账户"
                        Command="{x:Bind ViewModel.SwitchAccountCommand, Mode=OneWay}"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel x:Name="LoginUnlockStage"
                    Margin="0,28,0,0" Spacing="8"
                    Visibility="{x:Bind UnlockPanelVisibility(ViewModel.ShowUnlockPanel, ViewModel.ShowHelloUnlock), Mode=OneWay}">
                    <Grid Visibility="{x:Bind ViewModel.IsUnlockStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <PasswordBox x:Name="UnlockPasswordBox"
                        AutomationProperties.Name="主密码" PlaceholderText="主密码"
                        MinHeight="32" Padding="10,4,36,4" PasswordRevealMode="Hidden"
                        Password="{x:Bind ViewModel.MasterPassword, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IsUnlockStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ToggleButton x:Name="RevealUnlockPasswordBoxButton" Tag="UnlockPasswordBox"
                            AutomationProperties.Name="显示主密码" ToolTipService.ToolTip="显示主密码"
                            Checked="OnPasswordRevealChanged" Unchecked="OnPasswordRevealChanged"
                            Background="Transparent" BorderThickness="0" Width="32" Height="32"
                            MinWidth="32" MinHeight="32" Padding="0" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                            <FontIcon Glyph="&#xE890;" FontSize="16" />
                        </ToggleButton>
                    </Grid>
                    <TextBlock x:Name="UnlockPasswordErrorText" Margin="0,0,0,0" FontSize="12" LineHeight="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel x:Name="LoginPinUnlockStage"
                    Margin="0,28,0,0" Spacing="8"
                    Visibility="{x:Bind UnlockPanelVisibility(ViewModel.IsPinUnlockStage, ViewModel.ShowHelloUnlock), Mode=OneWay}">
                    <PasswordBox x:Name="PinBox"
                        AutomationProperties.AutomationId="PinBox"
                        AutomationProperties.Name="PIN" PlaceholderText="PIN"
                        MinHeight="32" InputScope="NumericPin"
                        FontFamily="{StaticResource MonospaceFontFamily}"
                        Password="{x:Bind ViewModel.Pin, Mode=TwoWay}" />
                    <TextBlock x:Name="PinErrorText" Margin="0,0,0,0" FontSize="12" LineHeight="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="HelloUnlockButton"
                    AutomationProperties.AutomationId="HelloUnlockButton"
                    Margin="0,28,0,0"
                    Style="{ThemeResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.UnlockWithHelloCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanUsePrimaryAction, Mode=OneWay}"
                    Visibility="Collapsed"
                    MinHeight="32" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE77B;" FontSize="16" />
                        <TextBlock Text="使用 Windows Hello 解锁" />
                    </StackPanel>
                </Button>
                <Button x:Name="PrimaryAuthButton"
                    Margin="0,16,0,0"
                    Click="OnLogin"
                    Style="{ThemeResource AccentButtonStyle}"
                    IsEnabled="{x:Bind PrimaryActionEnabled(ViewModel.CanUsePrimaryAction, ViewModel.MasterPassword, ViewModel.Pin), Mode=OneWay}"
                    Visibility="{x:Bind UnlockPanelVisibility(ViewModel.ShowPrimaryAction, ViewModel.ShowHelloUnlock), Mode=OneWay}"
                    MinHeight="32"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center">
                        <ProgressRing Width="16"
                            Height="16"
                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <StackPanel x:Name="PasswordAlternativeMethods"
                    Margin="0,16,0,0" Spacing="16"
                    Visibility="{x:Bind ViewModel.ShowLoginWithDeviceOption, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Height="1" Background="{ThemeResource WardenLineBrush}" />
                        <TextBlock Grid.Column="1" Text="或" FontSize="12" Foreground="{ThemeResource WardenTertiaryTextBrush}" />
                        <Border Grid.Column="2" Height="1" Background="{ThemeResource WardenLineBrush}" />
                    </Grid>
                    <Button x:Name="LoginWithDeviceButton"
                        AutomationProperties.AutomationId="LoginWithDeviceButton"
                        Content="使用设备登录"
                        Command="{x:Bind ViewModel.LoginWithDeviceCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanStartLoginWithDevice, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowLoginWithDeviceOption, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        MinHeight="32"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel x:Name="UnlockAlternatives" Orientation="Horizontal"
                    Margin="0,8,0,0" Spacing="8" HorizontalAlignment="Center" Visibility="Collapsed">
                    <HyperlinkButton x:Name="UseMasterPasswordButton"
                        AutomationProperties.AutomationId="UseMasterPasswordButton"
                        Content="{x:Bind ViewModel.AlternativeUnlockText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.UseMasterPasswordCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanUsePrimaryAction, Mode=OneWay}"
                        Click="OnUseMasterPasswordClick" Padding="10,0" MinHeight="32" />
                    <HyperlinkButton x:Name="UsePinUnlockButton"
                        Content="改用 PIN" Command="{x:Bind ViewModel.UsePinUnlockCommand, Mode=OneWay}"
                        Click="OnUsePinClick" Padding="10,0" MinHeight="32" />
                    <HyperlinkButton x:Name="PinHelloUnlockButton"
                        AutomationProperties.AutomationId="PinHelloUnlockButton"
                        Content="改用 Windows Hello"
                        Command="{x:Bind ViewModel.UnlockWithHelloCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanUsePrimaryAction, Mode=OneWay}"
                        Padding="10,0" MinHeight="32" />
                </StackPanel>
                <TextBlock x:Name="LockNote" Margin="0,28,0,0" FontSize="12" LineHeight="16"
                    Foreground="{ThemeResource WardenTertiaryTextBrush}"
                    TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
                <StackPanel x:Name="SwitchAccountLinks" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed">
                    <HyperlinkButton x:Name="SwitchAccountButton" Content="切换账户"
                        Command="{x:Bind ViewModel.SwitchAccountCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowUnlockPanel, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="10,0" MinHeight="32" />
                    <HyperlinkButton x:Name="PinSwitchAccountButton" Content="切换账户"
                        Command="{x:Bind ViewModel.SwitchAccountCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsPinUnlockStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="10,0" MinHeight="32" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"
                    Visibility="{x:Bind NavigationLinksVisibility(ViewModel.IsPasswordStage, ViewModel.CanGoBack), Mode=OneWay}">
                    <HyperlinkButton x:Name="PasswordHintButton" AutomationProperties.AutomationId="PasswordHintButton"
                        Content="{x:Bind ViewModel.PasswordHintButtonText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.RequestPasswordHintCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanRequestPasswordHint, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsPasswordStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="10,0" MinHeight="32" />
                <HyperlinkButton x:Name="BackButton" Content="{x:Bind BackActionText(ViewModel.IsPasswordStage), Mode=OneWay}" AutomationProperties.Name="返回"
                    Padding="10,0" MinHeight="32" HorizontalAlignment="Center"
                    Command="{x:Bind ViewModel.BackCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel x:Name="LoginAlternativeMethods"
                    Margin="0,16,0,0" Spacing="16"
                    Visibility="{x:Bind ViewModel.IsAccountStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Height="1" Background="{ThemeResource WardenLineBrush}" />
                        <TextBlock Grid.Column="1" Text="或" FontSize="12" Foreground="{ThemeResource WardenTertiaryTextBrush}" />
                        <Border Grid.Column="2" Height="1" Background="{ThemeResource WardenLineBrush}" />
                    </Grid>
                    <Button x:Name="SsoLoginButton"
                        AutomationProperties.AutomationId="SsoLoginButton"
                        Content="使用单点登录（SSO）"
                        Click="OnOpenSsoSignInClick"
                        IsEnabled="{x:Bind ViewModel.CanUseSso, Mode=OneWay}"
                        MinHeight="32"
                        HorizontalAlignment="Stretch" />
                    <HyperlinkButton x:Name="CancelSsoButton"
                        AutomationProperties.AutomationId="CancelSsoButton"
                        Content="取消 SSO 登录"
                        Command="{x:Bind ViewModel.CancelSsoCommand, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.ShowCancelSso, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="还没有账户？" VerticalAlignment="Center" Foreground="{ThemeResource WardenSecondaryTextBrush}" />
                    <HyperlinkButton x:Name="GoToRegisterButton"
                        AutomationProperties.AutomationId="GoToRegisterButton"
                        Content="创建账户"
                        Padding="4,0" MinHeight="32"
                        IsEnabled="{x:Bind ViewModel.CanEditServer, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        Click="OnGoToRegisterClick" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="DemoVaultButton"
                    Margin="0,10,0,0"
                    Content="使用演示保险库"
                    Command="{x:Bind ViewModel.UseDemoVaultCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.CanUseDemoVault, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    MinHeight="34"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel x:Name="SsoSignInPanel" MaxWidth="360" HorizontalAlignment="Stretch"
                VerticalAlignment="Center" Visibility="Collapsed">
                <Border Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Center" Background="{ThemeResource WardenTileBrush}">
                    <FontIcon Glyph="&#xE80F;" FontSize="24" />
                </Border>
                <TextBlock Text="单点登录" Margin="0,16,0,0" FontSize="20" LineHeight="28" FontWeight="SemiBold"
                    FontFamily="{StaticResource WardenDisplayFontFamily}" TextAlignment="Center" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock x:Name="SsoSubtitle" Margin="0,4,0,0" Text="输入组织标识符，会在浏览器中打开组织的登录页面"
                    Foreground="{ThemeResource WardenSecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <StackPanel x:Name="SsoOrganizationForm" Margin="0,28,0,0" Spacing="6">
                    <TextBlock Text="组织标识符" />
                    <TextBox x:Name="SsoOrganizationBox" AutomationProperties.Name="组织标识符" PlaceholderText="例如 moooyo-family"
                        MinHeight="32" Text="{x:Bind ViewModel.SsoOrganizationIdentifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock x:Name="SsoOrganizationError" FontSize="12" LineHeight="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="请输入组织标识符"
                        Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel x:Name="SsoWaitingRow" Orientation="Horizontal" Spacing="8" Margin="0,28,0,0"
                    HorizontalAlignment="Center" Visibility="Collapsed">
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsSsoPending, Mode=OneWay}" />
                    <TextBlock x:Name="SsoWaitingText" Text="正在等待浏览器中的登录…" Foreground="{ThemeResource WardenSecondaryTextBrush}" />
                </StackPanel>
                <InfoBar x:Name="SsoStatusInfoBar" IsOpen="False" IsClosable="False" Margin="0,16,0,0" Visibility="Collapsed" />
                <Button x:Name="SsoContinueButton" Content="继续" Click="OnSsoContinueClick"
                    Margin="0,16,0,0" MinHeight="32" HorizontalAlignment="Stretch" Style="{ThemeResource AccentButtonStyle}" />
                <Button x:Name="SsoReopenButton" Content="重新打开浏览器" Click="OnSsoReopenClick"
                    Margin="0,16,0,0" MinHeight="32" HorizontalAlignment="Stretch" Visibility="Collapsed" />
                <HyperlinkButton x:Name="SsoBackButton" Content="返回" Click="OnSsoBackClick"
                    Margin="0,8,0,0" MinHeight="32" HorizontalAlignment="Center" Padding="10,0" />
            </StackPanel>
            <StackPanel x:Name="TwoFactorPickerPanel" MaxWidth="360" HorizontalAlignment="Stretch"
                VerticalAlignment="Center" Visibility="Collapsed">
                <Border Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Center"
                    Background="{ThemeResource WardenTileBrush}">
                    <FontIcon Glyph="&#xEA18;" FontSize="24" Foreground="{ThemeResource WardenPrimaryTextBrush}" />
                </Border>
                <TextBlock Text="选择验证方式" Margin="0,16,0,0"
                    FontFamily="{StaticResource WardenDisplayFontFamily}" FontSize="20" LineHeight="28"
                    FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="用其中任意一种完成两步登录" Margin="0,4,0,0"
                    Foreground="{ThemeResource WardenSecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <ItemsControl x:Name="TwoFactorPickerItems" Margin="-12,28,-12,0"
                    AutomationProperties.AutomationId="TwoFactorMethodList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:TwoFactorPickerOption">
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                MinHeight="56" Padding="12,8" Margin="0,0,0,2" CornerRadius="6"
                                Background="Transparent" BorderThickness="0"
                                AutomationProperties.Name="{x:Bind DisplayName}"
                                AutomationProperties.HelpText="{x:Bind Description}"
                                Click="OnTwoFactorPickerOptionClick">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="6" VerticalAlignment="Center"
                                        Background="{ThemeResource WardenTileBrush}">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16"
                                            Foreground="{ThemeResource WardenPrimaryTextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="14" LineHeight="20"
                                            Foreground="{ThemeResource WardenPrimaryTextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Description}" FontSize="12" LineHeight="16"
                                            Foreground="{ThemeResource WardenSecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <HyperlinkButton x:Name="TwoFactorPickerBackButton" Content="返回"
                    AutomationProperties.AutomationId="TwoFactorPickerBackButton"
                    HorizontalAlignment="Center" MinHeight="32" Padding="10,0" Margin="0,16,0,0"
                    Click="OnCloseTwoFactorPickerClick" />
            </StackPanel>
            <StackPanel x:Name="HelloEnrollmentPanel" MaxWidth="360" HorizontalAlignment="Stretch"
                VerticalAlignment="Center" Visibility="Collapsed">
                <Border Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Center"
                    Background="{ThemeResource WardenTileBrush}">
                    <FontIcon Glyph="&#xE77B;" FontSize="24" Foreground="{ThemeResource WardenPrimaryTextBrush}" />
                </Border>
                <TextBlock Text="下次用 Windows Hello 解锁？" Margin="0,16,0,0"
                    FontFamily="{StaticResource WardenDisplayFontFamily}" FontSize="20" LineHeight="28"
                    FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="用面部、指纹或 PIN 代替主密码，主密码仍然可以用。" Margin="0,4,0,0"
                    Foreground="{ThemeResource WardenSecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                <InfoBar x:Name="HelloEnrollmentStatus" IsOpen="False" IsClosable="False" Margin="0,20,0,0"
                    Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="EnableHelloEnrollmentButton" Margin="0,28,0,0" MinHeight="32"
                    Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" IsEnabled="False"
                    Click="OnEnableHelloEnrollmentClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE77B;" FontSize="16" />
                        <TextBlock x:Name="HelloEnrollmentButtonText" Text="开启 Windows Hello" />
                    </StackPanel>
                </Button>
                <Button x:Name="SkipHelloEnrollmentButton" Content="以后再说" Margin="0,8,0,0"
                    MinHeight="32" HorizontalAlignment="Stretch" Click="OnSkipHelloEnrollmentClick" />
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
