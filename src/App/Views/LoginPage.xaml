<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.LoginPage"
    Unloaded="OnUnloaded"
    FontFamily="{StaticResource WardenTextFontFamily}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:App.ViewModels"
    xmlns:services="using:App.Services"
    xmlns:converters="using:App.Converters"
    xmlns:views="using:App.Views">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter"
            Invoked="OnSubmitAccelerator" />
        <KeyboardAccelerator Key="Escape" Invoked="OnAuthBackAccelerator" />
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <views:LoginStatusKindToInfoBarSeverityConverter x:Key="LoginStatusKindToInfoBarSeverityConverter" />
        <x:Double x:Key="TextControlThemeMinHeight">32</x:Double>
        <Thickness x:Key="TextControlHeaderMargin">0,0,0,6</Thickness>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="PasswordRevealMode" Value="Hidden" />
        </Style>
        <Style x:Key="AuthCapsLockTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AuthServerSegmentStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="SegmentRoot" Background="Transparent" CornerRadius="4"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters><Setter Target="SegmentRoot.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" /></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters><Setter Target="SegmentRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" /></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="SegmentRoot.Background" Value="{ThemeResource WardenTileBrush}" />
                                            <Setter Target="SegmentContent.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedUnfocused">
                                        <VisualState.Setters>
                                            <Setter Target="SegmentRoot.Background" Value="{ThemeResource WardenTileBrush}" />
                                            <Setter Target="SegmentContent.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SegmentRoot.Background" Value="{ThemeResource WardenTileBrush}" />
                                            <Setter Target="SegmentContent.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="SegmentRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            <Setter Target="SegmentContent.FontWeight" Value="SemiBold" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters><Setter Target="SegmentRoot.Opacity" Value="0.45" /></VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="SegmentContent" Content="{TemplateBinding Content}"
                                FontSize="14" Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid x:Name="LoginSurface"
        Padding="32"
        Background="{ThemeResource WardenLayerBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideForm">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="400" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowForm">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LoginSurface.Padding" Value="16,32,16,32" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer x:Name="LoginScrollViewer" VerticalScrollBarVisibility="Auto"
            VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled">
            <Grid HorizontalAlignment="Stretch">
            <StackPanel x:Name="LoginForm"
                MaxWidth="360"
                MinWidth="0"
                Spacing="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Margin="0,0,0,0">
                <Border x:Name="LoginAppIcon"
                    Width="48" Height="48" CornerRadius="10"
                    HorizontalAlignment="Center" Background="{ThemeResource WardenPrimaryTextBrush}">
                    <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{ThemeResource WardenLayerBrush}" Data="M12 1C14.7614 1 17 3.23858 17 6V8.00977C18.6781 8.13743 20 9.5392 20 11.25V18.75C20 20.5449 18.5449 22 16.75 22H7.25C5.45507 22 4 20.5449 4 18.75V11.25C4 9.5392 5.3219 8.13743 7 8.00977V6C7 3.23858 9.23858 1 12 1ZM12 13.75C11.3096 13.75 10.75 14.3096 10.75 15C10.75 15.6904 11.3096 16.25 12 16.25C12.6904 16.25 13.25 15.6904 13.25 15C13.25 14.3096 12.6904 13.75 12 13.75ZM12 2.5C10.067 2.5 8.5 4.067 8.5 6V8H15.5V6C15.5 4.067 13.933 2.5 12 2.5Z" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <Border x:Name="LoginStepIcon"
                    Width="48" Height="48" CornerRadius="10" HorizontalAlignment="Center"
                    Background="{ThemeResource WardenTileBrush}" Visibility="Collapsed">
                    <FontIcon x:Name="LoginStepGlyph" Glyph="&#xEA18;" FontSize="24"
                        Foreground="{ThemeResource WardenPrimaryTextBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="LoginAvatar"
                    Width="64" Height="64" CornerRadius="32"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource WardenTileBrush}"
                    Visibility="Collapsed">
                    <TextBlock Text="{x:Bind ViewModel.AccountInitial, Mode=OneWay}"
                        FontFamily="{StaticResource WardenDisplayFontFamily}" FontSize="24" FontWeight="SemiBold"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="LoginTitle" Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}"
                    Margin="0,16,0,0"
                    FontFamily="{StaticResource WardenDisplayFontFamily}" FontSize="20" LineHeight="28" FontWeight="SemiBold"
                    AutomationProperties.HeadingLevel="Level1" TextWrapping="Wrap"
                    HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock x:Name="LoginSubtitle" Text="{x:Bind ViewModel.FormSubtitle, Mode=OneWay}"
                    Margin="0,4,0,0" FontSize="14" LineHeight="20"
                    Foreground="{ThemeResource WardenSecondaryTextBrush}"
                    HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <InfoBar x:Name="LoginStatusInfoBar"
                    Margin="0,28,0,0"
                    IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                    IsClosable="False"
                    AutomationProperties.LiveSetting="Polite"
                    Severity="{x:Bind ViewModel.StatusKind, Mode=OneWay, Converter={StaticResource LoginStatusKindToInfoBarSeverityConverter}}"
                    Message="{x:Bind ViewModel.Status, Mode=OneWay}" />
                <StackPanel x:Name="LoginAccountStage"
                    Margin="0,28,0,0"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsAccountStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel x:Name="SavedAccountsPanel"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.ShowSavedAccounts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock x:Uid="L648CCADD6732FCE0" Text="已保存账户"
                            Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SavedAccounts, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:SavedAccountOption">
                                    <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="10,8"
                                        Click="OnSavedAccountClick">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="16"
                                                Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind Initial}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Email}"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ServerUrl}"
                                                    Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="14"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="L6499927BFDD76D8E" Text="服务器" />
                        <ListBox x:Uid="LAD2B46DBE7846CCD" x:Name="ServerOptionBox"
                            AutomationProperties.Name="服务器"
                            SizeChanged="OnServerOptionsSizeChanged"
                            HorizontalAlignment="Stretch" Height="32" Padding="0"
                            BorderThickness="0" Background="Transparent"
                            ItemContainerStyle="{StaticResource AuthServerSegmentStyle}"
                            SelectedIndex="{x:Bind ViewModel.SelectedServerOptionIndex, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.CanEditServer, Mode=OneWay}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBoxItem x:Uid="L05574DA1F3202964" Content="bitwarden.com" />
                            <ListBoxItem x:Uid="LA5253E6ADBF19F8F" Content="bitwarden.eu" />
                            <ListBoxItem x:Uid="L615210BB1F251210" Content="自托管" />
                        </ListBox>
                    </StackPanel>
                    <TextBox x:Uid="L7595803A181A000D" x:Name="ServerUrlTextBox"
                        Header="服务器地址"
                        AutomationProperties.Name="服务器地址"
                        FontFamily="{StaticResource MonospaceFontFamily}"
                        LostFocus="OnAccountIdentityLostFocus"
                        PlaceholderText="https://vault.example.com"
                        Text="{x:Bind ViewModel.ServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{x:Bind ViewModel.CanEditServer, Mode=OneWay}"
                        MinHeight="32"
                        Visibility="{x:Bind ViewModel.ShowCustomServerUrl, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock x:Name="ServerErrorText" Margin="0,-10,0,0" FontSize="12" LineHeight="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                    <TextBlock x:Uid="L082FDDB80552A422" x:Name="ServerUrlHelper" Margin="0,-10,0,0"
                        Text="Vaultwarden 或自建的 Bitwarden 服务器"
                        Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                        Visibility="{x:Bind ViewModel.ShowCustomServerUrl, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBox x:Uid="LBC9300FE3CB12D9E" x:Name="EmailTextBox"
                        Header="邮箱"
                        AutomationProperties.Name="邮箱"
                        PlaceholderText="name@example.com"
                        Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{x:Bind ViewModel.CanEditServer, Mode=OneWay}"
                        MinHeight="32"
                        InputScope="EmailSmtpAddress" LostFocus="OnAccountIdentityLostFocus" />
                    <TextBlock x:Name="EmailErrorText" Margin="0,-10,0,0" FontSize="12" LineHeight="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                    <CheckBox x:Uid="LD5919F4AC4F5A79D" x:Name="RememberEmailBox" Content="记住邮箱" IsChecked="True"
                        Checked="OnRememberEmailChanged" Unchecked="OnRememberEmailChanged" />
                    <HyperlinkButton x:Uid="L4878005E1BE5D055" x:Name="OpenApiKeySignInButton"
                        Content="Sign in with a personal API key"
                        Command="{x:Bind ViewModel.OpenApiKeySignInCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanUseApiKeySignIn, Mode=OneWay}"
                        Padding="0" MinHeight="32"
                        AutomationProperties.Name="Sign in with a personal API key" />
                </StackPanel>
                <StackPanel x:Name="AccountDeletionRecoveryStage"
                    Margin="0,28,0,0"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsAccountDeletionRecoveryStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <InfoBar x:Name="AccountDeletionRecoveryInfoBar"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Title="{x:Bind ViewModel.AccountDeletionRecoveryTitle, Mode=OneWay}"
                        Message="{x:Bind ViewModel.AccountDeletionRecoveryMessage, Mode=OneWay}" />
                    <Button x:Uid="L73B2B398E95961DB" x:Name="RetryConfirmedAccountDeletionCleanupButton"
                        AutomationProperties.AutomationId="RetryConfirmedAccountDeletionCleanupButton"
                        Content="重试本地清理"
                        Command="{x:Bind ViewModel.RetryConfirmedAccountDeletionCleanupCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanRunAccountDeletionRecoveryAction, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowRetryConfirmedAccountDeletionCleanup, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        MinHeight="32"
                        HorizontalAlignment="Stretch" />
                    <Button x:Uid="L4B2772F91C655812" x:Name="ClearPendingAccountDeletionLocalDataButton"
                        AutomationProperties.AutomationId="ClearPendingAccountDeletionLocalDataButton"
                        Content="仅清除此设备"
                        Click="OnClearPendingAccountDeletionClick"
                        IsEnabled="{x:Bind ViewModel.CanRunAccountDeletionRecoveryAction, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowClearPendingAccountDeletion, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        MinHeight="32"
                        HorizontalAlignment="Stretch" />
                    <Button x:Name="ContinueFromAccountDeletionRecoveryButton"
                        AutomationProperties.AutomationId="ContinueFromAccountDeletionRecoveryButton"
                        Content="{x:Bind ViewModel.AccountDeletionRecoveryContinueText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ContinueFromAccountDeletionRecoveryCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanContinueFromAccountDeletionRecovery, Mode=OneWay}"
                        MinHeight="32"
                        HorizontalAlignment="Stretch" />
                    <Button x:Uid="L66C1C70909C12176" x:Name="RequestFullLocalResetButton"
                        AutomationProperties.AutomationId="RequestFullLocalResetButton"
                        Content="清除全部本机数据并退出"
                        Click="OnRequestFullLocalResetClick"
                        IsEnabled="{x:Bind ViewModel.CanRequestFullLocalReset, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowFullLocalResetAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        MinHeight="32"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel x:Name="LoginPasswordStage"
                    Margin="0,28,0,0"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsPasswordStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel x:Name="ApiKeySignInFields" Spacing="16"
                        Visibility="{x:Bind ViewModel.IsApiKeyMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox x:Uid="L627468D6E21B8AE7" x:Name="ApiKeyClientIdBox" Header="Personal API client ID"
                            AutomationProperties.Name="Personal API client ID"
                            PlaceholderText="user.account-uuid" MaxLength="41"
                            Text="{x:Bind ViewModel.ApiKeyClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{x:Bind ViewModel.CanUsePrimaryAction, Mode=OneWay}" />
                        <TextBlock x:Name="ApiKeyClientIdErrorText" Margin="0,-10,0,0" FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                            AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                        <PasswordBox x:Uid="L1B2A95CAD6419763" x:Name="ApiKeySecretBox" Header="Personal API secret"
                            AutomationProperties.Name="Personal API secret" MaxLength="8192"
                            Password="{x:Bind ViewModel.ApiKeySecret, Mode=TwoWay}"
                            PasswordRevealMode="Hidden"
                            IsEnabled="{x:Bind ViewModel.CanUsePrimaryAction, Mode=OneWay}" />
                        <TextBlock x:Name="ApiKeySecretErrorText" Margin="0,-10,0,0" FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                            AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                        <TextBlock x:Uid="L63B1AF29CC3D0F37" Text="Personal API keys bypass two-step login on the server. The secret is never saved. When the access token expires, sign in again; a saved vault can still be unlocked offline."
                            TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="LoginWithDeviceQuarantinePanel"
                        Spacing="10"
                        Visibility="{x:Bind ViewModel.ShowLoginWithDeviceQuarantineNotice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <InfoBar x:Name="LoginWithDeviceQuarantineInfoBar"
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Warning"
                            Title="{x:Bind ViewModel.LoginWithDeviceQuarantineTitle, Mode=OneWay}"
                            Message="{x:Bind ViewModel.LoginWithDeviceQuarantineMessage, Mode=OneWay}" />
                        <Button x:Uid="LF40A69758AF5EA58" x:Name="ClearLoginWithDeviceQuarantineButton"
                            AutomationProperties.AutomationId="ClearLoginWithDeviceQuarantineButton"
                            Content="检查/撤销其他设备会话后清除此隔离"
                            Click="OnClearLoginWithDeviceQuarantineClick"
                            IsEnabled="{x:Bind ViewModel.CanClearLoginWithDeviceQuarantine, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ShowLoginWithDeviceQuarantineClearAction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Stretch"
                            MinHeight="32" />
                    </StackPanel>
                    <Grid>
                    <PasswordBox x:Uid="LE32BE63C3CDAA28D" x:Name="MasterPasswordBox"
                        Header="主密码"
                        AutomationProperties.Name="主密码"
                        MinHeight="32" Padding="10,4,36,4" PasswordRevealMode="Hidden"
                        Password="{x:Bind ViewModel.MasterPassword, Mode=TwoWay}" />
                        <ToggleButton x:Uid="L32E71108187CC590" x:Name="RevealMasterPasswordBoxButton" Tag="MasterPasswordBox"
                            AutomationProperties.Name="显示主密码" ToolTipService.ToolTip="显示主密码"
                            Checked="OnPasswordRevealChanged" Unchecked="OnPasswordRevealChanged"
                            Background="Transparent" BorderThickness="0" Width="32" Height="32"
                            MinWidth="32" MinHeight="32" Padding="0" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                            <FontIcon Glyph="&#xE890;" FontSize="16" />
                        </ToggleButton>
                    </Grid>
                    <TextBlock x:Name="MasterPasswordErrorText" Margin="0,-10,0,0" FontSize="12" LineHeight="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                    <StackPanel x:Name="MasterPasswordCapsWarning" Orientation="Horizontal" Spacing="6" Margin="0,-10,0,0"
                        Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
                        <FontIcon Glyph="&#xE765;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Uid="L30E91FFA89A601A2" Text="大写锁定已打开" Style="{StaticResource AuthCapsLockTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="LoginWithDeviceStage"
                    Margin="0,28,0,0"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsLoginWithDeviceStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border BorderThickness="0,1" BorderBrush="{ThemeResource WardenLineBrush}"
                        Padding="0,14,0,16"
                        Visibility="{x:Bind ViewModel.HasLoginWithDeviceFingerprint, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="LBDF21CE442374F09" Text="指纹短语" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                            <TextBox x:Uid="L40105222AD7C68A2" x:Name="LoginWithDeviceFingerprintBox"
                                AutomationProperties.AutomationId="LoginWithDeviceFingerprintBox"
                                AutomationProperties.Name="指纹短语"
                                Text="{x:Bind ViewModel.LoginWithDeviceFingerprint, Mode=OneWay}"
                                IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="0"
                                Background="Transparent" FontFamily="{StaticResource MonospaceFontFamily}"
                                FontSize="18" FontWeight="SemiBold"
                                Visibility="{x:Bind ViewModel.HasLoginWithDeviceFingerprint, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock x:Uid="L931F9A7FB781FE28" Text="在另一台设备上批准前，确认那里显示的是同样的短语。"
                                FontSize="12" LineHeight="18" Foreground="{ThemeResource WardenSecondaryTextBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE823;" FontSize="16" Foreground="{ThemeResource WardenSecondaryTextBrush}" />
                        <TextBlock x:Uid="L2078EC07EC1ECB20" x:Name="DeviceApprovalWaitingText" Text="正在等待批准"
                            Foreground="{ThemeResource WardenSecondaryTextBrush}"
                            AutomationProperties.LiveSetting="Off" />
                    </StackPanel>
                    <TextBlock x:Name="LoginWithDeviceExpiryText"
                        AutomationProperties.AutomationId="LoginWithDeviceExpiryText"
                        Text="{x:Bind ViewModel.LoginWithDeviceExpiryText, Mode=OneWay}"
                        Visibility="Collapsed" />
                    <Button x:Uid="L3D734EAE11CCFCAC" x:Name="CancelLoginWithDeviceButton"
                        AutomationProperties.AutomationId="CancelLoginWithDeviceButton"
                        Content="改用主密码"
                        Command="{x:Bind ViewModel.CancelLoginWithDeviceCommand, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowCancelLoginWithDevice, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        MinHeight="32"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel x:Name="LoginDeviceVerificationStage"
                    Margin="0,28,0,0"
                    Spacing="16"
                    Visibility="{x:Bind ViewModel.IsDeviceVerificationStage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBox x:Uid="L00C1A3D33A56DD54" x:Name="DeviceVerificationCodeTextBox"
                        AutomationProperties.AutomationId="DeviceVerificationCodeTextBox"
                        Header="设备验证码"
                        AutomationProperties.Name="设备验证码"
                        PlaceholderText="输入邮箱中的验证码"
                        Text="{x:Bind ViewModel.DeviceVerificationCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        InputScope="Number"
                        MaxLength="16"
                        MinHeight="32" />
                    <TextBlock x:Name="DeviceVerificationErrorText" Margin="0,-10,0,0" FontSize="12" LineHeight="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
                    <HyperlinkButton x:Uid="L2D6F8F6ABAF56A4E" x:Name="ResendNewDeviceCodeButton"
                        AutomationProperties.AutomationId="ResendNewDeviceCodeButton"
                        Content="重新发送验证码"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.ResendNewDeviceCodeCommand, Mode=OneWay}"
