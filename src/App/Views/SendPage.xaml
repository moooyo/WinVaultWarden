                <StackPanel Orientation="Horizontal" Spacing="8" Margin="20,16,16,4">
                    <TextBlock Text="{x:Bind ViewModel.ListTitle, Mode=OneWay}" FontFamily="{StaticResource WardenDisplayFontFamily}" FontSize="20" LineHeight="28" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.ListCountLabel, Mode=OneWay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <DropDownButton x:Uid="L0C7D35F778C9174D" Grid.Row="1" Content="最近修改" x:Name="SortButton" Margin="12,5,10,5" Height="30" MinHeight="0" Padding="8,0" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left">
                    <DropDownButton.Flyout><MenuFlyout><RadioMenuFlyoutItem x:Uid="L4D2D42AF390DDD95" Text="最近修改" IsChecked="True" Tag="recent" Click="OnSortClick" /><RadioMenuFlyoutItem x:Uid="LC1BAEB0309047569" Text="即将删除" Tag="deletion" Click="OnSortClick" /></MenuFlyout></DropDownButton.Flyout>
                </DropDownButton>
                <Border x:Name="DraftRow" Grid.Row="2" Visibility="Collapsed" Margin="6,0" Padding="12,0,8,0" Height="52" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="3" Height="16" CornerRadius="2" Margin="-12,0,0,0" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                        <Border Width="32" Height="32" CornerRadius="6" Background="{ThemeResource WardenTileBrush}"><FontIcon x:Name="DraftRowGlyph" FontSize="16" /></Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock x:Name="DraftRowName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Uid="L2150DB21D8A1EE60" Text="新建 · 未保存" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="3">
                    <ListView x:Uid="L0C098FA290AE735C" x:Name="SendContentList" ItemsSource="{x:Bind ViewModel.FilteredItems}" SelectionMode="Single" SelectionChanged="OnSendSelectionChanged" IsItemClickEnabled="True" ItemClick="OnSendItemClick" KeyDown="OnSendListKeyDown" ContainerContentChanging="OnSendContainerContentChanging" Margin="6,0,6,8" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Send 列表" AutomationProperties.AutomationId="SendsList" Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <ListView.Resources><x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean></ListView.Resources>
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="12,0,8,0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="52" /><Setter Property="Height" Value="52" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate x:DataType="models:SendListItem">
                            <Grid x:Name="SendRowRoot" ColumnSpacing="12" PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited" RightTapped="OnRowRightTapped" Loaded="OnSendRowLoaded" Unloaded="OnSendRowUnloaded" DataContextChanged="OnSendRowDataContextChanged">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.ContextFlyout><MenuFlyout Opening="OnRowMenuOpening"><MenuFlyoutItem x:Uid="L0A1D7D7D650F45CF" Text="复制链接" Click="OnCopyLinkMenuClick" KeyboardAcceleratorTextOverride="Ctrl+C" /><MenuFlyoutItem x:Uid="L3AFC7BDC311908B2" Text="编辑" IsEnabled="{x:Bind CanModify}" Click="OnEditSendClick" KeyboardAcceleratorTextOverride="F2" /><MenuFlyoutItem Text="{x:Bind ToggleActionLabel}" IsEnabled="{x:Bind CanModify}" Click="OnToggleDisabledClick" /><MenuFlyoutSeparator /><MenuFlyoutItem x:Uid="LFF2A4693E38E9593" Text="删除" IsEnabled="{x:Bind CanModify}" Click="OnDeleteSendClick" KeyboardAcceleratorTextOverride="Delete" /></MenuFlyout></Grid.ContextFlyout>
                                <Border x:Name="RowSelectionIndicator" Grid.ColumnSpan="3" Width="3" Height="16" CornerRadius="2" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                <Border Width="32" Height="32" CornerRadius="6" Background="{ThemeResource WardenTileBrush}" VerticalAlignment="Center"><FontIcon Glyph="{x:Bind Glyph}" FontSize="16" /></Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{x:Bind Name}" Opacity="{x:Bind NameOpacity}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind ListSubtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                <Grid Grid.Column="2" MinWidth="28">
                                    <StackPanel x:Name="RowProtection" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Loaded="OnRowProtectionLoaded" Visibility="{x:Bind HasRowStatus, Converter={StaticResource BoolToVis}}">
                                        <FontIcon x:Name="RowAvailabilityIcon" Glyph="{x:Bind RowStatusGlyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind HasPassword, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <Button x:Uid="LF6873D8B9C072504" x:Name="RowCopyButton" AutomationProperties.AutomationId="SendRowCopyLinkButton" Style="{StaticResource SendIconButton}" Width="28" Height="28" Visibility="Collapsed" Click="OnCopyLinkClick" ToolTipService.ToolTip="复制链接" AutomationProperties.Name="复制链接"><FontIcon Glyph="&#xE71B;" FontSize="16" /></Button>
                                </Grid>
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <ProgressRing x:Uid="L4EC530CFB8CA76B4" x:Name="SendLoadingRing" AutomationProperties.Name="正在加载 Send" AutomationProperties.LiveSetting="Polite" Width="28" Height="28" IsActive="{x:Bind ViewModel.ShowLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <StackPanel x:Name="SendEmptyPanel" Margin="24,56,24,24" Spacing="4" VerticalAlignment="Top" Visibility="{x:Bind EmptyStateVisibility(ViewModel.ShowEmpty), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}" MaxWidth="260" FontSize="12" LineHeight="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
