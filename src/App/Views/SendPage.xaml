                        <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="{x:Bind ViewModel.ShowSearchEmptyActions, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <Button x:Uid="L1A74EA0743EEA186" Content="清除搜索" Height="32" MinHeight="32" HorizontalAlignment="Center" Click="OnClearSearchClick" />
                            <Button x:Uid="L128F583871288FA2" Content="在全部 Send 中搜索" Height="32" MinHeight="32" HorizontalAlignment="Center" Click="OnSearchAllSendsClick" Visibility="{x:Bind ViewModel.ShowSearchAllEmptyAction, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="12" Margin="24" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay, Converter={StaticResource BoolToVis}}"><TextBlock x:Uid="LF748FCD604C3F05D" Text="无法加载 Send" FontSize="16" HorizontalAlignment="Center" /><Button x:Uid="L20AC9A96C5B56849" Content="重新加载" HorizontalAlignment="Center" Click="OnRetryClick" /></StackPanel>
                </Grid>
            </Grid>
            <Grid x:Name="DetailPane" Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border x:Name="NarrowBackBar" Height="44" Visibility="Collapsed" Padding="12,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"><Button x:Name="BackToListButton" Click="OnBackToListClick" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="16" /><TextBlock Text="{x:Bind ViewModel.ListTitle, Mode=OneWay}" /></StackPanel></Button></Border>
                <StackPanel x:Name="ChooseSendHint" Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"><FontIcon Glyph="&#xE724;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><TextBlock x:Uid="L871B124D97130F9B" Text="没有可显示的 Send" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></StackPanel>
                <ScrollViewer x:Name="DetailScroll" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="DetailContent" Padding="40,32" MaxWidth="1000" HorizontalAlignment="Left">

                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" CornerRadius="10" Background="{ThemeResource WardenTileBrush}"><FontIcon x:Name="DetailGlyph" FontSize="24" /></Border>
                            <StackPanel Grid.Column="1" Spacing="2" Margin="0,1,0,0"><TextBlock x:Name="DetailName" FontFamily="{StaticResource WardenDisplayFontFamily}" FontSize="28" LineHeight="36" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="DetailSubtitle" FontSize="12" LineHeight="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" Margin="0,4,0,0">
                                <Button x:Uid="L899176B0B0BF50DB" x:Name="EditSelectedSendButton" Height="32" MinHeight="32" Padding="12,0" Click="OnEditSendClick" ToolTipService.ToolTip="编辑 · F2"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE70F;" FontSize="16" /><TextBlock x:Uid="L04F646C53771718C" Text="编辑" /></StackPanel></Button>
                                <Button x:Uid="LB19382EC5EAA84DF" x:Name="CopySelectedLinkButton" Style="{ThemeResource AccentButtonStyle}" Height="32" MinHeight="32" Padding="14,0" Click="OnCopySelectedLinkClick" ToolTipService.ToolTip="复制分享链接 · Ctrl+C" AutomationProperties.Name="复制分享链接"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon x:Name="CopySelectedLinkGlyph" Glyph="&#xE71B;" FontSize="16" /><TextBlock x:Uid="L87D5CACDF64A1495" x:Name="CopySelectedLinkText" Text="复制链接" /></StackPanel></Button>
                                <Button x:Uid="LF1B6883A72986E71" x:Name="SelectedMoreButton" AutomationProperties.AutomationId="SendDetailMoreButton" Style="{StaticResource SendIconButton}" Click="OnSelectedMoreClick" ToolTipService.ToolTip="更多" AutomationProperties.Name="更多"><FontIcon Glyph="&#xE712;" FontSize="16" /><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Uid="L0A1D7D7D650F45CF" Text="复制链接" Click="OnCopyLinkMenuClick" /><MenuFlyoutItem x:Uid="L3AFC7BDC311908B2" Text="编辑" IsEnabled="{x:Bind ViewModel.CanModifySend(ViewModel.SelectedMenuItem), Mode=OneWay}" Click="OnEditSendClick" /><MenuFlyoutItem Text="{x:Bind ViewModel.SelectedMenuItem.ToggleActionLabel, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanModifySend(ViewModel.SelectedMenuItem), Mode=OneWay}" Click="OnToggleDisabledClick" /><MenuFlyoutSeparator /><MenuFlyoutItem x:Uid="LFF2A4693E38E9593" Text="删除" IsEnabled="{x:Bind ViewModel.CanModifySend(ViewModel.SelectedMenuItem), Mode=OneWay}" Click="OnDeleteSendClick" /></MenuFlyout></Button.Flyout></Button>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="72,12,0,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border x:Name="DetailStatusBadge" Width="14" Height="14" CornerRadius="7" Background="{ThemeResource SystemFillColorSuccessBrush}" VerticalAlignment="Center"><FontIcon x:Name="DetailStatusIcon" Glyph="&#xE73E;" FontSize="8" Foreground="{ThemeResource WardenLayerBrush}" /></Border><TextBlock x:Name="DetailStatus" Grid.Column="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" /></Grid><HyperlinkButton x:Name="DetailStatusAction" Grid.Column="1" Click="OnDetailStatusActionClick" Visibility="Collapsed" Padding="8,0" MinHeight="24" /></Grid>
                        <Button x:Uid="L4084226649B5979F" x:Name="ShareLinkButton" Margin="-12,28,-12,0" Padding="12,12,12,20" Background="Transparent" BorderThickness="0" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnCopySelectedLinkClick" ToolTipService.ToolTip="点击复制链接"><StackPanel Spacing="4"><TextBlock x:Uid="L25C3E087E54510AA" x:Name="ShareLinkLabel" Text="分享链接" Height="24" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="ShareLinkText" FontFamily="{StaticResource MonospaceFontFamily}" FontSize="16" LineHeight="28" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"><Run x:Name="ShareLinkHostRun" /><Run x:Name="ShareLinkPathRun" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></TextBlock><ProgressBar x:Name="ShareLinkProgress" Height="2" MinHeight="0" Maximum="1" Visibility="Collapsed" /></StackPanel></Button>
                        <Border x:Name="TextDetailBlock" Margin="0,24,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,1" Padding="0,16,0,20"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock x:Uid="LD3EDAC24603C4ED0" Text="文本内容" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="SendTextContent" FontSize="15" LineHeight="26" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" IsTextSelectionEnabled="True" /></StackPanel><Button x:Uid="LD843A00278B0D4C0" Grid.Column="1" Style="{StaticResource SendIconButton}" VerticalAlignment="Top" Click="OnCopyTextClick" ToolTipService.ToolTip="复制文本" AutomationProperties.Name="复制文本"><FontIcon Glyph="&#xE8C8;" FontSize="16" /></Button></Grid></Border>
                        <Border x:Name="FileDetailBlock" Visibility="Collapsed" Margin="0,24,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,1" Padding="0,16"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Height="40" CornerRadius="6" Background="{ThemeResource WardenTileBrush}"><FontIcon Glyph="&#xE8A5;" FontSize="20" /></Border><StackPanel Grid.Column="1"><TextBlock x:Name="DetailFileName" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="DetailFileSize" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><Button Grid.Column="2" Click="OnDownloadOwnFileClick"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE896;" FontSize="16" /><TextBlock x:Uid="L3448254694920882" Text="下载" /></StackPanel></Button></Grid></Border>
                        <StackPanel Margin="0,28,0,0">
                            <Border Style="{StaticResource SendPropertyRow}" BorderThickness="0,1,0,1"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Uid="LB8CE64FB3F89085A" Text="删除时间" Style="{StaticResource SendLabel}" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="DetailDeletion" /><TextBlock x:Name="DetailDeletionHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Grid></Border>
                            <Border Style="{StaticResource SendPropertyRow}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Uid="LFBD63625D2FD242F" Text="过期时间" Style="{StaticResource SendLabel}" /><TextBlock x:Name="DetailExpiration" Grid.Column="1" VerticalAlignment="Center" /></Grid></Border>
                            <Border Style="{StaticResource SendPropertyRow}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Uid="L59B5B3F4DF7AD073" Text="最大访问次数" Style="{StaticResource SendLabel}" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="DetailAccessLimit" /><TextBlock x:Name="DetailAccessCount" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Grid></Border>
                            <Border Style="{StaticResource SendPropertyRow}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Uid="L92772975A4D402DA" Text="访问密码" Style="{StaticResource SendLabel}" /><TextBlock x:Name="DetailPassword" Grid.Column="1" VerticalAlignment="Center" /></Grid></Border>
                            <Border Style="{StaticResource SendPropertyRow}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Uid="LC5D21EB4B9F0C226" Text="隐藏我的邮箱" Style="{StaticResource SendLabel}" /><TextBlock x:Name="DetailHideEmail" Grid.Column="1" VerticalAlignment="Center" /></Grid></Border>
                            <Border x:Name="NotesDetailRow" Style="{StaticResource SendPropertyRow}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Uid="L7C57AE197ADC5F98" Text="备注" Style="{StaticResource SendLabel}" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="DetailNotes" TextWrapping="Wrap" /><TextBlock x:Uid="L110C5DF9B8A5C359" Text="只有你自己能看到" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Grid></Border>
                        </StackPanel>
                        <TextBlock x:Name="DetailModified" Margin="0,24,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="EditorScroll" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="EditorContent" Padding="40,32" MaxWidth="1000" HorizontalAlignment="Left">
                        <Grid x:Name="EditorHeaderGrid" ColumnSpacing="16" SizeChanged="OnEditorHeaderSizeChanged">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Width="56" Height="56" CornerRadius="10" Background="{ThemeResource WardenTileBrush}"><FontIcon x:Name="EditorGlyph" FontSize="24" /></Border>
                            <StackPanel x:Name="EditorNamePanel" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4" Margin="0,6,0,0">
