<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="App.Views.SettingsTwoFactorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <Grid Padding="40,8,40,48" HorizontalAlignment="Stretch">
        <Border MaxWidth="680" HorizontalAlignment="Stretch">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon x:Name="StatusIcon" Glyph="&#xE8FD;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="StatusText" Text="正在加载…" />
                </StackPanel>
                <TextBlock Text="在新设备上登录时，除了主密码还要再验证一次。多开启几种方式，手边没有其中一种时可以换着用。" MaxWidth="600" HorizontalAlignment="Left" Margin="0,8,0,28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <InfoBar x:Name="LoadErrorBar" IsOpen="False" IsClosable="False" Severity="Error" Margin="0,0,0,12">
                    <InfoBar.ActionButton><Button Content="重试" Click="OnRetryClick" /></InfoBar.ActionButton>
                </InfoBar>
                <ProgressRing x:Name="LoadingRing" IsActive="True" Width="24" Height="24" HorizontalAlignment="Left" AutomationProperties.Name="正在加载两步登录" />
                <ContentControl x:Name="MethodsContent" HorizontalContentAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="验证方式" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><StackPanel x:Name="ProviderRows" /></Border>
                        <StackPanel x:Name="WebAuthnGroup" Margin="0,32,0,0">
                            <TextBlock Text="已添加的密钥" FontWeight="SemiBold" Margin="0,0,0,8" AutomationProperties.HeadingLevel="Level2" />
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><StackPanel x:Name="WebAuthnRows" /></Border>
                        </StackPanel>
                        <TextBlock Text="恢复" FontWeight="SemiBold" Margin="0,32,0,8" />
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><StackPanel x:Name="RecoveryRows" /></Border>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </Border>
        </Grid>
    </ScrollViewer>
</Page>
