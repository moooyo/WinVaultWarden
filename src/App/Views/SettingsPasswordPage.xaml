<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.SettingsPasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnCancelAccelerator" />
    </Page.KeyboardAccelerators>
    <Page.Resources>
        <Style x:Key="PasswordFieldErrorStyle" TargetType="TextBlock"
            BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        </Style>
        <Style x:Key="PasswordErrorUnderlineStyle" TargetType="Border">
            <Setter Property="Height" Value="2" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="CornerRadius" Value="0,0,3,3" />
            <Setter Property="Margin" Value="1,0,1,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="40,8,40,48" HorizontalAlignment="Stretch">
            <StackPanel x:Name="PasswordContent" MaxWidth="680" HorizontalAlignment="Stretch" Spacing="28">
                <TextBlock MaxWidth="600" HorizontalAlignment="Left"
                    Text="更改后，其他设备都需要用新主密码重新登录。主密码无法找回，请确认你记得住它。"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <StackPanel Width="360" MaxWidth="{x:Bind PasswordContent.ActualWidth, Mode=OneWay}"
                    HorizontalAlignment="Left" Spacing="16">
                    <InfoBar x:Name="OperationErrorInfoBar"
                        AutomationProperties.AutomationId="ChangePasswordErrorText"
                        AutomationProperties.LiveSetting="Polite"
                        IsOpen="False" IsClosable="False" Severity="Error" Visibility="Collapsed" />

                    <ContentControl x:Name="PasswordFields" IsEnabled="False"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="当前主密码" />
                            <Grid>
                                <PasswordBox x:Name="CurrentPasswordBox"
                                    AutomationProperties.AutomationId="ChangePasswordCurrentBox"
                                    AutomationProperties.Name="当前主密码"
                                    MinHeight="32" Padding="10,0" PasswordRevealMode="Hidden"
                                    PasswordChanged="OnCurrentPasswordChanged" />
                                <Border x:Name="CurrentErrorUnderline"
                                    Style="{StaticResource PasswordErrorUnderlineStyle}" />
                            </Grid>
                            <TextBlock x:Name="CurrentPasswordError"
                                Style="{StaticResource PasswordFieldErrorStyle}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="新主密码" />
                            <Grid>
                                <PasswordBox x:Name="NewPasswordBox"
                                    AutomationProperties.AutomationId="ChangePasswordNewBox"
                                    AutomationProperties.Name="新主密码"
                                    AutomationProperties.HelpText="至少 12 个字符"
                                    MinHeight="32" Padding="10,0,36,0" PasswordRevealMode="Hidden"
                                    PasswordChanged="OnNewPasswordChanged" />
                                <ToggleButton x:Name="RevealPasswordsButton"
                                    AutomationProperties.AutomationId="ChangePasswordRevealButton"
                                    AutomationProperties.Name="显示新主密码和确认主密码"
                                    ToolTipService.ToolTip="显示新主密码和确认主密码"
                                    Width="32" Height="32" MinWidth="32" MinHeight="32"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Padding="0" Background="Transparent" BorderThickness="0"
                                    Checked="OnRevealPasswordsChanged" Unchecked="OnRevealPasswordsChanged">
                                    <FontIcon x:Name="RevealPasswordsIcon" Glyph="&#xE890;" FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </ToggleButton>
                                <Border x:Name="NewErrorUnderline"
                                    Style="{StaticResource PasswordErrorUnderlineStyle}" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="4" VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="StrengthSegment1" Height="4" CornerRadius="2"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Border x:Name="StrengthSegment2" Grid.Column="1" Height="4" CornerRadius="2"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Border x:Name="StrengthSegment3" Grid.Column="2" Height="4" CornerRadius="2"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Border x:Name="StrengthSegment4" Grid.Column="3" Height="4" CornerRadius="2"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                </Grid>
                                <TextBlock x:Name="StrengthLabel" Grid.Column="1"
                                    Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                                    AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Grid.Column="2" Text="至少 12 个字符"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock x:Name="NewPasswordError"
                                Style="{StaticResource PasswordFieldErrorStyle}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="确认新主密码" />
                            <Grid>
                                <PasswordBox x:Name="ConfirmPasswordBox"
                                    AutomationProperties.AutomationId="ChangePasswordConfirmBox"
                                    AutomationProperties.Name="确认新主密码"
                                    MinHeight="32" Padding="10,0" PasswordRevealMode="Hidden"
                                    PasswordChanged="OnConfirmPasswordChanged" />
                                <Border x:Name="ConfirmErrorUnderline"
                                    Style="{StaticResource PasswordErrorUnderlineStyle}" />
                            </Grid>
                            <TextBlock x:Name="ConfirmPasswordError"
                                Style="{StaticResource PasswordFieldErrorStyle}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="主密码提示（可选）" />
                            <Grid>
                                <TextBox x:Name="PasswordHintBox"
                                    AutomationProperties.AutomationId="ChangePasswordHintBox"
                                    AutomationProperties.Name="主密码提示（可选）"
                                    AutomationProperties.HelpText="忘记主密码时可以发到你的邮箱，不能包含主密码本身"
                                    MinHeight="32" Padding="10,0"
                                    TextChanged="OnPasswordHintChanged"
                                    KeyDown="OnPasswordHintKeyDown" />
                                <Border x:Name="HintErrorUnderline"
                                    Style="{StaticResource PasswordErrorUnderlineStyle}" />
                            </Grid>
                            <TextBlock Text="忘记主密码时可以发到你的邮箱，不能包含主密码本身"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock x:Name="PasswordHintError"
                                Style="{StaticResource PasswordFieldErrorStyle}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <CheckBox x:Name="RotateAccountKeyCheckBox"
                                AutomationProperties.AutomationId="ChangePasswordRotateKeyCheckBox"
                                AutomationProperties.Name="同时更换账户加密密钥"
                                AutomationProperties.HelpText="当前版本暂不支持更换账户加密密钥"
                                IsChecked="False" IsEnabled="False" MinHeight="24">
                                <TextBlock Text="同时更换账户加密密钥" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Margin="28,0,0,0" Text="当前版本暂不支持更换账户加密密钥。"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        </StackPanel>
                    </ContentControl>

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button x:Name="ChangePasswordButton"
                            AutomationProperties.AutomationId="ChangePasswordSubmitButton"
                            Style="{ThemeResource AccentButtonStyle}"
                            Content="更改主密码" MinHeight="32" Padding="20,0"
                            IsEnabled="False" Click="OnChangePasswordClick" />
                        <Button x:Name="CancelButton"
                            AutomationProperties.AutomationId="ChangePasswordCancelButton"
                            Content="取消" MinHeight="32" Padding="16,0"
                            Click="OnCancelClick" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
