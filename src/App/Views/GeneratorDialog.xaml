<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="App.Views.GeneratorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:conv="using:App.Converters"
    Title="生成器"
    CloseButtonText="关闭"
    PrimaryButtonText="复制"
    PrimaryButtonClick="OnPrimaryButtonClick"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </ContentDialog.Resources>

    <ScrollViewer x:Name="GeneratorContent" MaxHeight="660">
        <StackPanel Spacing="14">
            <TabView x:Name="GeneratorTabs"
                     IsAddTabButtonVisible="False"
                     CanDragTabs="False"
                     CanReorderTabs="False"
                     TabWidthMode="Equal"
                     SelectionChanged="OnGeneratorTabSelectionChanged">
                <TabViewItem x:Name="PasswordTab" Header="密码" IsClosable="False">
                    <StackPanel Spacing="14" Padding="0,12,0,0">
                        <Border Style="{StaticResource CardBorderStyle}"
                                Padding="{StaticResource CardContentPaddingCompact}">
                            <StackPanel Spacing="{StaticResource SpacingMedium}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.GeneratedPassword, Mode=OneWay}"
                                               FontFamily="{StaticResource MonospaceFontFamily}"
                                               FontSize="22"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Width="36"
                                            Height="32"
                                            Padding="0"
                                            AutomationProperties.Name="重新生成密码"
                                            ToolTipService.ToolTip="重新生成"
                                            Command="{x:Bind ViewModel.RegenerateCommand}">
                                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    </Button>
                                    <Button Grid.Column="2"
                                            Width="36"
                                            Height="32"
                                            Padding="0"
                                            AutomationProperties.Name="复制密码"
                                            ToolTipService.ToolTip="复制"
                                            Command="{x:Bind ViewModel.CopyCommand}">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    </Button>
                                </Grid>

                                <StackPanel Spacing="{StaticResource SpacingXSmall}"
                                            Visibility="{x:Bind ViewModel.ShowStrength, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar Minimum="0"
                                                 Maximum="1"
                                                 Value="{x:Bind ViewModel.StrengthFraction, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.StrengthLabel, Mode=OneWay}"
                                               Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="选项" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <StackPanel Spacing="{StaticResource SpacingXSmall}">
                            <tk:SettingsCard Header="长度" HorizontalContentAlignment="Stretch">
                                <Grid MinWidth="0" ColumnSpacing="{StaticResource SpacingMedium}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider MinWidth="96"
                                            VerticalAlignment="Center"
                                            Minimum="5"
                                            Maximum="128"
                                            StepFrequency="1"
                                            AutomationProperties.Name="密码长度滑块"
                                            AutomationProperties.AutomationId="PasswordLengthSlider"
                                            Value="{x:Bind ViewModel.LengthValue, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="1"
                                               Width="84"
                                               Minimum="5"
                                               Maximum="128"
                                               SpinButtonPlacementMode="Inline"
                                               AutomationProperties.Name="密码长度数值"
                                               AutomationProperties.AutomationId="PasswordLengthNumberBox"
                                               Value="{x:Bind ViewModel.LengthValue, Mode=TwoWay}" />
                                </Grid>
                            </tk:SettingsCard>

                            <tk:SettingsCard Header="包含字符" HorizontalContentAlignment="Stretch">
                                <Grid MinWidth="0" ColumnSpacing="10" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <CheckBox Content="A-Z"
                                              AutomationProperties.AutomationId="IncludeUppercaseCheckBox"
                                              IsChecked="{x:Bind ViewModel.IncludeUppercase, Mode=TwoWay}" />
                                    <CheckBox Grid.Column="1"
                                              Content="a-z"
                                              AutomationProperties.AutomationId="IncludeLowercaseCheckBox"
                                              IsChecked="{x:Bind ViewModel.IncludeLowercase, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="1"
                                              Content="0-9"
                                              AutomationProperties.AutomationId="IncludeNumbersCheckBox"
                                              IsChecked="{x:Bind ViewModel.IncludeNumbers, Mode=TwoWay}" />
                                    <CheckBox Grid.Row="1"
                                              Grid.Column="1"
                                              Content="!@#$%^&amp;*"
                                              AutomationProperties.AutomationId="IncludeSpecialCheckBox"
                                              IsChecked="{x:Bind ViewModel.IncludeSpecial, Mode=TwoWay}" />
                                </Grid>
                            </tk:SettingsCard>

                            <tk:SettingsCard Header="数字最少个数">
                                <NumberBox Width="84"
                                           Minimum="0"
                                           Maximum="128"
                                           SpinButtonPlacementMode="Inline"
                                           IsEnabled="{x:Bind ViewModel.IncludeNumbers, Mode=OneWay}"
                                           AutomationProperties.AutomationId="MinNumbersNumberBox"
                                           Value="{x:Bind ViewModel.MinNumbersValue, Mode=TwoWay}" />
                            </tk:SettingsCard>

                            <tk:SettingsCard Header="符号最少个数">
                                <NumberBox Width="84"
                                           Minimum="0"
                                           Maximum="128"
                                           SpinButtonPlacementMode="Inline"
                                           IsEnabled="{x:Bind ViewModel.IncludeSpecial, Mode=OneWay}"
                                           AutomationProperties.AutomationId="MinSpecialNumberBox"
                                           Value="{x:Bind ViewModel.MinSpecialValue, Mode=TwoWay}" />
                            </tk:SettingsCard>

                            <tk:SettingsCard Header="避免易混淆的字符">
                                <ToggleSwitch AutomationProperties.AutomationId="AvoidAmbiguousToggle"
                                              IsOn="{x:Bind ViewModel.AvoidAmbiguous, Mode=TwoWay}" />
                            </tk:SettingsCard>
                        </StackPanel>
                    </StackPanel>
                </TabViewItem>

                <TabViewItem Header="密码短语" IsClosable="False">
                    <StackPanel Spacing="14" Padding="0,12,0,0">
                        <Border Style="{StaticResource CardBorderStyle}"
                                Padding="{StaticResource CardContentPaddingCompact}">
                            <StackPanel Spacing="{StaticResource SpacingMedium}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.GeneratedPassword, Mode=OneWay}"
                                               FontFamily="{StaticResource MonospaceFontFamily}"
                                               FontSize="20"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Width="36"
                                            Height="32"
                                            Padding="0"
                                            AutomationProperties.Name="重新生成密码短语"
                                            ToolTipService.ToolTip="重新生成"
                                            Command="{x:Bind ViewModel.RegenerateCommand}">
                                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    </Button>
                                    <Button Grid.Column="2"
                                            Width="36"
                                            Height="32"
                                            Padding="0"
                                            AutomationProperties.Name="复制密码短语"
                                            ToolTipService.ToolTip="复制"
                                            Command="{x:Bind ViewModel.CopyCommand}">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    </Button>
                                </Grid>

                                <StackPanel Spacing="{StaticResource SpacingXSmall}"
                                            Visibility="{x:Bind ViewModel.ShowStrength, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar Minimum="0"
                                                 Maximum="1"
                                                 Value="{x:Bind ViewModel.StrengthFraction, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.StrengthLabel, Mode=OneWay}"
                                               Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="选项" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <StackPanel Spacing="{StaticResource SpacingXSmall}">
                            <tk:SettingsCard Header="单词数">
                                <NumberBox Width="84"
                                           Minimum="3"
                                           Maximum="20"
                                           SpinButtonPlacementMode="Inline"
                                           AutomationProperties.AutomationId="PassphraseWordCountNumberBox"
                                           Value="{x:Bind ViewModel.PassphraseWordCountValue, Mode=TwoWay}" />
                            </tk:SettingsCard>

                            <tk:SettingsCard Header="单词分隔符">
                                <TextBox Width="120"
                                         AutomationProperties.AutomationId="PassphraseSeparatorTextBox"
                                         Text="{x:Bind ViewModel.PassphraseSeparator, Mode=TwoWay}" />
                            </tk:SettingsCard>

                            <tk:SettingsCard Header="首字母大写">
                                <ToggleSwitch AutomationProperties.AutomationId="PassphraseCapitalizeToggle"
                                              IsOn="{x:Bind ViewModel.PassphraseCapitalize, Mode=TwoWay}" />
                            </tk:SettingsCard>

                            <tk:SettingsCard Header="包含数字">
                                <ToggleSwitch AutomationProperties.AutomationId="PassphraseIncludeNumberToggle"
                                              IsOn="{x:Bind ViewModel.PassphraseIncludeNumber, Mode=TwoWay}" />
                            </tk:SettingsCard>
                        </StackPanel>
                    </StackPanel>
                </TabViewItem>

                <TabViewItem Header="用户名" IsClosable="False">
                    <StackPanel Spacing="14" Padding="0,12,0,0">
                        <Border Style="{StaticResource CardBorderStyle}"
                                Padding="{StaticResource CardContentPaddingCompact}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.GeneratedPassword, Mode=OneWay}"
                                           FontFamily="{StaticResource MonospaceFontFamily}"
                                           FontSize="20"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Width="36"
                                        Height="32"
                                        Padding="0"
                                        AutomationProperties.Name="重新生成用户名"
                                        ToolTipService.ToolTip="重新生成"
                                        Command="{x:Bind ViewModel.RegenerateCommand}">
                                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                                </Button>
                                <Button Grid.Column="2"
                                        Width="36"
                                        Height="32"
                                        Padding="0"
                                        AutomationProperties.Name="复制用户名"
                                        ToolTipService.ToolTip="复制"
                                        Command="{x:Bind ViewModel.CopyCommand}">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Text="选项" Style="{StaticResource SectionHeaderTextBlockStyle}" />
                        <StackPanel Spacing="{StaticResource SpacingXSmall}">
                            <tk:SettingsCard Header="类型">
                                <TextBlock Text="随机单词"
                                           AutomationProperties.AutomationId="UsernameTypeText" />
                            </tk:SettingsCard>

                            <tk:SettingsCard Header="首字母大写">
                                <ToggleSwitch AutomationProperties.AutomationId="UsernameCapitalizeToggle"
                                              IsOn="{x:Bind ViewModel.UsernameCapitalize, Mode=TwoWay}" />
                            </tk:SettingsCard>

                            <tk:SettingsCard Header="包含数字">
                                <ToggleSwitch AutomationProperties.AutomationId="UsernameIncludeNumberToggle"
                                              IsOn="{x:Bind ViewModel.UsernameIncludeNumber, Mode=TwoWay}" />
                            </tk:SettingsCard>
                        </StackPanel>
                    </StackPanel>
                </TabViewItem>
            </TabView>

            <tk:SettingsCard IsClickEnabled="True"
                             AutomationProperties.AutomationId="GeneratorHistoryCard"
                             Click="OnHistoryClick"
                             Header="生成器历史记录">
                <tk:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE76C;" />
                </tk:SettingsCard.ActionIcon>
            </tk:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
