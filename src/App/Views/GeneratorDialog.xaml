<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="App.Views.GeneratorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App.Views"
    Title="生成器" CloseButtonText="关闭" DefaultButton="Close">
    <ContentDialog.Resources><x:Double x:Key="ContentDialogMaxWidth">620</x:Double></ContentDialog.Resources>
    <ScrollViewer x:Name="GeneratorContent" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <local:GeneratorWorkspace x:Name="Workspace" HistoryRequested="OnHistoryRequested" />
    </ScrollViewer>
</ContentDialog>
