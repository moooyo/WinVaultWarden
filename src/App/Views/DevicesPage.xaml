<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.DevicesPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:App.Converters"
    xmlns:models="using:App.ViewModels.Models"
    Loaded="OnPageLoaded">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="DeviceListRowStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="DeviceTileStyle" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource WardenTileBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DeviceSecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="DeviceActionButtonStyle" TargetType="Button"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalContentAlignment="Stretch"
                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid Padding="40,40,40,48" HorizontalAlignment="Stretch">
        <Border MaxWidth="680" HorizontalAlignment="Stretch">
            <StackPanel>
                <Grid ColumnSpacing="12" Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="L19D246644DD6D801" Text="设备" FontFamily="{StaticResource WardenDisplayFontFamily}"
                               FontSize="28" LineHeight="36" FontWeight="SemiBold" />
                    <ProgressRing x:Uid="LF345497DBE9F0437" x:Name="DevicesBusyRing" Grid.Column="1"
                                  Width="24" Height="24" VerticalAlignment="Center"
                                  AutomationProperties.Name="正在处理设备请求"
                                  IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <InfoBar x:Name="DevicesErrorInfoBar" IsClosable="False" Severity="Error" Background="{ThemeResource WardenCriticalBackgroundBrush}" Margin="0,0,0,16"
                         AutomationProperties.LiveSetting="Assertive"
                         IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <StackPanel Margin="0,0,0,32">
                    <Grid ColumnSpacing="14" Padding="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="LC37CCD8EA70CF362" Text="待处理的登录请求" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button x:Uid="L398F84925E59A42F" Grid.Column="1" AutomationProperties.AutomationId="DevicesRefreshRequestsButton"
                                Content="刷新" AutomationProperties.Name="刷新登录请求" Click="OnRefreshRequestsClick"
                                Style="{StaticResource DeviceActionButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}" />
                    </Grid>
                    <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <StackPanel>
                            <StackPanel x:Name="DevicesLoadingPanel" Padding="0,16"
                                        AutomationProperties.AutomationId="DevicesLoadingPanel"
                                        Visibility="{x:Bind ViewModel.ShowRequestsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock x:Uid="L2E52014C8E21EEEC" Text="正在加载登录请求…" AutomationProperties.LiveSetting="Polite"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border Padding="0,16" BorderThickness="0,0,0,1"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind ViewModel.ShowRequestsEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock x:Uid="LF742C86C68C3152A" x:Name="RequestsEmptyText" Text="当前没有待处理的登录请求。" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <ContentControl x:Name="PendingRequestsRepeater" HorizontalContentAlignment="Stretch"
                                            Visibility="{x:Bind ViewModel.ShowRequestsContent, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                            IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.PendingRequests, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="models:AuthRequestItem">
                                            <Border Style="{StaticResource DeviceListRowStyle}">
                                                <Grid ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource DeviceTileStyle}">
                                                        <FontIcon Glyph="&#xE8EA;" FontSize="16"
                                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                  AutomationProperties.AccessibilityView="Raw" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock FontSize="14" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                                   ToolTipService.ToolTip="{x:Bind DeviceTypeName}">
                                                            <Run Text="{x:Bind DeviceTypeName}" /><Run x:Uid="L5D84194DA69DC009" Text=" 想登录你的账户" />
                                                        </TextBlock>
                                                        <TextBlock Style="{StaticResource DeviceSecondaryTextStyle}"
                                                                   TextTrimming="CharacterEllipsis" MaxLines="1">
                                                            <Run x:Uid="L8F1460B08830E0AA" Text="IP 地址：" /><Run Text="{x:Bind IpAddress}" />
                                                            <Run Text=" · " /><Run Text="{x:Bind CreatedLabel}" />
                                                            <Run Text=" · " /><Run Text="{x:Bind ExpirationLabel, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button x:Uid="L4C5EF1D69BD0BB9C" AutomationProperties.AutomationId="DevicesApproveRequestButton"
                                                                Content="查看" AutomationProperties.Name="查看并核对设备登录请求"
                                                                Tag="{x:Bind}" Click="OnApproveRequestClick"
                                                                Style="{StaticResource DeviceActionButtonStyle}" />
                                                        <Button x:Uid="L4CCE1FC8FBEEBDAD" AutomationProperties.AutomationId="DevicesDenyRequestButton"
                                                                Content="拒绝" AutomationProperties.Name="拒绝设备登录请求"
                                                                Tag="{x:Bind}" Click="OnDenyRequestClick"
                                                                Style="{StaticResource DeviceActionButtonStyle}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ContentControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,0,32">
                    <TextBlock x:Uid="L8A35C7370117AAEE" Text="已登录的设备" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <InfoBar IsOpen="{x:Bind ViewModel.HasDeviceError, Mode=OneWay}" IsClosable="False"
                             Severity="Error" Background="{ThemeResource WardenCriticalBackgroundBrush}" Message="{x:Bind ViewModel.DeviceError, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.HasDeviceError, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <StackPanel>
                            <Border x:Name="DevicesEmptyPanel" Padding="0,16" BorderThickness="0,0,0,1"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock x:Uid="LAF115F08B06D4D48" Text="还没有已登记的设备，登录并同步后会显示在这里。" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Devices}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:DeviceItem">
                                        <Border Style="{StaticResource DeviceListRowStyle}">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource DeviceTileStyle}">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16"
                                                              AutomationProperties.AccessibilityView="Raw" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <Grid ColumnSpacing="8" HorizontalAlignment="Left">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Name}" FontSize="14" TextTrimming="CharacterEllipsis" MaxLines="1"
                                                                   ToolTipService.ToolTip="{x:Bind Name}" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock x:Uid="LA06A2A164D0132E3" Text="· 当前设备" Style="{StaticResource DeviceSecondaryTextStyle}"
                                                                       Visibility="{x:Bind IsCurrent, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock x:Uid="LA9817A4C0600E378" Text="· 受信任" Style="{StaticResource DeviceSecondaryTextStyle}"
                                                                       Visibility="{x:Bind IsTrusted, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind RegisteredLabel}" Style="{StaticResource DeviceSecondaryTextStyle}"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                                               ToolTipService.ToolTip="{x:Bind RegisteredLabel}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
        </Grid>
    </ScrollViewer>
</Page>
