<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.GeneratorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App.Views"
    Background="{ThemeResource LayerFillColorDefaultBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageLayout" Padding="32" MaxWidth="1160" HorizontalAlignment="Stretch" RowSpacing="24" ColumnSpacing="28" SizeChanged="OnLayoutSizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Grid.ColumnSpan="2" Spacing="6">
                <TextBlock Text="生成器" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="为每个账户创建独立的密码、密码短语或用户名。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <local:GeneratorWorkspace x:Name="Workspace" Grid.Row="1" HistoryRequested="OnHistoryRequested" />
            <Border x:Name="GuidanceRail" Grid.Row="1" Grid.Column="1" Width="216" Padding="24,16,0,0" Margin="0,50,0,0"
                    BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Top">
                <StackPanel Spacing="16">
                    <FontIcon Glyph="&#xE8D7;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Left" />
                    <TextBlock Text="每个账户，独立密码" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="在网站上更新密码后，记得将生成的密码保存到对应的保险库条目。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="切换类型或返回页面时保留当前结果。需要新结果时，选择“重新生成”。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="在设备本地生成" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
