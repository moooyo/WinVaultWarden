<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.GeneratorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App.Views"
    Background="Transparent">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageLayout" Padding="40,40,40,48" HorizontalAlignment="Stretch" SizeChanged="OnLayoutSizeChanged">
            <local:GeneratorWorkspace x:Name="Workspace" MaxWidth="640" HorizontalAlignment="Stretch" HistoryRequested="OnHistoryRequested" NewLoginRequested="OnNewLoginRequested" />
        </Grid>
    </ScrollViewer>
</Page>
