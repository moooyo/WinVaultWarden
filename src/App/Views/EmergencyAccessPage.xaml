<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.EmergencyAccessPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:App.Converters"
    xmlns:models="using:Core.Models"
    xmlns:viewModels="using:App.ViewModels.Models"
    xmlns:local="using:App.Views"
    Loaded="OnPageLoaded">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate x:Key="RecoveredCipherItemTemplate"
                      x:DataType="viewModels:RecoveredCipherListItem">
            <StackPanel Spacing="2" Padding="0,6">
                <TextBlock Text="{x:Bind Name}"
                           FontWeight="SemiBold"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Subtitle}"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource PageContentPadding}">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="紧急访问" Style="{ThemeResource TitleTextBlockStyle}" />

            <!-- 操作错误提示（Remove/Reject/Invite/Update 等失败原因） -->
            <InfoBar x:Name="EmergencyErrorBar"
                     IsClosable="True"
                     Severity="Error"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.OperationError, Mode=OneWay}" />

            <!-- 忙碌指示 -->
            <ProgressRing x:Name="EmergencyBusyRing"
                          Width="24" Height="24"
                          HorizontalAlignment="Left"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <Button AutomationProperties.AutomationId="EmergencyInviteButton"
                    Content="邀请紧急联系人"
                    Style="{ThemeResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}"
                    Click="OnInviteClick" />

            <!-- ══════ 页面四态：Loading / Error / Empty / Content ══════════════ -->

            <StackPanel x:Name="EmergencyLoadingPanel"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressRing IsActive="True" Width="24" Height="24"
                              AutomationProperties.Name="正在加载紧急访问" />
            </StackPanel>

            <StackPanel x:Name="EmergencyLoadErrorPanel"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="加载紧急访问信息失败，请稍后重试。"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
            </StackPanel>

            <StackPanel x:Name="EmergencyEmptyPanel"
                        Spacing="8"
                        AutomationProperties.AutomationId="EmergencyEmptyPanel"
                        Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="尚未设置任何紧急联系人。"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                <TextBlock Text="没有账户将您设为紧急联系人。"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
            </StackPanel>

            <StackPanel x:Name="EmergencyContentPanel"
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay, Converter={StaticResource BoolToVis}}">

                <!-- ══════ 授予方视角：我的紧急联系人 ══════════════════════════ -->
                <StackPanel Spacing="8">
                    <TextBlock Text="我的紧急联系人（授予方）"
                               Style="{StaticResource SectionHeaderTextBlockStyle}" />

                    <!-- 本节空状态（另一节仍可能有内容，PageState 仍为 Content） -->
                    <TextBlock x:Name="ContactsEmptyText"
                               Text="尚未设置任何紧急联系人。"
                               Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.HasNoContacts, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                    <ListView x:Name="MyContactsList"
                              ItemsSource="{x:Bind ViewModel.MyContacts, Mode=OneWay}"
                              SelectionMode="None"
                              IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:EmergencyContact">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}"
                                        Padding="{StaticResource CardContentPadding}"
                                        Margin="0,0,0,8"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!-- 联系人信息 -->
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Email}" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Status}"
                                                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                                <TextBlock Text="|"
                                                           Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind Type}"
                                                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- 操作按钮：只显示当前状态允许的命令 -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                            <Button AutomationProperties.AutomationId="EmergencyConfirmButton"
                                                    Content="确认"
                                                    Tag="{x:Bind}"
                                                    Click="OnConfirmClick"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowConfirm(Status), Mode=OneTime}" />
                                            <Button AutomationProperties.AutomationId="EmergencyReinviteButton"
                                                    Content="重新邀请"
                                                    Tag="{x:Bind}"
                                                    Click="OnReinviteClick"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowReinvite(Status), Mode=OneTime}" />
                                            <Button AutomationProperties.AutomationId="EmergencyApproveButton"
                                                    Content="批准"
                                                    Tag="{x:Bind}"
                                                    Click="OnApproveClick"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowApprove(Status), Mode=OneTime}" />
                                            <Button AutomationProperties.AutomationId="EmergencyRejectButton"
                                                    Content="拒绝"
                                                    Tag="{x:Bind}"
                                                    Click="OnRejectClick"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowReject(Status), Mode=OneTime}" />
                                            <Button AutomationProperties.AutomationId="EmergencyRemoveContactButton"
                                                    Content="移除"
                                                    Tag="{x:Bind}"
                                                    Click="OnRemoveContactClick"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowRemove(Status), Mode=OneTime}" />
                                            <Button AutomationProperties.AutomationId="EmergencyUpdateButton"
                                                    Content="修改"
                                                    Tag="{x:Bind}"
                                                    Click="OnUpdateClick"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowUpdate(Status), Mode=OneTime}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- ══════ 受托方视角：信任我的账户 ═══════════════════════════════ -->
                <StackPanel Spacing="8">
                    <TextBlock Text="信任我的账户（受托方）"
                               Style="{StaticResource SectionHeaderTextBlockStyle}" />

                    <TextBlock x:Name="GrantedEmptyText"
                               Text="没有账户将您设为紧急联系人。"
                               Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.HasNoGranted, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                    <ListView x:Name="TrustedByOthersList"
                              ItemsSource="{x:Bind ViewModel.TrustedByOthers, Mode=OneWay}"
                              SelectionMode="None"
                              IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GrantedAccess">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}"
                                        Padding="{StaticResource CardContentPadding}"
                                        Margin="0,0,0,8"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!-- 授予方信息 -->
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Email}" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Status}"
                                                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                                <TextBlock Text="|"
                                                           Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind Type}"
                                                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- 操作按钮：只显示当前状态允许的命令 -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                            <Button AutomationProperties.AutomationId="EmergencyInitiateButton"
                                                    Content="发起紧急访问"
                                                    Tag="{x:Bind}"
                                                    Click="OnInitiateClick"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowInitiate(Status), Mode=OneTime}" />
                                            <Button AutomationProperties.AutomationId="EmergencyViewButton"
                                                    Content="查看密码库"
                                                    Tag="{x:Bind}"
                                                    Click="OnViewClick"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowView(Status, Type), Mode=OneTime}" />
                                            <Button AutomationProperties.AutomationId="EmergencyTakeoverButton"
                                                    Content="接管账户"
                                                    Tag="{x:Bind}"
                                                    Click="OnTakeoverClick"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowTakeover(Status, Type), Mode=OneTime}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- ══════ 已恢复的密码库（View 命令本次结果，只读）══════════════ -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.HasRecoveredItems, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="已恢复的密码库条目（只读）"
                               Style="{StaticResource SectionHeaderTextBlockStyle}" />
                    <ListView x:Name="RecoveredItemsList"
                              ItemsSource="{x:Bind ViewModel.RecoveredItems, Mode=OneWay}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RecoveredVault">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}"
                                        Padding="{StaticResource CardContentPadding}"
                                        Margin="0,0,0,8"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind GrantorEmail}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource CaptionSecondaryTextBlockStyle}">
                                            <Run Text="条目数：" />
                                            <Run Text="{x:Bind Ciphers.Count}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
