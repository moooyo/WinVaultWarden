<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.EmergencyAccessPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:App.Converters"
    xmlns:models="using:Core.Models"
    xmlns:viewModels="using:App.ViewModels.Models"
    xmlns:local="using:App.Views"
    Loaded="OnPageLoaded">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate x:Key="RecoveredCipherItemTemplate"
                      x:DataType="viewModels:RecoveredCipherListItem">
            <StackPanel Spacing="2" Padding="0,6">
                <TextBlock Text="{x:Bind Name}"
                           FontWeight="SemiBold"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Subtitle}"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource PageContentPadding}" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" MaxWidth="1000" HorizontalAlignment="Stretch">

                        <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <HyperlinkButton Content="设置" Click="OnBackToSettingsClick" Padding="0,4"
                                     AutomationProperties.Name="返回设置" />
                    <FontIcon Glyph="&#xE76C;" FontSize="10" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="紧急访问" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="紧急访问" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="选择可信任的联系人，在紧急情况下按约定权限访问您的个人密码库。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardContentPadding}">
                <StackPanel Spacing="12">
                    <TextBlock Text="授权范围" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="查看：获得访问授权后，可读取个人密码库。" TextWrapping="Wrap" />
                    <TextBlock Text="接管：可重置主密码并控制账户；还会停用该账户的两步登录，并移除该账户在非所有者组织中的成员资格。" TextWrapping="Wrap" />
                    <TextBlock Text="联系人发起请求后，需等待设置的天数；您可以在等待期间批准或拒绝。邀请被接受并由您确认后，授权才生效。"
                               Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                </StackPanel>
            </Border>


            <InfoBar x:Name="EmergencyErrorBar"
                     IsClosable="False"
                     Severity="Error"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.OperationError, Mode=OneWay}" AutomationProperties.LiveSetting="Assertive" />


            <ProgressRing x:Name="EmergencyBusyRing"
                          Width="24" Height="24"
                          HorizontalAlignment="Left"
                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" AutomationProperties.Name="正在处理紧急访问" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <StackPanel Orientation="Horizontal" Spacing="8"><Button AutomationProperties.AutomationId="EmergencyInviteButton"
                    Content="邀请紧急联系人"
                    Style="{ThemeResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}"
                    Click="OnInviteClick" /><Button Content="刷新" Click="OnRetryClick" IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}" AutomationProperties.Name="刷新紧急访问" /></StackPanel>



            <StackPanel x:Name="EmergencyLoadingPanel"
                        HorizontalAlignment="Left"
                        Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <ProgressRing IsActive="True" Width="24" Height="24"
                              AutomationProperties.Name="正在加载紧急访问" />
            </StackPanel>

            <StackPanel x:Name="EmergencyLoadErrorPanel"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="无法显示紧急访问信息。请检查连接后点击刷新。"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
            </StackPanel>

            <StackPanel x:Name="EmergencyEmptyPanel"
                        Spacing="8"
                        AutomationProperties.AutomationId="EmergencyEmptyPanel"
                        Visibility="{x:Bind ViewModel.ShowEmpty, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="尚未设置任何紧急联系人。"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                <TextBlock Text="没有账户将您设为紧急联系人。"
                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
            </StackPanel>

            <StackPanel x:Name="EmergencyContentPanel"
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.ShowContent, Mode=OneWay, Converter={StaticResource BoolToVis}}">


                <StackPanel Spacing="8">
                    <TextBlock Text="我的紧急联系人"
                               Style="{StaticResource SectionHeaderTextBlockStyle}" />


                    <TextBlock x:Name="ContactsEmptyText"
                               Text="尚未设置任何紧急联系人。"
                               Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.HasNoContacts, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                    <ListView x:Name="MyContactsList"
                              ItemsSource="{x:Bind ViewModel.MyContacts, Mode=OneWay}"
                              SelectionMode="None"
                              IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:EmergencyContact">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}"
                                        Padding="{StaticResource CardContentPadding}"
                                        Margin="0,0,0,8"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind Email}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind local:EmergencyAccessPage.FormatStatus(Status)}"
                                                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                                <TextBlock Text="|"
                                                           Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind local:EmergencyAccessPage.FormatAccessType(Type)}"
                                                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind local:EmergencyAccessPage.FormatWaitTime(WaitTimeDays)}" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind local:EmergencyAccessPage.FormatStatusHelp(Status, Type)}" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                            <Button AutomationProperties.AutomationId="EmergencyConfirmButton"
                                                    Content="确认联系人"
                                                    Tag="{x:Bind}"
                                                    Click="OnConfirmClick"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowConfirm(Status), Mode=OneTime}" />
                                            <Button AutomationProperties.AutomationId="EmergencyReinviteButton"
                                                    Content="重新邀请"
                                                    Tag="{x:Bind}"
                                                    Click="OnReinviteClick"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowReinvite(Status), Mode=OneTime}" />
                                            <Button AutomationProperties.AutomationId="EmergencyApproveButton"
                                                    Content="立即批准访问"
                                                    Tag="{x:Bind}"
                                                    Click="OnApproveClick"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowApprove(Status), Mode=OneTime}" />
                                            <Button AutomationProperties.AutomationId="EmergencyRejectButton"
                                                    Content="拒绝"
                                                    Tag="{x:Bind}"
                                                    Click="OnRejectClick"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowReject(Status), Mode=OneTime}" />
                                            <Button AutomationProperties.AutomationId="EmergencyRemoveContactButton"
                                                    Content="移除"
                                                    Tag="{x:Bind}"
                                                    Click="OnRemoveContactClick"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowRemove(Status), Mode=OneTime}" />
                                            <Button AutomationProperties.AutomationId="EmergencyUpdateButton"
                                                    Content="修改权限"
                                                    Tag="{x:Bind}"
                                                    Click="OnUpdateClick"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowUpdate(Status), Mode=OneTime}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>


                <StackPanel Spacing="8">
                    <TextBlock Text="信任我的账户"
                               Style="{StaticResource SectionHeaderTextBlockStyle}" />

                    <TextBlock x:Name="GrantedEmptyText"
                               Text="没有账户将您设为紧急联系人。"
                               Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.HasNoGranted, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                    <ListView x:Name="TrustedByOthersList"
                              ItemsSource="{x:Bind ViewModel.TrustedByOthers, Mode=OneWay}"
                              SelectionMode="None"
                              IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GrantedAccess">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}"
                                        Padding="{StaticResource CardContentPadding}"
                                        Margin="0,0,0,8"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind Email}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind local:EmergencyAccessPage.FormatStatus(Status)}"
                                                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                                <TextBlock Text="|"
                                                           Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind local:EmergencyAccessPage.FormatAccessType(Type)}"
                                                           Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind local:EmergencyAccessPage.FormatWaitTime(WaitTimeDays)}" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind local:EmergencyAccessPage.FormatStatusHelp(Status, Type)}" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                            <Button AutomationProperties.AutomationId="EmergencyInitiateButton"
                                                    Content="发起紧急访问"
                                                    Tag="{x:Bind}"
                                                    Click="OnInitiateClick"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowInitiate(Status), Mode=OneTime}" />
                                            <Button AutomationProperties.AutomationId="EmergencyViewButton"
                                                    Content="读取密码库"
                                                    Tag="{x:Bind}"
                                                    Click="OnViewClick"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowView(Status, Type), Mode=OneTime}" />
                                            <Button AutomationProperties.AutomationId="EmergencyTakeoverButton"
                                                    Content="接管账户"
                                                    Tag="{x:Bind}"
                                                    Click="OnTakeoverClick"
                                                    Visibility="{x:Bind local:EmergencyAccessPage.ShowTakeover(Status, Type), Mode=OneTime}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>


                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.HasRecoveredItems, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="已恢复的密码库条目（只读）"
                               Style="{StaticResource SectionHeaderTextBlockStyle}" />
                    <ListView x:Name="RecoveredItemsList"
                              ItemsSource="{x:Bind ViewModel.RecoveredItems, Mode=OneWay}"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RecoveredVault">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CardCornerRadius}"
                                        Padding="{StaticResource CardContentPadding}"
                                        Margin="0,0,0,8"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind GrantorEmail}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource CaptionSecondaryTextBlockStyle}">
                                            <Run Text="条目数：" />
                                            <Run Text="{x:Bind Ciphers.Count}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
