<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.EmergencyAccessPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:App.Converters"
    xmlns:models="using:Core.Models"
    xmlns:viewModels="using:App.ViewModels.Models"
    xmlns:local="using:App.Views"
    Loaded="OnPageLoaded">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="EmergencyRowStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="EmergencyItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
        <Style x:Key="EmergencyActionStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="EmergencyDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="EmergencyEmptyStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <DataTemplate x:Key="RecoveredCipherItemTemplate" x:DataType="viewModels:RecoveredCipherListItem">
            <StackPanel Spacing="2" Padding="0,6">
                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                           MaxLines="1" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Grid Padding="40,8,40,48" HorizontalAlignment="Stretch">
        <Border MaxWidth="680" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="指定信任的人。对方发起请求后，如果你在等待期内没有拒绝，对方就能查看或接管你的密码库。"
                           MaxWidth="600" HorizontalAlignment="Left" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Margin="0,28,0,0">
                    <InfoBar x:Name="EmergencyErrorBar" IsClosable="False" Severity="Error" Margin="0,0,0,12"
                             IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                             Message="{x:Bind ViewModel.OperationError, Mode=OneWay}" AutomationProperties.LiveSetting="Assertive" />
                    <ProgressRing x:Name="EmergencyBusyRing" Width="24" Height="24" HorizontalAlignment="Left" Margin="0,0,0,12"
                                  IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" AutomationProperties.Name="正在处理紧急访问"
                                  Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <StackPanel x:Name="EmergencyLoadingPanel" Visibility="{x:Bind ViewModel.ShowLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="正在加载紧急访问…" Margin="0,0,0,16"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel x:Name="EmergencyLoadErrorPanel" Spacing="12" Margin="0,0,0,24"
                                Visibility="{x:Bind ViewModel.ShowError, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="无法显示紧急访问信息。请检查连接后重试。" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="重试" Click="OnRetryClick" Style="{StaticResource EmergencyActionStyle}"
                                IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel x:Name="EmergencyContentPanel"
                                Visibility="{x:Bind local:EmergencyAccessPage.ShowLists(ViewModel.ShowContent, ViewModel.ShowEmpty), Mode=OneWay}">
                        <StackPanel Margin="0,0,0,32">
                            <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="你信任的人" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <HyperlinkButton Grid.Column="1" Content="刷新" Padding="8,4" Margin="0,-4,0,-4"
                                                 Click="OnRetryClick" IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}"
                                                 AutomationProperties.Name="刷新紧急访问" />
                                <HyperlinkButton Grid.Column="2" Content="添加…" Padding="8,4" Margin="0,-4,-8,-4"
                                                 AutomationProperties.AutomationId="EmergencyInviteButton" Click="OnInviteClick"
                                                 IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}" />
                            </Grid>
                            <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <Border x:Name="EmergencyEmptyPanel" BorderThickness="0,0,0,1"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            AutomationProperties.AutomationId="EmergencyEmptyPanel"
                                            Visibility="{x:Bind ViewModel.HasNoContacts, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <TextBlock x:Name="ContactsEmptyText" Text="还没有紧急联系人" Style="{StaticResource EmergencyEmptyStyle}" />
                                    </Border>
                                    <ListView x:Name="MyContactsList" ItemsSource="{x:Bind ViewModel.MyContacts, Mode=OneWay}"
                                              SelectionMode="None" ItemContainerStyle="{StaticResource EmergencyItemStyle}"
                                              IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:EmergencyContact">
                                                <Border Style="{StaticResource EmergencyRowStyle}">
                                                    <Grid ColumnSpacing="14">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Border Width="32" Height="32" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                            <Grid>
                                                                <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                          Visibility="{x:Bind local:EmergencyAccessPage.ShowDefaultContactIcon(Status)}" AutomationProperties.AccessibilityView="Raw" />
                                                                <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                          Visibility="{x:Bind local:EmergencyAccessPage.ShowApprove(Status)}" AutomationProperties.AccessibilityView="Raw" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{x:Bind local:EmergencyAccessPage.FormatContactName(Name, Email)}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind local:EmergencyAccessPage.FormatContactAccess(Type)}"
                                                                           FontSize="12" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Grid>
                                                            <TextBlock Text="{x:Bind local:EmergencyAccessPage.FormatContactDetail(Email, Status, WaitTimeDays)}"
                                                                       ToolTipService.ToolTip="{x:Bind local:EmergencyAccessPage.FormatContactDetail(Email, Status, WaitTimeDays)}"
                                                                       Style="{StaticResource CaptionSecondaryTextBlockStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Button Content="重新发送" Tag="{x:Bind}" Click="OnReinviteClick" Style="{StaticResource EmergencyActionStyle}"
                                                                    AutomationProperties.AutomationId="EmergencyReinviteButton" Visibility="{x:Bind local:EmergencyAccessPage.ShowReinvite(Status)}" />
                                                            <Button Content="修改…" Tag="{x:Bind}" Click="OnUpdateClick" Style="{StaticResource EmergencyActionStyle}"
                                                                    AutomationProperties.AutomationId="EmergencyUpdateButton" Visibility="{x:Bind local:EmergencyAccessPage.ShowUpdate(Status)}" />
                                                            <Button Content="移除" Tag="{x:Bind}" Click="OnRemoveContactClick" Style="{StaticResource EmergencyActionStyle}"
                                                                    AutomationProperties.AutomationId="EmergencyRemoveContactButton" Visibility="{x:Bind local:EmergencyAccessPage.ShowRemove(Status)}" />
                                                            <Button Content="拒绝" Tag="{x:Bind}" Click="OnRejectClick" Style="{StaticResource EmergencyActionStyle}"
                                                                    AutomationProperties.AutomationId="EmergencyRejectButton" Visibility="{x:Bind local:EmergencyAccessPage.ShowReject(Status)}" />
                                                            <Button Content="确认" Tag="{x:Bind}" Click="OnConfirmClick" Style="{ThemeResource AccentButtonStyle}" Height="32" Padding="12,0"
                                                                    AutomationProperties.AutomationId="EmergencyConfirmButton" Visibility="{x:Bind local:EmergencyAccessPage.ShowConfirm(Status)}" />
                                                            <Button Content="批准" Tag="{x:Bind}" Click="OnApproveClick" Style="{ThemeResource AccentButtonStyle}" Height="32" Padding="12,0"
                                                                    AutomationProperties.AutomationId="EmergencyApproveButton" Visibility="{x:Bind local:EmergencyAccessPage.ShowApprove(Status)}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,32">
                            <TextBlock Text="信任你的人" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                            <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            Visibility="{x:Bind ViewModel.HasNoGranted, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <TextBlock x:Name="GrantedEmptyText" Text="还没有人把你设为紧急联系人" Style="{StaticResource EmergencyEmptyStyle}" />
                                    </Border>
                                    <ListView x:Name="TrustedByOthersList" ItemsSource="{x:Bind ViewModel.TrustedByOthers, Mode=OneWay}"
                                              SelectionMode="None" ItemContainerStyle="{StaticResource EmergencyItemStyle}"
                                              IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:GrantedAccess">
                                                <Border Style="{StaticResource EmergencyRowStyle}">
                                                    <Grid ColumnSpacing="14">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Border Width="32" Height="32" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{x:Bind local:EmergencyAccessPage.FormatContactName(Name, Email)}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind local:EmergencyAccessPage.FormatGrantedAccess(Type)}"
                                                                           FontSize="12" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Grid>
                                                            <TextBlock Text="{x:Bind local:EmergencyAccessPage.FormatGrantedDetail(Email, Status, WaitTimeDays)}"
                                                                       ToolTipService.ToolTip="{x:Bind local:EmergencyAccessPage.FormatGrantedDetail(Email, Status, WaitTimeDays)}"
                                                                       Style="{StaticResource CaptionSecondaryTextBlockStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Button Content="请求访问…" Tag="{x:Bind}" Click="OnInitiateClick" Style="{StaticResource EmergencyActionStyle}"
                                                                    AutomationProperties.AutomationId="EmergencyInitiateButton" Visibility="{x:Bind local:EmergencyAccessPage.ShowInitiate(Status)}" />
                                                            <Button Content="查看密码库" Tag="{x:Bind}" Click="OnViewClick" Style="{StaticResource EmergencyActionStyle}"
                                                                    AutomationProperties.AutomationId="EmergencyViewButton" Visibility="{x:Bind local:EmergencyAccessPage.ShowView(Status, Type)}" />
                                                            <Button Content="接管账户" Tag="{x:Bind}" Click="OnTakeoverClick" Style="{StaticResource EmergencyActionStyle}"
                                                                    AutomationProperties.AutomationId="EmergencyTakeoverButton" Visibility="{x:Bind local:EmergencyAccessPage.ShowTakeover(Status, Type)}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{x:Bind ViewModel.HasRecoveredItems, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="已恢复的密码库 · 只读" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                            <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <ListView x:Name="RecoveredItemsList" ItemsSource="{x:Bind ViewModel.RecoveredItems, Mode=OneWay}"
                                          SelectionMode="None" ItemContainerStyle="{StaticResource EmergencyItemStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:RecoveredVault">
                                            <Border Style="{StaticResource EmergencyRowStyle}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind GrantorEmail}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{StaticResource CaptionSecondaryTextBlockStyle}">
                                                        <Run Text="条目数：" /><Run Text="{x:Bind Ciphers.Count}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        </Grid>
    </ScrollViewer>
</Page>
