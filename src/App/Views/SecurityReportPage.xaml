<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.SecurityReportPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:App.Converters"
    xmlns:models="using:Core.Models"
    xmlns:local="using:App.Views"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource PageContentPadding}"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <!-- Grid wrapper works around SettingsExpander expand glitch under a MaxWidth StackPanel (microsoft-ui-xaml#3842) -->
        <Grid>
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

        <TextBlock Text="安全报告"
                   Style="{ThemeResource TitleTextBlockStyle}"
                   Margin="0,0,0,12" />

        <Grid>

        <!-- ── 离线分析:加载中 ─────────────────────────────────────────── -->
        <StackPanel x:Name="OfflineLoadingPanel"
                    Spacing="8"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.ShowOfflineLoading, Mode=OneWay,
                        Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing Width="24"
                              Height="24"
                              IsActive="True"
                              AutomationProperties.Name="正在分析安全报告" />
                <TextBlock Text="正在分析安全报告…"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <ProgressBar Minimum="0"
                         Maximum="100"
                         AutomationProperties.Name="安全报告分析进度"
                         Value="{x:Bind ViewModel.OfflineProgress, Mode=OneWay}" />
        </StackPanel>

        <!-- ── 离线分析:错误 + 重试 ────────────────────────────────────── -->
        <StackPanel x:Name="OfflineErrorPanel"
                    Spacing="8"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.ShowOfflineError, Mode=OneWay,
                        Converter={StaticResource BoolToVis}}">
            <InfoBar Severity="Error"
                     IsOpen="True"
                     AutomationProperties.LiveSetting="Assertive"
                     Message="{x:Bind ViewModel.OfflineError, Mode=OneWay}" />
            <Button x:Name="SecurityReportRetryButton"
                    Content="重试"
                    Command="{x:Bind ViewModel.RetryOfflineCommand}"
                    AutomationProperties.AutomationId="SecurityReportRetryButton" />
        </StackPanel>

        <StackPanel x:Name="OfflineContentPanel"
                    Spacing="4"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.ShowOfflineContent, Mode=OneWay,
                        Converter={StaticResource BoolToVis}}">

            <!-- ── Hero:密码库健康摘要 ─────────────────────────────────────── -->
            <Border Style="{StaticResource CardBorderStyle}"
                    Padding="{StaticResource CardContentPadding}"
                    Margin="0,0,0,12">
                <Grid x:Name="HealthSummaryGrid" ColumnSpacing="16">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="HealthSummaryLayoutStates">
                            <VisualState x:Name="WideHealthSummary">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="760" />
                                </VisualState.StateTriggers>
                            </VisualState>
                            <VisualState x:Name="NarrowHealthSummary">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="HealthMetricsPanel.(Grid.Row)" Value="1" />
                                    <Setter Target="HealthMetricsPanel.(Grid.Column)" Value="0" />
                                    <Setter Target="HealthMetricsPanel.(Grid.ColumnSpan)" Value="3" />
                                    <Setter Target="HealthMetricsPanel.HorizontalAlignment" Value="Stretch" />
                                    <Setter Target="HealthMetricsPanel.Margin" Value="0,12,0,0" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE72E;"
                              FontSize="28"
                              VerticalAlignment="Center"
                              AutomationProperties.AccessibilityView="Raw"
                              Foreground="{x:Bind ViewModel.OverallSeverity, Mode=OneWay,
                                  Converter={StaticResource SeverityToBrush}}" />

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="密码库健康" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Grid x:Name="HealthMetricsPanel"
                          Grid.Column="2"
                          ColumnSpacing="12"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Center">
                            <InfoBadge HorizontalAlignment="Center"
                                       Value="{x:Bind ViewModel.ReusedCount, Mode=OneWay}" />
                            <TextBlock Text="重复" HorizontalAlignment="Center"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
                            <InfoBadge HorizontalAlignment="Center"
                                       Value="{x:Bind ViewModel.WeakCount, Mode=OneWay}" />
                            <TextBlock Text="弱" HorizontalAlignment="Center"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Center">
                            <InfoBadge HorizontalAlignment="Center"
                                       Value="{x:Bind ViewModel.UnsecuredCount, Mode=OneWay}" />
                            <TextBlock Text="不安全" HorizontalAlignment="Center"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="4" HorizontalAlignment="Center">
                            <Grid HorizontalAlignment="Center">
                                <InfoBadge HorizontalAlignment="Center"
                                           Value="{x:Bind ViewModel.ExposedCount, Mode=OneWay}"
                                           AutomationProperties.Name="{x:Bind ViewModel.ExposureMetricAccessibleName, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.ShowExposedCount, Mode=OneWay,
                                               Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{x:Bind ViewModel.ExposureStatusLabel, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           AutomationProperties.Name="{x:Bind ViewModel.ExposureMetricAccessibleName, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.ShowExposedCount, Mode=OneWay,
                                               Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>
                            <TextBlock Text="暴露" HorizontalAlignment="Center"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── 1. 重复密码 ─────────────────────────────────────────── -->
            <tk:SettingsExpander Header="重复密码"
                                 Description="多个条目使用了相同的密码,建议为每个账号设置不同密码"
                                 ItemsSource="{x:Bind ViewModel.ReusedGroups, Mode=OneWay}">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8FD;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </tk:SettingsExpander.HeaderIcon>
                <InfoBadge Value="{x:Bind ViewModel.ReusedCount, Mode=OneWay}" />
                <tk:SettingsExpander.ItemTemplate>
                    <DataTemplate x:DataType="models:ReusedGroup">
                        <tk:SettingsCard Header="{x:Bind local:SecurityReportPage.FormatReusedHeader(Count)}">
                            <ItemsRepeater ItemsSource="{x:Bind Items}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:HealthItemRef">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                            <FontIcon Glyph="&#xE7B7;" FontSize="12"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Name}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Username}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </tk:SettingsCard>
                    </DataTemplate>
                </tk:SettingsExpander.ItemTemplate>
                <tk:SettingsExpander.ItemsFooter>
                    <TextBlock Text="未发现重复密码"
                               Margin="16,10"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind ViewModel.HasReused, Mode=OneWay,
                                   Converter={StaticResource InverseBoolToVis}}" />
                </tk:SettingsExpander.ItemsFooter>
            </tk:SettingsExpander>

            <!-- ── 2. 弱密码 ──────────────────────────────────────────── -->
            <tk:SettingsExpander Header="弱密码"
                                 Description="密码强度不足,容易被破解,建议更换为更复杂的密码"
                                 ItemsSource="{x:Bind ViewModel.WeakItems, Mode=OneWay}">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE814;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </tk:SettingsExpander.HeaderIcon>
                <InfoBadge Value="{x:Bind ViewModel.WeakCount, Mode=OneWay}" />
                <tk:SettingsExpander.ItemTemplate>
                    <DataTemplate x:DataType="models:WeakFinding">
                        <tk:SettingsCard Header="{x:Bind Item.Name}" Description="{x:Bind Item.Username}">
                            <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                    CornerRadius="4" Padding="8,2">
                                <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           FontSize="12" FontWeight="SemiBold">
                                    <Run Text="强度 " />
                                    <Run Text="{x:Bind Score}" />
                                    <Run Text="/4" />
                                </TextBlock>
                            </Border>
                        </tk:SettingsCard>
                    </DataTemplate>
                </tk:SettingsExpander.ItemTemplate>
                <tk:SettingsExpander.ItemsFooter>
                    <TextBlock Text="未发现弱密码"
                               Margin="16,10"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind ViewModel.HasWeak, Mode=OneWay,
                                   Converter={StaticResource InverseBoolToVis}}" />
                </tk:SettingsExpander.ItemsFooter>
            </tk:SettingsExpander>

            <!-- ── 3. 不安全网站 ───────────────────────────────────────── -->
            <tk:SettingsExpander Header="不安全网站 (HTTP)"
                                 Description="网站未使用加密连接,密码可能在传输中被截获"
                                 ItemsSource="{x:Bind ViewModel.UnsecuredItems, Mode=OneWay}">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE728;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </tk:SettingsExpander.HeaderIcon>
                <InfoBadge Value="{x:Bind ViewModel.UnsecuredCount, Mode=OneWay}" />
                <tk:SettingsExpander.ItemTemplate>
                    <DataTemplate x:DataType="models:UnsecuredFinding">
                        <tk:SettingsCard Header="{x:Bind Item.Name}" Description="{x:Bind Item.Username}">
                            <TextBlock Text="{x:Bind Uri}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="280" />
                        </tk:SettingsCard>
                    </DataTemplate>
                </tk:SettingsExpander.ItemTemplate>
                <tk:SettingsExpander.ItemsFooter>
                    <TextBlock Text="未发现不安全的 HTTP 网站"
                               Margin="16,10"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind ViewModel.HasUnsecured, Mode=OneWay,
                                   Converter={StaticResource InverseBoolToVis}}" />
                </tk:SettingsExpander.ItemsFooter>
            </tk:SettingsExpander>

            <!-- ── 4. 暴露密码 (HIBP) ─────────────────────────────────── -->
            <tk:SettingsExpander Header="暴露密码"
                                 Description="在已知数据泄露事件中出现的密码,建议立即修改"
                                 IsExpanded="True"
                                 ItemsSource="{x:Bind ViewModel.ExposedItems, Mode=OneWay}">
                <tk:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xEA18;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </tk:SettingsExpander.HeaderIcon>
                <Grid>
                    <InfoBadge Value="{x:Bind ViewModel.ExposedCount, Mode=OneWay}"
                               AutomationProperties.Name="{x:Bind ViewModel.ExposureMetricAccessibleName, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.ShowExposedCount, Mode=OneWay,
                                   Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{x:Bind ViewModel.ExposureStatusLabel, Mode=OneWay}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="{x:Bind ViewModel.ExposureMetricAccessibleName, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.ShowExposedCount, Mode=OneWay,
                                   Converter={StaticResource InverseBoolToVis}}" />
                </Grid>

                <tk:SettingsExpander.ItemsHeader>
                    <StackPanel Spacing="8" Padding="16,12,16,4">
                        <TextBlock Text="{x:Bind ViewModel.ExposureStatusMessage, Mode=OneWay}"
                                   Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="仅发送密码哈希前 5 位到 Have I Been Pwned，绝不发送密码本身"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind ViewModel.ExposedChecked, Mode=OneWay,
                                       Converter={StaticResource InverseBoolToVis}}" />
                        <Button Content="运行检查"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.RunExposedCheckCommand}"
                                AutomationProperties.AutomationId="RunExposedCheckButton"
                                HorizontalAlignment="Left"
                                Visibility="{x:Bind ViewModel.ExposedChecked, Mode=OneWay,
                                    Converter={StaticResource InverseBoolToVis}}" />
                        <ProgressRing Width="24" Height="24"
                                      HorizontalAlignment="Left"
                                      AutomationProperties.Name="正在检查暴露密码"
                                      IsActive="{x:Bind ViewModel.IsCheckingExposed, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsCheckingExposed, Mode=OneWay,
                                          Converter={StaticResource BoolToVis}}" />
                        <InfoBar x:Name="ExposedErrorInfoBar"
                                 AutomationProperties.AutomationId="ExposedErrorInfoBar"
                                 IsClosable="False"
                                 Severity="Error"
                                 AutomationProperties.LiveSetting="Assertive"
                                 IsOpen="{x:Bind ViewModel.HasExposedError, Mode=OneWay}"
                                 Message="{x:Bind ViewModel.ExposedError, Mode=OneWay}" />
                    </StackPanel>
                </tk:SettingsExpander.ItemsHeader>

                <tk:SettingsExpander.ItemTemplate>
                    <DataTemplate x:DataType="models:ExposedFinding">
                        <tk:SettingsCard Header="{x:Bind Item.Name}" Description="{x:Bind Item.Username}">
                            <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                                    CornerRadius="4" Padding="8,2">
                                <TextBlock Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           FontSize="12" FontWeight="SemiBold">
                                    <Run Text="泄露 " />
                                    <Run Text="{x:Bind BreachCount}" />
                                    <Run Text=" 次" />
                                </TextBlock>
                            </Border>
                        </tk:SettingsCard>
                    </DataTemplate>
                </tk:SettingsExpander.ItemTemplate>

                <tk:SettingsExpander.ItemsFooter>
                    <TextBlock Text="未发现已暴露的密码"
                               Margin="16,10"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind local:SecurityReportPage.ShowNoExposedFound(
                                   ViewModel.ExposedChecked, ViewModel.HasExposed), Mode=OneWay}" />
                </tk:SettingsExpander.ItemsFooter>
            </tk:SettingsExpander>

        </StackPanel>
        </Grid>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
