<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.SecurityReportPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:App.Converters"
    xmlns:models="using:Core.Models"
    xmlns:viewModels="using:App.ViewModels"
    xmlns:local="using:App.Views">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
        <Style x:Key="FindingButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <DataTemplate x:Key="HealthItemTemplate" x:DataType="models:HealthItemRef">
            <Button Tag="{x:Bind CipherId}" Click="OnOpenItemClick" Style="{StaticResource FindingButtonStyle}"
                    AutomationProperties.Name="{x:Bind local:SecurityReportPage.FormatOpenItem(Name)}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Username}" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="{StaticResource PageContentPadding}"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">

        <Grid>
        <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">

        <TextBlock Text="安全报告"
                   Style="{ThemeResource TitleTextBlockStyle}"
                   Margin="0,0,0,8" />
        <TextBlock Text="查看需要处理的登录信息。打开条目后，前往对应网站更新密码。同一条目可能出现在多个结果中。"
                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,16" />
        <Button Content="重新分析" Command="{x:Bind ViewModel.RetryOfflineCommand}"
                IsEnabled="{x:Bind ViewModel.ShowOfflineContent, Mode=OneWay}" Margin="0,0,0,16" />

        <Grid>


        <StackPanel x:Name="OfflineLoadingPanel"
                    Spacing="8"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.ShowOfflineLoading, Mode=OneWay,
                        Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing Width="24"
                              Height="24"
                              IsActive="True"
                              AutomationProperties.Name="正在分析安全报告" />
                <TextBlock Text="正在分析安全报告…"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <ProgressBar Minimum="0"
                         Maximum="100"
                         AutomationProperties.Name="安全报告分析进度"
                         Value="{x:Bind ViewModel.OfflineProgress, Mode=OneWay}" />
        </StackPanel>


        <StackPanel x:Name="OfflineErrorPanel"
                    Spacing="8"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.ShowOfflineError, Mode=OneWay,
                        Converter={StaticResource BoolToVis}}">
            <InfoBar Severity="Error"
                     IsOpen="True"
                     AutomationProperties.LiveSetting="Assertive"
                     Message="{x:Bind ViewModel.OfflineError, Mode=OneWay}" />
            <Button x:Name="SecurityReportRetryButton"
                    Content="重试"
                    Command="{x:Bind ViewModel.RetryOfflineCommand}"
                    AutomationProperties.AutomationId="SecurityReportRetryButton" />
        </StackPanel>

        <StackPanel x:Name="OfflineContentPanel"
                    Spacing="12"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.ShowOfflineContent, Mode=OneWay,
                        Converter={StaticResource BoolToVis}}">


            <Border Style="{StaticResource CardBorderStyle}"
                    Padding="{StaticResource CardContentPadding}"
                    Margin="0,0,0,12">
                <Grid x:Name="HealthSummaryGrid" ColumnSpacing="16">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="HealthSummaryLayoutStates">
                            <VisualState x:Name="WideHealthSummary">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="760" />
                                </VisualState.StateTriggers>
                            </VisualState>
                            <VisualState x:Name="NarrowHealthSummary">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="HealthMetricsPanel.(Grid.Row)" Value="1" />
                                    <Setter Target="HealthMetricsPanel.(Grid.Column)" Value="0" />
                                    <Setter Target="HealthMetricsPanel.(Grid.ColumnSpan)" Value="3" />
                                    <Setter Target="HealthMetricsPanel.HorizontalAlignment" Value="Stretch" />
                                    <Setter Target="HealthMetricsPanel.Margin" Value="0,12,0,0" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE72E;"
                              FontSize="28"
                              VerticalAlignment="Center"
                              AutomationProperties.AccessibilityView="Raw"
                              Foreground="{x:Bind ViewModel.OverallSeverity, Mode=OneWay,
                                  Converter={StaticResource SeverityToBrush}}" />

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="密码库健康" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Grid x:Name="HealthMetricsPanel"
                          Grid.Column="2"
                          ColumnSpacing="12"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="12" HorizontalAlignment="Center">
                            <InfoBadge HorizontalAlignment="Center"
                                       Value="{x:Bind ViewModel.ReusedCount, Mode=OneWay}" />
                            <TextBlock Text="重复" HorizontalAlignment="Center"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="12" HorizontalAlignment="Center">
                            <InfoBadge HorizontalAlignment="Center"
                                       Value="{x:Bind ViewModel.WeakCount, Mode=OneWay}" />
                            <TextBlock Text="弱" HorizontalAlignment="Center"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="12" HorizontalAlignment="Center">
                            <InfoBadge HorizontalAlignment="Center"
                                       Value="{x:Bind ViewModel.UnsecuredCount, Mode=OneWay}" />
                            <TextBlock Text="不安全" HorizontalAlignment="Center"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="12" HorizontalAlignment="Center">
                            <Grid HorizontalAlignment="Center">
                                <InfoBadge HorizontalAlignment="Center"
                                           Value="{x:Bind ViewModel.ExposedCount, Mode=OneWay}"
                                           AutomationProperties.Name="{x:Bind ViewModel.ExposureMetricAccessibleName, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.ShowExposedCount, Mode=OneWay,
                                               Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{x:Bind ViewModel.ExposureStatusLabel, Mode=OneWay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           AutomationProperties.Name="{x:Bind ViewModel.ExposureMetricAccessibleName, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.ShowExposedCount, Mode=OneWay,
                                               Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>
                            <TextBlock Text="暴露" HorizontalAlignment="Center"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Expander x:Name="ReusedPasswordsExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="重复密码" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="为每个账户设置不同的密码。计数表示共用密码的分组数。" TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                        </StackPanel>
                        <InfoBadge Grid.Column="1" Value="{x:Bind ViewModel.ReusedCount, Mode=OneWay}" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="8">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ReusedGroups, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ReusedPasswordGroup">
                                <StackPanel Spacing="4" Margin="0,0,0,12">
                                    <TextBlock Text="{x:Bind local:SecurityReportPage.FormatReusedHeader(Count)}" FontWeight="SemiBold" Margin="12,4" />
                                    <ItemsRepeater ItemsSource="{x:Bind Items}" ItemTemplate="{StaticResource HealthItemTemplate}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Text="未发现重复密码" Margin="12" Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.HasReused, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Expander>

            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="弱密码" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="使用更长、随机生成的密码，降低被猜中的风险。" TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                        </StackPanel>
                        <InfoBadge Grid.Column="1" Value="{x:Bind ViewModel.WeakCount, Mode=OneWay}" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="8">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.WeakItems, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:WeakFinding">
                                <Button Tag="{x:Bind Item.CipherId}" Click="OnOpenItemClick" Style="{StaticResource FindingButtonStyle}"
                                        AutomationProperties.Name="{x:Bind local:SecurityReportPage.FormatOpenItem(Item.Name)}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Item.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Item.Username}" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                            <TextBlock Text="建议更换密码" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Text="未发现弱密码" Margin="12" Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.HasWeak, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Expander>

            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="不安全网站 (HTTP)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="检查网站是否支持 HTTPS，再更新保存的网址。" TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                        </StackPanel>
                        <InfoBadge Grid.Column="1" Value="{x:Bind ViewModel.UnsecuredCount, Mode=OneWay}" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="8">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.UnsecuredItems, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:UnsecuredFinding">
                                <Button Tag="{x:Bind Item.CipherId}" Click="OnOpenItemClick" Style="{StaticResource FindingButtonStyle}"
                                        AutomationProperties.Name="{x:Bind local:SecurityReportPage.FormatOpenItem(Item.Name)}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Item.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Item.Username}" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Uri}" Style="{StaticResource CaptionSecondaryTextBlockStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Text="未发现不安全的 HTTP 网站" Margin="12" Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.HasUnsecured, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Expander>

            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="True">
                <Expander.Header>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="暴露密码" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="检查密码是否出现在已知泄露数据中。" TextWrapping="Wrap" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <InfoBadge Value="{x:Bind ViewModel.ExposedCount, Mode=OneWay}"
                                       AutomationProperties.Name="{x:Bind ViewModel.ExposureMetricAccessibleName, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.ShowExposedCount, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{x:Bind ViewModel.ExposureStatusLabel, Mode=OneWay}" VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.ShowExposedCount, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.ExposureStatusMessage, Mode=OneWay}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="检查由 Have I Been Pwned 提供。仅发送密码 SHA-1 哈希的前 5 位，不发送密码本身。"
                               Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                    <Button Content="运行暴露检查" Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.RunExposedCheckCommand}"
                            AutomationProperties.AutomationId="RunExposedCheckButton" />
                    <ProgressRing Width="24" Height="24" HorizontalAlignment="Left"
                                  AutomationProperties.Name="正在检查暴露密码"
                                  IsActive="{x:Bind ViewModel.IsCheckingExposed, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsCheckingExposed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <InfoBar x:Name="ExposedErrorInfoBar" AutomationProperties.AutomationId="ExposedErrorInfoBar"
                             IsClosable="False" Severity="Error" AutomationProperties.LiveSetting="Assertive"
                             IsOpen="{x:Bind ViewModel.HasExposedError, Mode=OneWay}" Message="{x:Bind ViewModel.ExposedError, Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ExposedItems, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:ExposedFinding">
                                <Button Tag="{x:Bind Item.CipherId}" Click="OnOpenItemClick" Style="{StaticResource FindingButtonStyle}"
                                        AutomationProperties.Name="{x:Bind local:SecurityReportPage.FormatOpenItem(Item.Name)}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Item.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Item.Username}" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                            <TextBlock Text="建议尽快更换此密码" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Text="未发现已暴露的密码" Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                               Visibility="{x:Bind local:SecurityReportPage.ShowNoExposedFound(ViewModel.ExposedChecked, ViewModel.HasExposed), Mode=OneWay}" />
                </StackPanel>
            </Expander>

        </StackPanel>
        </Grid>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
