<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="App.Views.SecurityReportPage" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:App.Controls" xmlns:conv="using:App.Converters" xmlns:vm="using:App.ViewModels" xmlns:local="using:App.Views"
    Background="Transparent">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" /><conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <DataTemplate x:Key="IssueTemplate" x:DataType="vm:SecurityIssueRow">
            <Grid MinHeight="56" ColumnSpacing="14" RowSpacing="8" Padding="0,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" SizeChanged="OnIssueRowSizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <controls:FaviconView DisplayName="{x:Bind Name}" TileSize="32" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Subtitle}" /></StackPanel>
                <StackPanel x:Name="IssueActions" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="查看" Height="32" Padding="12,0" Tag="{x:Bind CipherId}" Click="OnOpenItemClick" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="{x:Bind local:SecurityReportPage.FormatOpenItem(Name)}" />
                    <Button Content="{x:Bind ActionLabel}" Height="32" Padding="12,0" Tag="{x:Bind}" Click="OnFixItemClick" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PriorityTemplate" x:DataType="vm:SecurityIssueRow">
            <Grid ColumnSpacing="16" RowSpacing="12" Padding="0,20" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1" SizeChanged="OnIssueRowSizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <controls:FaviconView DisplayName="{x:Bind Name}" TileSize="48" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource WardenDisplayFontFamily}" FontSize="20" LineHeight="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Glyph="{x:Bind local:SecurityReportPage.CategoryIcon(Category)}" Tag="{x:Bind Severity}" Loaded="OnSeverityIconLoaded" Unloaded="OnSeverityIconUnloaded" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" /><TextBlock Grid.Column="1" Text="{x:Bind Reason}" TextWrapping="Wrap" /></Grid>
                    <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="IssueActions" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="查看" Height="32" Padding="12,0" Tag="{x:Bind CipherId}" Click="OnOpenItemClick" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="{x:Bind local:SecurityReportPage.FormatOpenItem(Name)}" />
                    <Button Content="{x:Bind ActionLabel}" Height="32" Padding="16,0" Tag="{x:Bind}" Click="OnFixItemClick" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageLayout" Padding="40,40,40,48" HorizontalAlignment="Stretch" SizeChanged="OnLayoutSizeChanged">
        <Grid Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw">
            <TextBlock x:Name="CriticalBrushSource" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            <TextBlock x:Name="CautionBrushSource" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            <TextBlock x:Name="SecondaryBrushSource" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
            <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" FontFamily="{StaticResource WardenDisplayFontFamily}" FontSize="28" LineHeight="36" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,28" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"><Run Text="{x:Bind ViewModel.CategorySummary, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{x:Bind ViewModel.LastCheckedText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></TextBlock>
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowOfflineLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"><ProgressBar IsIndeterminate="True" AutomationProperties.Name="安全报告分析进度" /><TextBlock Text="正在检查密码库…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.ShowOfflineError, Mode=OneWay}" IsClosable="False" Severity="Error" Title="无法完成检查" Message="{x:Bind ViewModel.OfflineError, Mode=OneWay}"><InfoBar.ActionButton><Button AutomationProperties.AutomationId="SecurityReportRetryButton" Content="重试" Command="{x:Bind ViewModel.RetryOfflineCommand}" /></InfoBar.ActionButton></InfoBar>
            <StackPanel x:Name="OfflineContentPanel" Visibility="{x:Bind ViewModel.ShowOfflineContent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel x:Name="ExposureNotice" Margin="0,0,0,24" Spacing="8" Visibility="{x:Bind ViewModel.ExposedChecked, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.ExposureStatusMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" AutomationProperties.Name="正在检查暴露密码" Visibility="{x:Bind ViewModel.IsCheckingExposed, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Button AutomationProperties.AutomationId="RunExposedCheckButton" Content="检查已泄露的密码" Command="{x:Bind ViewModel.RunExposedCheckCommand}" HorizontalAlignment="Left" />
                </StackPanel>
                <InfoBar AutomationProperties.AutomationId="ExposedErrorInfoBar" IsOpen="{x:Bind ViewModel.HasExposedError, Mode=OneWay}" Message="{x:Bind ViewModel.ExposedError, Mode=OneWay}" Severity="Error" IsClosable="False" Margin="0,0,0,16" />
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1" Padding="0,16" Margin="0,0,0,32" Visibility="{x:Bind ViewModel.HasVisibleIssues, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Glyph="{x:Bind local:SecurityReportPage.EmptyIcon(ViewModel.ExposedChecked), Mode=OneWay}" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></Grid>
                </Border>
                <StackPanel Margin="0,0,0,40" Visibility="{x:Bind ViewModel.ShowPriority, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="先处理这一项" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ContentControl Content="{x:Bind ViewModel.PriorityIssue, Mode=OneWay}" ContentTemplate="{StaticResource PriorityTemplate}" HorizontalContentAlignment="Stretch" />
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind ViewModel.IssueGroups}" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SecurityIssueGroup">
                        <StackPanel Margin="0,0,0,32">
                            <Grid Margin="0,0,0,10" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind local:SecurityReportPage.CategoryIcon(Category)}" FontSize="16" Tag="{x:Bind Category}" Loaded="OnSeverityIconLoaded" Unloaded="OnSeverityIconUnloaded" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="{x:Bind Count}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Description}" Margin="8,0,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind Items}" ItemTemplate="{StaticResource IssueTemplate}" HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{x:Bind ViewModel.HasResolvedItems, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10"><FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" /><TextBlock Text="本次已处理" FontWeight="SemiBold" /><TextBlock Text="{x:Bind ViewModel.ResolvedItems.Count, Mode=OneWay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ResolvedItems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SecurityIssueRow">
                        <Grid MinHeight="52" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <controls:FaviconView DisplayName="{x:Bind Name}" TileSize="32" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" ColumnSpacing="10" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{x:Bind ResultLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
