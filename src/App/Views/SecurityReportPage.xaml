<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="App.Views.SecurityReportPage" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:App.Controls" xmlns:conv="using:App.Converters" xmlns:vm="using:App.ViewModels" xmlns:local="using:App.Views"
    xmlns:models="using:Core.Models"
    Background="Transparent">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" /><conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <DataTemplate x:Key="IssueTemplate" x:DataType="vm:SecurityIssueRow">
            <Grid MinHeight="56" ColumnSpacing="14" RowSpacing="8" BorderBrush="{ThemeResource WardenLineBrush}" BorderThickness="0,0,0,1" SizeChanged="OnIssueRowSizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Button Grid.ColumnSpan="2" MinHeight="56" Padding="8,8" Margin="-8,0,0,0" HorizontalContentAlignment="Stretch" Tag="{x:Bind CipherId}" Click="OnOpenItemClick" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="{x:Bind local:SecurityReportPage.FormatOpenItem(Name)}">
                    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <controls:FaviconView DisplayName="{x:Bind Name}" TileSize="32" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource WardenPrimaryTextBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind Subtitle}" FontSize="12" LineHeight="16" Foreground="{ThemeResource WardenSecondaryTextBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Subtitle}" /></StackPanel>
                    </Grid>
                </Button>
                <StackPanel x:Name="IssueActions" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Uid="LD000E801CF1EDCDB" Content="忽略" Height="32" Padding="12,0" Tag="{x:Bind}" Click="OnIgnoreItemClick" Visibility="{x:Bind CanIgnore, Converter={StaticResource BoolToVis}}" Style="{StaticResource SubtleButtonStyle}" Foreground="{ThemeResource WardenSecondaryTextBrush}" ToolTipService.ToolTip="不再提醒这一项，可以在“已忽略”里恢复" AutomationProperties.Name="{x:Bind local:SecurityReportPage.FormatIgnoreItem(Name)}" />
                    <Button Content="{x:Bind ActionLabel}" Height="32" Padding="12,0" Tag="{x:Bind}" Click="OnFixItemClick" AutomationProperties.Name="{x:Bind local:SecurityReportPage.FormatIssueAction(ActionLabel, Name)}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PriorityTemplate" x:DataType="vm:SecurityIssueRow">
            <Grid ColumnSpacing="16" RowSpacing="12" Padding="0,20" BorderBrush="{ThemeResource WardenLineBrush}" BorderThickness="0,1" SizeChanged="OnIssueRowSizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Button Grid.ColumnSpan="2" Padding="8,0" Margin="-8,0,0,0" HorizontalContentAlignment="Stretch" Tag="{x:Bind CipherId}" Click="OnOpenItemClick" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="{x:Bind local:SecurityReportPage.FormatOpenItem(Name)}">
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <controls:FaviconView DisplayName="{x:Bind Name}" TileSize="48" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource WardenPrimaryTextBrush}" FontFamily="{StaticResource WardenDisplayFontFamily}" FontSize="20" LineHeight="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Glyph="{x:Bind local:SecurityReportPage.CategoryIcon(Category)}" Tag="{x:Bind Severity}" Loaded="OnSeverityIconLoaded" Unloaded="OnSeverityIconUnloaded" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw" /><TextBlock Grid.Column="1" Text="{x:Bind Reason}" Foreground="{ThemeResource WardenPrimaryTextBrush}" TextWrapping="Wrap" /></Grid>
                            <TextBlock Text="{x:Bind Description}" FontSize="12" LineHeight="16" Foreground="{ThemeResource WardenSecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Button>
                <StackPanel x:Name="IssueActions" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Uid="LD000E801CF1EDCDB" Content="忽略" Height="32" Padding="12,0" Tag="{x:Bind}" Click="OnIgnoreItemClick" Visibility="{x:Bind CanIgnore, Converter={StaticResource BoolToVis}}" Style="{StaticResource SubtleButtonStyle}" Foreground="{ThemeResource WardenSecondaryTextBrush}" ToolTipService.ToolTip="不再提醒这一项，可以在“已忽略”里恢复" AutomationProperties.Name="{x:Bind local:SecurityReportPage.FormatIgnoreItem(Name)}" />
                    <Button Content="{x:Bind ActionLabel}" Height="32" Padding="16,0" Tag="{x:Bind}" Click="OnFixItemClick" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="{x:Bind local:SecurityReportPage.FormatIssueAction(ActionLabel, Name)}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageLayout" Padding="40,40,40,48" HorizontalAlignment="Stretch" SizeChanged="OnLayoutSizeChanged">
        <Grid Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw">
            <TextBlock x:Name="CriticalBrushSource" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            <TextBlock x:Name="CautionBrushSource" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            <TextBlock x:Name="SecondaryBrushSource" Foreground="{ThemeResource WardenSecondaryTextBrush}" />
        </Grid>
        <StackPanel MaxWidth="800" HorizontalAlignment="Stretch">
            <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" FontFamily="{StaticResource WardenDisplayFontFamily}" FontSize="28" LineHeight="36" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,28" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"><Run Text="{x:Bind ViewModel.CategorySummary, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{x:Bind ViewModel.LastCheckedText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></TextBlock>
            <StackPanel Margin="0,-16,0,28" Spacing="8" Visibility="{x:Bind ViewModel.ShowOfflineLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"><ProgressBar x:Uid="L1D8ADC85E112D41C" Minimum="0" Maximum="{x:Bind ViewModel.OfflineProgressTotal, Mode=OneWay}" Value="{x:Bind ViewModel.OfflineProgress, Mode=OneWay}" Height="3" MinHeight="3" AutomationProperties.Name="安全报告分析进度" /><TextBlock Text="{x:Bind ViewModel.OfflineProgressText, Mode=OneWay}" FontSize="12" LineHeight="16" Typography.NumeralAlignment="Tabular" Foreground="{ThemeResource WardenSecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" /></StackPanel>
            <InfoBar x:Uid="LC3C254F5B91978DD" IsOpen="{x:Bind ViewModel.ShowOfflineError, Mode=OneWay}" IsClosable="False" Severity="Error" Background="{ThemeResource WardenCriticalBackgroundBrush}" Title="无法完成检查" Message="{x:Bind ViewModel.OfflineError, Mode=OneWay}"><InfoBar.ActionButton><Button x:Uid="L7FFEE9D04734CB54" AutomationProperties.AutomationId="SecurityReportRetryButton" Content="重试" Command="{x:Bind ViewModel.RetryOfflineCommand}" /></InfoBar.ActionButton></InfoBar>
            <Grid x:Name="ExposureNotice" Visibility="{x:Bind ViewModel.ExposedChecked, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Margin="0,-16,0,28" Spacing="8" Visibility="{x:Bind ViewModel.IsCheckingExposed, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ProgressBar x:Uid="LE630FA5C5FDED6EC" IsIndeterminate="True" Height="3" MinHeight="3" AutomationProperties.Name="正在检查暴露密码" />
                    <TextBlock Text="{x:Bind ViewModel.ExposureProgressText, Mode=OneWay}" FontSize="12" LineHeight="16" Foreground="{ThemeResource WardenSecondaryTextBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <Border AutomationProperties.AutomationId="FirstExposureCheckCard" Padding="20" Margin="0,0,0,32" CornerRadius="8" Background="{ThemeResource WardenLayerBrush}" BorderBrush="{ThemeResource WardenLineBrush}" BorderThickness="1" Visibility="{x:Bind ViewModel.ShowFirstExposureCheck, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEA18;" FontSize="24" Margin="0,2,0,0" VerticalAlignment="Top" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1"><TextBlock x:Uid="L124FAE594CC4CEB7" Text="还没有检查过密码是否泄露" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Margin="0,4,0,0" Text="{x:Bind ViewModel.FirstExposureCheckDescription, Mode=OneWay}" Foreground="{ThemeResource WardenSecondaryTextBrush}" TextWrapping="Wrap" /><Button x:Uid="L44964EA9BEB964B5" AutomationProperties.AutomationId="RunExposedCheckButton" Content="开始检查" Height="32" Padding="16,0" Margin="0,16,0,0" Command="{x:Bind ViewModel.RunExposedCheckCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" /></StackPanel>
                    </Grid>
                </Border>
                <StackPanel Margin="0,0,0,24" Spacing="8" Visibility="{x:Bind ViewModel.ShowExposureReminder, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock AutomationProperties.LiveSetting="Polite" Text="{x:Bind ViewModel.ExposureStatusMessage, Mode=OneWay}" Foreground="{ThemeResource WardenSecondaryTextBrush}" TextWrapping="Wrap" />
                    <Button x:Uid="L0DF9B329BA9671E6" Content="重新检查" Command="{x:Bind ViewModel.RunExposedCheckCommand}" HorizontalAlignment="Left" Height="32" Padding="12,0" />
                </StackPanel>
            </Grid>
            <StackPanel x:Name="OfflineContentPanel" Visibility="{x:Bind ViewModel.ShowOfflineContent, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <InfoBar AutomationProperties.AutomationId="ExposedErrorInfoBar" IsOpen="{x:Bind ViewModel.HasExposedError, Mode=OneWay}" Message="{x:Bind ViewModel.ExposedError, Mode=OneWay}" Severity="Error" Background="{ThemeResource WardenCriticalBackgroundBrush}" IsClosable="False" Margin="0,0,0,16" />
                <StackPanel Margin="0,0,0,24" Spacing="12" Visibility="{x:Bind ViewModel.ShowUnassessedPasswords, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <InfoBar x:Uid="L48C4E80C79733AEF" AutomationProperties.AutomationId="UnassessedPasswordsNotice" IsOpen="True" IsClosable="False" Severity="Warning" Title="Password strength not assessed" Message="{x:Bind ViewModel.UnassessedSummary, Mode=OneWay}" />
                    <TextBlock x:Uid="L3BA9B7B29A733867" Text="These passwords exceed the safe analysis budget. They have not been classified as weak or safe. Open an item to review it." Foreground="{ThemeResource WardenSecondaryTextBrush}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.UnassessedItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:HealthItemRef">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10" MinHeight="44" Tag="{x:Bind CipherId}" Click="OnOpenItemClick" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="{x:Bind local:SecurityReportPage.FormatOpenItem(Name)}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" Foreground="{ThemeResource WardenPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Username}" Foreground="{ThemeResource WardenSecondaryTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Border BorderBrush="{ThemeResource WardenLineBrush}" BorderThickness="0,1" Padding="0,16" Margin="0,0,0,32" Visibility="{x:Bind ViewModel.ShowEmptyMessage, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Glyph="{x:Bind local:SecurityReportPage.EmptyIcon(ViewModel.IsReportComplete), Mode=OneWay}" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></Grid>
                </Border>
                <StackPanel Margin="0,0,0,40" Visibility="{x:Bind ViewModel.ShowPriority, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock x:Uid="L4DACAE0C5AEC99DA" Text="先处理这一项" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ContentControl Content="{x:Bind ViewModel.PriorityIssue, Mode=OneWay}" ContentTemplate="{StaticResource PriorityTemplate}" HorizontalContentAlignment="Stretch" />
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind ViewModel.IssueGroups}" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SecurityIssueGroup">
                        <StackPanel Margin="0,0,0,32">
                            <Grid Margin="0,0,0,10" ColumnSpacing="8" Visibility="{x:Bind ShowHeader, Converter={StaticResource BoolToVis}}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind local:SecurityReportPage.CategoryIcon(Category)}" FontSize="16" Tag="{x:Bind Category}" Loaded="OnSeverityIconLoaded" Unloaded="OnSeverityIconUnloaded" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="{x:Bind Count}" Style="{StaticResource WardenCountTextStyle}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Description}" Margin="8,0,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                            <Border BorderBrush="{ThemeResource WardenLineBrush}" BorderThickness="0,1,0,0"><ItemsControl ItemsSource="{x:Bind Items}" ItemTemplate="{StaticResource IssueTemplate}" HorizontalContentAlignment="Stretch" /></Border>
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Visibility="{x:Bind ViewModel.HasResolvedItems, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10" Visibility="{x:Bind ViewModel.ShowResolvedHeader, Mode=OneWay, Converter={StaticResource BoolToVis}}"><FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" AutomationProperties.AccessibilityView="Raw" /><TextBlock x:Uid="LB80D4B0359BB2690" Text="本次已处理" FontWeight="SemiBold" /><TextBlock Text="{x:Bind ViewModel.ResolvedItems.Count, Mode=OneWay}" Style="{StaticResource WardenCountTextStyle}" /></StackPanel>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ResolvedItems}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SecurityIssueRow">
                        <Grid MinHeight="52" ColumnSpacing="14" BorderBrush="{ThemeResource WardenLineBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <controls:FaviconView DisplayName="{x:Bind Name}" TileSize="32" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" ColumnSpacing="10" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{x:Bind ResultLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
