<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:App.Converters">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="SettingsRowStyle" TargetType="tk:SettingsCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="IsActionIconVisible" Value="False" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="CompactSettingsRowStyle" TargetType="tk:SettingsCard" BasedOn="{StaticResource SettingsRowStyle}">
            <Setter Property="MinHeight" Value="52" />
        </Style>
        <Style x:Key="SettingsGroupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="SettingsSwitchStyle" TargetType="ToggleSwitch">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
        </Style>
    </Page.Resources>
    <Grid x:Name="SettingsSurface" Background="{ThemeResource WardenLayerBrush}">
        <ScrollViewer x:Name="SettingsScrollViewer" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <Grid Padding="40,40,40,48" HorizontalAlignment="Stretch">
            <Border MaxWidth="680" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock x:Uid="L28546E0325510D71" AutomationProperties.HeadingLevel="Level1" x:Name="SectionTitle" Text="账户" FontFamily="{StaticResource WardenDisplayFontFamily}" FontSize="28" LineHeight="36" FontWeight="SemiBold" />
                    <InfoBar Visibility="{x:Bind ViewModel.HasOperationError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" IsOpen="{x:Bind ViewModel.HasOperationError, Mode=OneWay}" IsClosable="False" Severity="Error" Background="{ThemeResource WardenCriticalBackgroundBrush}" Message="{x:Bind ViewModel.OperationError, Mode=OneWay}" Margin="0,12,0,0" />
                    <StackPanel x:Name="AccountSettingsSection">
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,20" Margin="0,24,0,28">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource WardenTileBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.AccountInitial, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.AccountDisplayName, Mode=OneWay}" FontFamily="{StaticResource WardenDisplayFontFamily}" FontSize="20" LineHeight="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.AccountEmail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.AccountServer, Mode=OneWay}" FontSize="12" LineHeight="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Margin="0,0,0,32">
                            <TextBlock x:Uid="L1EC75772BF6E07D1" Text="账户信息" Style="{StaticResource SettingsGroupTitleStyle}" />
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <tk:SettingsCard x:Uid="L0D49856A0AC5D057" Style="{StaticResource SettingsRowStyle}" Header="名称" Description="{x:Bind ViewModel.AccountNameDescription, Mode=OneWay}"><Button x:Uid="L59940A0783F39249" AutomationProperties.AutomationId="EditProfileButton" Content="编辑…" Style="{StaticResource SettingsButtonStyle}" Click="OnEditProfileClick" /></tk:SettingsCard>
                                    <tk:SettingsCard x:Uid="LE13B775305955D0E" Style="{StaticResource SettingsRowStyle}" Header="加密方式" Description="{x:Bind ViewModel.KdfDescription, Mode=OneWay}"><Button x:Uid="LB85FECE7B0EC2891" AutomationProperties.AutomationId="ChangeKdfCard" Content="更改…" Style="{StaticResource SettingsButtonStyle}" Click="OnChangeKdfCardClick" /></tk:SettingsCard>
                                    <tk:SettingsCard x:Uid="L724F1AEC390F8D9C" Style="{StaticResource SettingsRowStyle}" Header="主密码" Description="修改后，其他设备都需要重新登录"><Button x:Uid="LB85FECE7B0EC2891" AutomationProperties.AutomationId="ChangePasswordCard" Content="更改…" Style="{StaticResource SettingsButtonStyle}" Click="OnChangePasswordCardClick" /></tk:SettingsCard>
                                    <tk:SettingsCard x:Uid="LC9E9C00357EED19D" Style="{StaticResource SettingsRowStyle}" Header="Email and sessions" Description="Verify or change your email, or sign out all sessions"><Button x:Uid="L0F98D0183C458D16" Content="Manage…" Style="{StaticResource SettingsButtonStyle}" Click="OnAccountManagementClick" /></tk:SettingsCard>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,32">
                            <TextBlock x:Uid="L9A36F352DC26BDB8" Text="登录" Style="{StaticResource SettingsGroupTitleStyle}" />
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><tk:SettingsCard x:Uid="LA894CDB232513F04" Style="{StaticResource SettingsRowStyle}" Header="退出登录" Description="清除本机缓存的密码库，下次需要联网登录"><Button x:Uid="L0E4A3FD458D54D20" Content="退出登录" Style="{StaticResource SettingsButtonStyle}" Click="OnLogoutClick" /></tk:SettingsCard></Border>
                        </StackPanel>
                        <StackPanel x:Name="DangerSettingsSection" Margin="0,0,0,32">
                            <TextBlock x:Uid="L64CB0848F4E1F38C" Text="危险操作" Style="{StaticResource SettingsGroupTitleStyle}" />
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><tk:SettingsCard x:Uid="LAD4A38B51F95FAF6" Style="{StaticResource SettingsRowStyle}" Header="删除账户" Description="永久删除账户和密码库里的全部数据，无法恢复"><Button x:Uid="L5DFB5797B35CB1A1" x:Name="DeleteAccountButton" AutomationProperties.AutomationId="DeleteAccountButton" Content="删除账户…" Style="{StaticResource SettingsButtonStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Click="OnDeleteAccountClick" /></tk:SettingsCard></Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="SecuritySettingsSection" Visibility="Collapsed" Margin="0,28,0,0">
                        <StackPanel Margin="0,0,0,32">
                            <TextBlock x:Uid="L2C0FDC5605CAC442" Text="解锁" Style="{StaticResource SettingsGroupTitleStyle}" />
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <tk:SettingsCard x:Uid="LC33C8674D99B1308" x:Name="HelloCard" Style="{StaticResource SettingsRowStyle}" Header="使用 Windows Hello 解锁" Description="{x:Bind ViewModel.WindowsHelloDescription, Mode=OneWay}" IsClickEnabled="True" Click="OnToggleSettingClick"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind ToggleState(HelloToggle.IsOn), Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><ToggleSwitch x:Uid="L212590BA8C42D2D5" x:Name="HelloToggle" Style="{StaticResource SettingsSwitchStyle}" AutomationProperties.Name="使用 Windows Hello 解锁" IsEnabled="{x:Bind ViewModel.CanToggleWindowsHello, Mode=OneWay}" Toggled="OnHelloToggleToggled" /></StackPanel></tk:SettingsCard>
                                    <tk:SettingsCard x:Uid="L2F7581B3D584CBBE" Style="{StaticResource SettingsRowStyle}" Header="使用 PIN 解锁" Description="{x:Bind ViewModel.PinUnlockDescription, Mode=OneWay}" IsClickEnabled="True" Click="OnToggleSettingClick"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind ToggleState(PinToggle.IsOn), Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><ToggleSwitch x:Uid="L8E4D8829CC0BC772" x:Name="PinToggle" Style="{StaticResource SettingsSwitchStyle}" AutomationProperties.Name="使用 PIN 解锁" IsEnabled="{x:Bind ViewModel.CanUsePinUnlock, Mode=OneWay}" Toggled="OnPinToggleToggled" /></StackPanel></tk:SettingsCard>
                                    <tk:SettingsCard x:Uid="L71703238781D23B0" Style="{StaticResource SettingsRowStyle}" Header="Require master password after restart" Description="The first PIN unlock in each application process requires prior master-password verification" Visibility="{x:Bind ViewModel.IsPinSet, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"><ToggleSwitch x:Uid="LD700475FFAB23CBA" IsOn="{x:Bind ViewModel.RequireMasterPasswordOnRestart, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanConfigurePinRestartPolicy, Mode=OneWay}" Toggled="OnPinRestartPolicyToggled" Style="{StaticResource SettingsSwitchStyle}" AutomationProperties.Name="Require master password before using PIN after restart" /></tk:SettingsCard>
                                    <tk:SettingsCard x:Uid="L6F826792D4F4549E" Style="{StaticResource SettingsRowStyle}" Header="PIN" Description="已设置" Visibility="{x:Bind ViewModel.IsPinSet, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"><Button x:Uid="LB85FECE7B0EC2891" Content="更改…" Style="{StaticResource SettingsButtonStyle}" Click="OnChangePinClick" /></tk:SettingsCard>
                                    <tk:SettingsCard x:Uid="L614350FE59D40528" Style="{StaticResource SettingsRowStyle}" Header="自动锁定" Description="闲置这么久之后锁定密码库">
                                        <ComboBox x:Uid="L59FD49A036C4CFF6" MinWidth="180" AutomationProperties.Name="自动锁定" SelectedIndex="{x:Bind ViewModel.SelectedSessionTimeoutIndex, Mode=TwoWay}">
                                            <ComboBoxItem x:Uid="LADC1846B8E8D248A" Content="应用重启时" IsEnabled="{x:Bind ViewModel.CanSelectRestartTimeout, Mode=OneWay}" />
                                            <ComboBoxItem x:Uid="L367A79F2ACDA3418" Content="1 分钟" IsEnabled="{x:Bind ViewModel.CanSelectOneMinuteTimeout, Mode=OneWay}" />
                                            <ComboBoxItem x:Uid="L803EA9DA438DF038" Content="5 分钟" IsEnabled="{x:Bind ViewModel.CanSelectFiveMinuteTimeout, Mode=OneWay}" />
                                            <ComboBoxItem x:Uid="L18B462DEA4792B3F" Content="15 分钟" IsEnabled="{x:Bind ViewModel.CanSelectFifteenMinuteTimeout, Mode=OneWay}" />
                                            <ComboBoxItem x:Uid="L4AA4C43AD6B90B09" Content="30 分钟" IsEnabled="{x:Bind ViewModel.CanSelectThirtyMinuteTimeout, Mode=OneWay}" />
                                            <ComboBoxItem x:Uid="L01762AB33839FED8" Content="1 小时" IsEnabled="{x:Bind ViewModel.CanSelectOneHourTimeout, Mode=OneWay}" />
                                            <ComboBoxItem x:Uid="L8063321D88CCB90B" Content="4 小时" IsEnabled="{x:Bind ViewModel.CanSelectFourHourTimeout, Mode=OneWay}" />
                                            <ComboBoxItem x:Uid="L836997678DB3F459" Content="从不" IsEnabled="{x:Bind ViewModel.CanSelectNeverTimeout, Mode=OneWay}" />
                                            <ComboBoxItem x:Uid="L4FE67EF453421627" Content="系统锁定时" IsEnabled="{x:Bind ViewModel.CanSelectSystemLockTimeout, Mode=OneWay}" />
                                            <ComboBoxItem Content="{x:Bind ViewModel.PolicySpecificTimeoutOptionText, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasPolicySpecificTimeoutOption, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </ComboBox>
                                    </tk:SettingsCard>
                                    <TextBlock Text="{x:Bind ViewModel.MaximumVaultTimeoutPolicyHint, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ViewModel.HasMaximumVaultTimeoutPolicy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <tk:SettingsCard x:Uid="LB30B1CFCF3F2D284" Style="{StaticResource CompactSettingsRowStyle}" Header="锁定时"><ComboBox x:Uid="L15F181FD5302B7A2" MinWidth="180" AutomationProperties.Name="锁定时" IsEnabled="{x:Bind ViewModel.CanSelectTimeoutAction, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedTimeoutActionIndex, Mode=TwoWay}"><ComboBoxItem x:Uid="L472CFF7A3089D0B1" Content="锁定密码库" /><ComboBoxItem x:Uid="L0A055AE39B269896" Content="退出登录" /></ComboBox></tk:SettingsCard>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,32">
                            <TextBlock x:Uid="LFC6A1438195428A2" Text="账户安全" Style="{StaticResource SettingsGroupTitleStyle}" />
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><StackPanel>
                                <tk:SettingsCard x:Uid="L77835AF696871219" x:Name="TwoFactorSummaryCard" Style="{StaticResource SettingsRowStyle}" Header="两步登录" Description="管理身份验证器应用、电子邮件和安全密钥"><Button x:Uid="L7E8F388E4968B6DA" AutomationProperties.AutomationId="TwoFactorCard" Content="管理…" Style="{StaticResource SettingsButtonStyle}" Click="OnTwoFactorCardClick" /></tk:SettingsCard>
                                <tk:SettingsCard x:Uid="LE73C6C3ADCF9670C" x:Name="EmergencySummaryCard" Style="{StaticResource SettingsRowStyle}" Header="紧急访问" Description="指定信任的人，在紧急情况下访问你的密码库"><Button x:Uid="L7E8F388E4968B6DA" Content="管理…" Style="{StaticResource SettingsButtonStyle}" Click="OnEmergencyAccessCardClick" /></tk:SettingsCard>
                                <tk:SettingsCard x:Uid="L0C98E514B6A75B48" Style="{StaticResource SettingsRowStyle}" Header="可信设备加密" Description="{x:Bind ViewModel.TrustedDeviceStatus, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowTrustedDeviceSettings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"><Button x:Name="TrustCurrentDeviceButton" Content="{x:Bind ViewModel.TrustedDeviceActionText, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanTrustCurrentDevice, Mode=OneWay}" Style="{StaticResource SettingsButtonStyle}" Click="OnTrustCurrentDeviceClick" /></tk:SettingsCard>
                                <tk:SettingsCard x:Uid="LC20553A0B474D334" Style="{StaticResource SettingsRowStyle}" Header="Device requests while locked" Description="Keep a short-lived access token in memory to read requests; approval always requires unlocking"><ToggleSwitch x:Uid="L0663885202808079" x:Name="LockedDeviceRequestsToggle" Style="{StaticResource SettingsSwitchStyle}" IsOn="False" Toggled="OnLockedDeviceRequestsToggled" AutomationProperties.Name="Monitor device sign-in requests while locked" /></tk:SettingsCard>
                            </StackPanel></Border>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,32">
                            <TextBlock x:Uid="L424C24D99E0FB40B" Text="敏感操作" Style="{StaticResource SettingsGroupTitleStyle}" />
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><tk:SettingsCard x:Uid="L1CB9ED3D779B990D" Style="{StaticResource SettingsRowStyle}" Header="显示或编辑密码前" Description="用 Windows Hello 确认是你本人"><ComboBox x:Uid="LCF6FB694C842EDDB" MinWidth="180" AutomationProperties.Name="显示或编辑密码前" SelectedIndex="{x:Bind ViewModel.SelectedSensitiveActionVerificationIndex, Mode=TwoWay}"><ComboBoxItem x:Uid="L26DD3E1ED71C0927" Content="每次都验证" /><ComboBoxItem x:Uid="LBC4D93F9CD847127" Content="验证后 5 分钟内免验证" /></ComboBox></tk:SettingsCard></Border>
                        </StackPanel>
                        <StackPanel x:Name="PrivacySettingsSection" Margin="0,0,0,32">
                            <TextBlock x:Uid="L1CCF6F3066E3D41B" Text="剪贴板" Style="{StaticResource SettingsGroupTitleStyle}" />
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><StackPanel>
                                <tk:SettingsCard x:Uid="LB0B77977AAA64BD3" Style="{StaticResource SettingsRowStyle}" Header="自动清除剪贴板" Description="复制密码、验证码后到时清空"><ComboBox x:Uid="L9BC475D8B69CE8C3" MinWidth="180" AutomationProperties.Name="自动清除剪贴板" SelectedIndex="{x:Bind ViewModel.SelectedClearClipboardIndex, Mode=TwoWay}"><ComboBoxItem x:Uid="L836997678DB3F459" Content="从不" /><ComboBoxItem x:Uid="L6EE1EEAD8E0E1CFA" Content="10 秒后" /><ComboBoxItem x:Uid="L126526490B670848" Content="20 秒后" /><ComboBoxItem x:Uid="L5D5FEDE60F40BAB0" Content="30 秒后" /><ComboBoxItem x:Uid="L7232FBAAD9E2628D" Content="1 分钟后" /><ComboBoxItem x:Uid="L24614C3FB687950A" Content="2 分钟后" /><ComboBoxItem x:Uid="LCD3EAAC7BF437993" Content="5 分钟后" /></ComboBox></tk:SettingsCard>
                                <tk:SettingsCard x:Uid="L043E17B0666B8A49" Style="{StaticResource SettingsRowStyle}" Header="不进入剪贴板历史" Description="复制的内容不会出现在 Win + V 和云剪贴板里" IsClickEnabled="True" Click="OnToggleSettingClick"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind ToggleState(ViewModel.ExcludeClipboardHistory), Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><ToggleSwitch x:Uid="LA3D2228794C8F593" Style="{StaticResource SettingsSwitchStyle}" IsOn="{x:Bind ViewModel.ExcludeClipboardHistory, Mode=TwoWay}" AutomationProperties.Name="不进入剪贴板历史" /></StackPanel></tk:SettingsCard>
                            </StackPanel></Border>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,32">
                            <TextBlock x:Uid="LB67483D707900EDE" Text="隐私" Style="{StaticResource SettingsGroupTitleStyle}" />
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><tk:SettingsCard x:Uid="L707F5BD144B5B2CC" Style="{StaticResource SettingsRowStyle}" Header="允许截屏和录屏" Description="关闭时，截图和屏幕共享中看不到这个窗口" IsClickEnabled="True" Click="OnToggleSettingClick"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind ToggleState(ViewModel.AllowScreenshots), Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><ToggleSwitch x:Uid="L9FBF41E7D732C4CA" Style="{StaticResource SettingsSwitchStyle}" IsOn="{x:Bind ViewModel.AllowScreenshots, Mode=TwoWay}" AutomationProperties.Name="允许截屏和录屏" /></StackPanel></tk:SettingsCard></Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="SshSettingsSection" Visibility="Collapsed">
                        <Grid ColumnSpacing="10" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Uid="L71480789FBE45D2C" Grid.Column="1" Text="Windows OpenSSH agent" TextWrapping="Wrap" />
                        </Grid>
                        <Border MaxWidth="640" HorizontalAlignment="Left" Margin="0,16,0,28" Padding="14,12,12,12" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource WardenTileBrush}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Uid="LAE5CE8537D4D46E1" Grid.Column="1" Text="Use SSH keys from the unlocked vault with ssh and git. Every signature requires explicit approval and fresh user verification. The local process can be identified; the remote host and forwarding path cannot be verified." TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16"><tk:SettingsCard x:Uid="L65DCFD152797371B" Style="{StaticResource SettingsRowStyle}" Header="Enable SSH agent" Description="Uses the Windows OpenSSH pipe while the vault is unlocked"><ToggleSwitch x:Uid="LF8E7A4E6EEB8F1EC" x:Name="SshAgentToggle" Style="{StaticResource SettingsSwitchStyle}" IsOn="False" Toggled="OnSshAgentToggleToggled" AutomationProperties.Name="Enable SSH agent" /></tk:SettingsCard></Border>
                        <TextBlock x:Name="SshAgentStatusText" TextWrapping="Wrap" Margin="0,0,0,32" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel x:Name="PreferencesSettingsSection" Visibility="Collapsed" Margin="0,28,0,0">
                        <StackPanel Margin="0,0,0,32">
                            <TextBlock x:Uid="L19792F1A1D6028C8" Text="外观" Style="{StaticResource SettingsGroupTitleStyle}" />
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><StackPanel>
                                <tk:SettingsCard x:Uid="L15ECE071BF2059D5" Style="{StaticResource CompactSettingsRowStyle}" Header="主题"><ComboBox x:Uid="L1F908B15DEAA7896" MinWidth="180" AutomationProperties.Name="主题" SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"><ComboBoxItem x:Uid="LA7CA42EB77955A20" Content="跟随系统" /><ComboBoxItem x:Uid="LF04E70133EA52F15" Content="浅色" /><ComboBoxItem x:Uid="L5D3CC214754A216D" Content="深色" /></ComboBox></tk:SettingsCard>
                                <tk:SettingsCard x:Uid="L5649A50C408C8E64" Style="{StaticResource SettingsRowStyle}" Header="显示网站图标" Description="关闭后用单色首字母代替网站图标" IsClickEnabled="True" Click="OnToggleSettingClick"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind ToggleState(ViewModel.ShowWebsiteIcons), Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><ToggleSwitch x:Uid="L0289D2A7F55BEDC8" Style="{StaticResource SettingsSwitchStyle}" IsOn="{x:Bind ViewModel.ShowWebsiteIcons, Mode=TwoWay}" AutomationProperties.Name="显示网站图标" /></StackPanel></tk:SettingsCard>
                                <tk:SettingsCard x:Uid="LEF8E3B9C8747A191" Style="{StaticResource SettingsRowStyle}" Header="语言" Description="Language changes apply after restarting the app."><ComboBox x:Uid="LF7F41775C87D8927" x:Name="LanguageSelector" MinWidth="180" SelectionChanged="OnLanguageSelectionChanged" AutomationProperties.Name="语言"><ComboBoxItem x:Uid="LA7CA42EB77955A20" Content="跟随系统" /><ComboBoxItem x:Uid="L79F188E9043784D4" Content="简体中文" /><ComboBoxItem x:Uid="LA4BB10DFA39E4EC8" Content="繁體中文" /><ComboBoxItem x:Uid="L39359D19F0615670" Content="English" /><ComboBoxItem x:Uid="L659830F0372EA244" Content="日本語" /></ComboBox></tk:SettingsCard>
                            </StackPanel></Border>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,32">
                            <TextBlock x:Uid="LC2BF5EFA0FC3386D" Text="窗口" Style="{StaticResource SettingsGroupTitleStyle}" />
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><StackPanel>
                                <tk:SettingsCard x:Uid="LABC7B888C62D0B22" Style="{StaticResource CompactSettingsRowStyle}" Header="关闭窗口时"><ComboBox x:Uid="L0A6BA99375DBB08C" MinWidth="180" AutomationProperties.Name="关闭窗口时" IsEnabled="{x:Bind ViewModel.CanConfigureTrayBehavior, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedCloseBehaviorIndex, Mode=TwoWay}"><ComboBoxItem x:Uid="L073C52C0BB2B578F" Content="最小化到通知区域" /><ComboBoxItem x:Uid="L83FE1827064A0260" Content="退出应用" /></ComboBox></tk:SettingsCard>
