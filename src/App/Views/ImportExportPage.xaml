<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App.Views.ImportExportPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:App.Converters"
    xmlns:local="using:App.Views">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="TransferRowStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="TransferNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionSecondaryTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="16" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Grid Padding="40,40,40,48" HorizontalAlignment="Stretch">
        <Border MaxWidth="680" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="导入和导出" FontSize="28" LineHeight="36" FontWeight="SemiBold"
                           Style="{ThemeResource TitleTextBlockStyle}" />
                <StackPanel Margin="0,28,0,0">
                    <Grid x:Name="OperationBusyPanel" ColumnSpacing="8" Margin="0,0,0,12"
                          Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BusyMessage, Mode=OneWay}"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                    <InfoBar IsClosable="False" Severity="Success" Title="操作完成" Margin="0,0,0,12"
                             AutomationProperties.AutomationId="OperationSucceededInfoBar" AutomationProperties.LiveSetting="Polite"
                             IsOpen="{x:Bind ViewModel.HasSucceededStatus, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.HasSucceededStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                             Message="{x:Bind ViewModel.OperationMessage, Mode=OneWay}" />
                    <InfoBar IsClosable="False" Severity="Warning" Title="导入已完成，需要同步" Margin="0,0,0,12"
                             AutomationProperties.AutomationId="OperationWarningInfoBar" AutomationProperties.LiveSetting="Polite"
                             IsOpen="{x:Bind ViewModel.HasWarningStatus, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.HasWarningStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                             Message="{x:Bind ViewModel.OperationMessage, Mode=OneWay}" />
                    <InfoBar IsClosable="False" Severity="Informational" Title="操作已取消" Margin="0,0,0,12"
                             AutomationProperties.AutomationId="OperationCancelledInfoBar" AutomationProperties.LiveSetting="Polite"
                             IsOpen="{x:Bind ViewModel.HasCancelledStatus, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.HasCancelledStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                             Message="{x:Bind ViewModel.OperationMessage, Mode=OneWay}" />
                    <InfoBar IsClosable="False" Severity="Error" Title="操作失败" Margin="0,0,0,12"
                             AutomationProperties.AutomationId="OperationFailedInfoBar" AutomationProperties.LiveSetting="Assertive"
                             IsOpen="{x:Bind ViewModel.HasFailedStatus, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.HasFailedStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                             Message="{x:Bind ViewModel.OperationMessage, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,32">
                    <TextBlock Text="导入" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <StackPanel>
                            <Border Style="{StaticResource TransferRowStyle}">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="格式" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" MinWidth="180" Height="32" HorizontalAlignment="Right"
                                              AutomationProperties.AutomationId="ImportFormatCombo" AutomationProperties.Name="导入格式"
                                              IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}"
                                              SelectedIndex="{x:Bind ViewModel.ImportFormatIndex, Mode=TwoWay}"
                                              SelectionChanged="OnImportFormatSelectionChanged">
                                        <ComboBoxItem Content="Bitwarden（.json）" />
                                        <ComboBoxItem Content="Bitwarden（.csv）" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource TransferRowStyle}" MinHeight="64">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="文件" />
                                        <TextBlock Text="{x:Bind local:ImportExportPage.FormatImportFile(ViewModel.ImportContent, ViewModel.ImportFileLabel), Mode=OneWay}"
                                                   Style="{StaticResource TransferNoteStyle}" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Height="32" Padding="14,0" VerticalAlignment="Center"
                                            Content="{x:Bind local:ImportExportPage.FormatChooseFileButton(ViewModel.ImportContent), Mode=OneWay}"
                                            AutomationProperties.AutomationId="ImportChooseFileButton"
                                            IsEnabled="{x:Bind ViewModel.CanOperate, Mode=OneWay}" Click="OnChooseImportFileClick" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource TransferRowStyle}" MinHeight="64">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="导入方式" />
                                        <TextBlock Text="导入的条目会新增，不会覆盖已有条目" Style="{StaticResource TransferNoteStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="保留文件中的文件夹" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="ImportPreviewPanel" Margin="0,12,0,0"
                                Visibility="{x:Bind ViewModel.HasValidPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource TransferNoteStyle}" AutomationProperties.LiveSetting="Polite">
                            <Run Text="文件已就绪：" /><Run Text="{x:Bind ViewModel.PreviewCipherCount, Mode=OneWay}" />
                            <Run Text=" 个条目，" /><Run Text="{x:Bind ViewModel.PreviewFolderCount, Mode=OneWay}" /><Run Text=" 个文件夹" />
                        </TextBlock>
                    </StackPanel>
                    <Button Content="重新预览" Margin="0,12,0,0" Height="32" Padding="14,0"
                            Command="{x:Bind ViewModel.PreviewImportCommand}" IsEnabled="{x:Bind ViewModel.CanPreviewAgain, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CanPreviewAgain, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Grid Margin="0,16,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="ImportButton" Height="32" Padding="20,0" Style="{ThemeResource AccentButtonStyle}"
                                Content="{x:Bind local:ImportExportPage.FormatImportButton(ViewModel.CurrentOperation), Mode=OneWay}"
                                AutomationProperties.AutomationId="ImportButton" IsEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}"
                                Command="{x:Bind ViewModel.DoImportCommand}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind local:ImportExportPage.FormatImportHint(ViewModel.ImportContent), Mode=OneWay}"
                                   VerticalAlignment="Center" Style="{StaticResource TransferNoteStyle}" />
                    </Grid>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="导出" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    <InfoBar x:Name="ExportPolicyInfoBar" IsClosable="False" Severity="Warning" Margin="0,0,0,12"
                             IsOpen="{x:Bind ViewModel.ShowExportPolicyInfo, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.ShowExportPolicyInfo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                             Message="{x:Bind ViewModel.ExportPolicyNotice, Mode=OneWay}" />
                    <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <StackPanel>
                            <Border Style="{StaticResource TransferRowStyle}" MinHeight="64">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="格式" />
                                        <TextBlock Text="不加密：任何拿到文件的人都能看到全部密码" Style="{StaticResource TransferNoteStyle}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" MinWidth="180" Height="32" VerticalAlignment="Center"
                                              AutomationProperties.AutomationId="ExportFormatCombo" AutomationProperties.Name="导出格式"
                                              IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
                                              SelectedIndex="{x:Bind ViewModel.ExportFormatIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content=".json · 不加密" />
                                        <ComboBoxItem Content=".csv · 不加密" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource TransferRowStyle}" MinHeight="64">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="导出内容" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="个人密码库中的条目，包含已归档条目" TextAlignment="Right" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="不包含组织条目、回收站、附件和 Send" TextAlignment="Right" Style="{StaticResource TransferNoteStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{x:Bind ViewModel.ExportFormatDescription, Mode=OneWay}"
                               Margin="0,12,0,0" Style="{StaticResource TransferNoteStyle}" />
                    <Grid Margin="0,16,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Height="32" Padding="20,0" Style="{ThemeResource AccentButtonStyle}"
                                Content="{x:Bind local:ImportExportPage.FormatExportButton(ViewModel.CurrentOperation), Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}" AutomationProperties.AutomationId="ExportButton" Click="OnExportClick" />
                        <TextBlock Grid.Column="1" Text="验证主密码后，选择文件保存位置" VerticalAlignment="Center" Style="{StaticResource TransferNoteStyle}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
        </Grid>
    </ScrollViewer>
</Page>
