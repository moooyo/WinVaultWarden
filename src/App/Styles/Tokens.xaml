<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="WardenLayerBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="WardenMicaBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="WardenLineBrush" Color="#EBEBEB" />
            <SolidColorBrush x:Key="WardenSurfaceStrokeBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="WardenPrimaryTextBrush" Color="#1B1B1B" />
            <SolidColorBrush x:Key="WardenSecondaryTextBrush" Color="#555555" />
            <SolidColorBrush x:Key="WardenTertiaryTextBrush" Color="#6B6B6B" />
            <SolidColorBrush x:Key="WardenTileBrush" Color="#EFEFEF" />
            <SolidColorBrush x:Key="WardenCopyFlashBrush" Color="#29005FB8" />
            <SolidColorBrush x:Key="WardenCriticalBackgroundBrush" Color="#FDE7E9" />
            <SolidColorBrush x:Key="WardenCautionBackgroundBrush" Color="#FFF4CE" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="WardenLayerBrush" Color="#282828" />
            <SolidColorBrush x:Key="WardenMicaBrush" Color="#202020" />
            <SolidColorBrush x:Key="WardenLineBrush" Color="#333333" />
            <SolidColorBrush x:Key="WardenSurfaceStrokeBrush" Color="#3B3B3B" />
            <SolidColorBrush x:Key="WardenPrimaryTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="WardenSecondaryTextBrush" Color="#C8C8C8" />
            <SolidColorBrush x:Key="WardenTertiaryTextBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="WardenTileBrush" Color="#363636" />
            <SolidColorBrush x:Key="WardenCopyFlashBrush" Color="#3D60CDFF" />
            <SolidColorBrush x:Key="WardenCriticalBackgroundBrush" Color="#442726" />
            <SolidColorBrush x:Key="WardenCautionBackgroundBrush" Color="#433519" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="WardenLayerBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WardenMicaBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WardenLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WardenSurfaceStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WardenPrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WardenSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WardenTertiaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WardenTileBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WardenCopyFlashBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="WardenCriticalBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WardenCautionBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Shared dimensions follow the v4 handoff in effective pixels. -->
    <FontFamily x:Key="WardenTextFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="WardenDisplayFontFamily">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
    <x:Double x:Key="WardenPaneWidth">232</x:Double>
    <x:Double x:Key="WardenListWidth">344</x:Double>
    <Thickness x:Key="WardenDetailPadding">40,32</Thickness>
    <Style x:Key="WardenCountTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource WardenTertiaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="WardenCompactNewStyle" TargetType="NavigationViewItem">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="4,4,4,8" />
    </Style>
    <Style x:Key="WardenAccentSplitButtonStyle" TargetType="SplitButton">
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="WardenNavigationHeaderStyle" TargetType="NavigationViewItem">
        <Setter Property="Height" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="14,16,4,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource WardenSecondaryTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="WardenTabButtonStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="TabRoot" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="TabRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="TabRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="TabContent.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Checked"><VisualState.Setters>
                                    <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <Setter Target="TabContent.FontWeight" Value="SemiBold" />
                                </VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPointerOver"><VisualState.Setters>
                                    <Setter Target="TabRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <Setter Target="TabContent.FontWeight" Value="SemiBold" />
                                </VisualState.Setters></VisualState>
                                <VisualState x:Name="CheckedPressed"><VisualState.Setters>
                                    <Setter Target="TabContent.FontWeight" Value="SemiBold" />
                                </VisualState.Setters></VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="TabContent" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Spacing uses a four-pixel base unit. -->
    <x:Double x:Key="SpacingXSmall">4</x:Double>
    <x:Double x:Key="SpacingSmall">8</x:Double>
    <x:Double x:Key="SpacingMedium">12</x:Double>
    <x:Double x:Key="SpacingLarge">16</x:Double>
    <x:Double x:Key="SpacingXLarge">24</x:Double>

    <!-- Shared corner radii and content insets. -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <Thickness x:Key="CardContentPadding">16</Thickness>
    <Thickness x:Key="CardContentPaddingCompact">16</Thickness>
    <Thickness x:Key="PageContentPadding">24</Thickness>

    <!-- Utility typography. -->
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Section titles establish a consistent text hierarchy. -->
    <Style x:Key="SectionHeaderTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Secondary captions share a theme-aware foreground. -->
    <Style x:Key="CaptionSecondaryTextBlockStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <!-- Shared icon badges for list rows and identity tiles. -->
    <Style x:Key="IconBadgeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Icon actions retain the native focus and interaction states. -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{ThemeResource WardenSecondaryTextBrush}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <!-- Shared card chrome for surfaces that require a container. -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

</ResourceDictionary>
