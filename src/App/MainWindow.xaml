<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="App.MainWindow" Title="WinVaultWarden"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="7" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="WinVaultWarden" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
        <muxc:NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="248"
                             IsBackButtonVisible="Collapsed" IsSettingsVisible="False" ItemInvoked="Nav_ItemInvoked">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem x:Name="AllItemsNavItem" Content="我的保险库" Tag="vault" IsSelected="True">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="SendNavItem" Content="Send" Tag="send:all">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE724;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="GeneratorNavItem" Content="生成器" Tag="gen">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="ReportsNavItem" Content="安全报告" Tag="reports">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xEA18;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItemHeader x:Name="VaultContextHeader" Content="保险库范围" />
                <muxc:NavigationViewItem x:Name="AllScopeNavItem" Content="所有项目" Tag="vault:allitems">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE80A;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="FavoritesNavItem" Content="收藏" Tag="vault:favorites">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="FoldersNavItem" Content="文件夹" SelectsOnInvoked="False" IsExpanded="True">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="OrganizationsNavItem" Content="组织" SelectsOnInvoked="False">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE716;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="CollectionsNavItem" Content="集合" SelectsOnInvoked="False">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="ArchiveNavItem" Content="归档" Tag="vault:archive">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE7B8;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="TrashNavItem" Content="回收站" Tag="vault:trash">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>
            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem x:Name="TransferNavItem" Content="导入与导出" Tag="io">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="DevicesNavItem" Content="设备管理" Tag="devices">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="SettingsNavItem" Content="设置" Tag="settings">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="锁定" Tag="lock" SelectsOnInvoked="False">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="退出登录" Tag="logout" SelectsOnInvoked="False">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xF3B1;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>
            <muxc:NavigationView.PaneFooter>
                <Grid Padding="16,12" ColumnSpacing="12" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <PersonPicture x:Name="AccountPicture" Width="32" Height="32" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="AccountEmailText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AccountServerText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </muxc:NavigationView.PaneFooter>
            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>
        <Grid x:Name="LoginHost" Grid.Row="1" Visibility="Collapsed"><Frame x:Name="LoginFrame" /></Grid>
    </Grid>
</Window>
