<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="App.MainWindow" Title="WinVaultWarden"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
 <Grid x:Name="ShellRoot" Language="zh-CN" SizeChanged="OnShellSizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,0,0" ColumnSpacing="4">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="RightPaddingColumn" Width="138"/></Grid.ColumnDefinitions>
   <StackPanel x:Name="BrandPanel" Orientation="Horizontal" Spacing="10" Margin="0,0,16,0" VerticalAlignment="Center">
    <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="18" Height="18"/><TextBlock x:Name="AppNameText" Text="WinVaultWarden" FontSize="12" VerticalAlignment="Center"/>
   </StackPanel>
   <StackPanel x:Name="TopTabs" Grid.Column="1" Orientation="Horizontal">
    <ToggleButton x:Name="VaultTab" Content="密码库" Tag="vault" Style="{StaticResource WardenTabButtonStyle}" Click="OnTopTabClick"/>
    <ToggleButton x:Name="GeneratorTab" Content="生成器" Tag="gen" Style="{StaticResource WardenTabButtonStyle}" Click="OnTopTabClick"/>
    <ToggleButton x:Name="SendTab" Content="Send" Tag="send:all" Style="{StaticResource WardenTabButtonStyle}" Click="OnTopTabClick"/>
    <ToggleButton x:Name="ReportsTab" Tag="reports" Style="{StaticResource WardenTabButtonStyle}" Click="OnTopTabClick">
     <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="安全报告"/><TextBlock x:Name="ReportIssueCount" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"/></StackPanel>
    </ToggleButton>
   </StackPanel>
   <Border x:Name="SelectedTabIndicator" Grid.Column="1" Width="16" Height="3" CornerRadius="2" Margin="0,0,0,6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False" Visibility="Collapsed"><Border.RenderTransform><TranslateTransform x:Name="SelectedTabTranslation"/></Border.RenderTransform></Border>
   <Grid x:Name="TitleSearchHost" Grid.Column="2" Margin="12,0,8,0" MaxWidth="360" VerticalAlignment="Center">
    <TextBox x:Name="TitleSearch" PlaceholderText="搜索密码库" Height="32" MinWidth="160" Padding="12,4,30,4" AutomationProperties.Name="搜索密码库" ToolTipService.ToolTip="Ctrl + F" TextChanged="OnTitleSearchChanged" KeyDown="OnTitleSearchKeyDown" LostFocus="OnTitleSearchLostFocus"/>
    <FontIcon x:Name="TitleSearchIcon" Glyph="&#xE721;" FontSize="14" HorizontalAlignment="Right" Margin="0,0,10,0" IsHitTestVisible="False" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Button x:Name="ClearSearchButton" Visibility="Collapsed" Width="24" Height="24" MinWidth="24" MinHeight="24" HorizontalAlignment="Right" Margin="0,0,4,0" Padding="4" Style="{StaticResource IconButtonStyle}" Click="OnClearSearchClick" ToolTipService.ToolTip="清除搜索" AutomationProperties.Name="清除搜索"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button>
   </Grid>
   <StackPanel x:Name="TitleActions" Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0" VerticalAlignment="Center">
    <Button x:Name="CompactSearchButton" Width="40" Style="{StaticResource IconButtonStyle}" Visibility="Collapsed" Click="OnCompactSearchClick" ToolTipService.ToolTip="搜索 · Ctrl + F" AutomationProperties.Name="搜索"><FontIcon Glyph="&#xE721;" FontSize="16"/></Button>
    <Button x:Name="ThemeButton" Width="40" Style="{StaticResource IconButtonStyle}" Click="OnThemeClick" ToolTipService.ToolTip="切换深色 / 浅色" AutomationProperties.Name="切换主题"><FontIcon x:Name="ThemeIcon" Glyph="&#xE708;" FontSize="16"/></Button>
    <Button x:Name="LockButton" Width="40" Style="{StaticResource IconButtonStyle}" Click="OnLockClick" ToolTipService.ToolTip="立即锁定" AutomationProperties.Name="立即锁定"><FontIcon Glyph="&#xE72E;" FontSize="16"/></Button>
    <Button x:Name="SettingsButton" Width="40" Style="{StaticResource IconButtonStyle}" Click="OnSettingsClick" ToolTipService.ToolTip="设置" AutomationProperties.Name="设置"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button>
    <Button x:Name="AccountButton" Style="{StaticResource IconButtonStyle}" Padding="4,0" Margin="4,0,0,0" AutomationProperties.Name="账户">
     <PersonPicture x:Name="AccountPicture" Width="28" Height="28"/>
     <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="账户设置" Tag="settings:account" Click="OnShellMenuClick"/><MenuFlyoutItem Text="立即锁定" Tag="lock" Click="OnShellMenuClick"/><MenuFlyoutSeparator/><MenuFlyoutItem Text="退出登录" Tag="logout" Click="OnShellMenuClick"/></MenuFlyout></Button.Flyout>
    </Button>
   </StackPanel>
  </Grid>
  <muxc:NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="232" CompactPaneLength="48" ExpandedModeThresholdWidth="1200" CompactModeThresholdWidth="640" IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneOpen="True" ItemInvoked="Nav_ItemInvoked" DisplayModeChanged="OnNavDisplayModeChanged">
   <muxc:NavigationView.PaneHeader>
    <StackPanel x:Name="PaneActions" Margin="8,4,8,12" Spacing="6">
     <Button x:Name="PaneToggleButton" Style="{StaticResource IconButtonStyle}" Width="40" Visibility="Collapsed" Click="OnPaneToggleClick" ToolTipService.ToolTip="展开导航" AutomationProperties.Name="展开导航"><FontIcon Glyph="&#xE700;" FontSize="16"/></Button>
     <SplitButton x:Name="NewVaultButton" HorizontalAlignment="Stretch" Style="{StaticResource WardenAccentSplitButtonStyle}" Click="OnNewVaultClick">
      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="16"/><TextBlock Text="新建项目"/></StackPanel>
      <SplitButton.Flyout><MenuFlyout>
       <MenuFlyoutItem Text="登录" Tag="Login" Click="OnNewVaultMenuClick"/><MenuFlyoutItem Text="支付卡" Tag="Card" Click="OnNewVaultMenuClick"/><MenuFlyoutItem Text="身份" Tag="Identity" Click="OnNewVaultMenuClick"/><MenuFlyoutItem Text="安全笔记" Tag="Note" Click="OnNewVaultMenuClick"/><MenuFlyoutItem Text="SSH 密钥" Tag="Ssh" Click="OnNewVaultMenuClick"/>
       <MenuFlyoutSeparator/><MenuFlyoutItem Text="银行账户" Tag="BankAccount" Click="OnNewVaultMenuClick"/><MenuFlyoutItem Text="驾驶证" Tag="DriversLicense" Click="OnNewVaultMenuClick"/><MenuFlyoutItem Text="护照" Tag="Passport" Click="OnNewVaultMenuClick"/>
      </MenuFlyout></SplitButton.Flyout>
     </SplitButton>
     <SplitButton x:Name="NewSendButton" HorizontalAlignment="Stretch" Style="{StaticResource WardenAccentSplitButtonStyle}" Visibility="Collapsed" Click="OnNewSendClick">
      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="16"/><TextBlock Text="新建 Send"/></StackPanel>
      <SplitButton.Flyout><MenuFlyout><MenuFlyoutItem Text="文本" Tag="Text" Click="OnNewSendMenuClick"/><MenuFlyoutItem Text="文件" Tag="File" Click="OnNewSendMenuClick"/></MenuFlyout></SplitButton.Flyout>
     </SplitButton>
     <Button x:Name="CompactNewButton" Style="{StaticResource AccentButtonStyle}" Width="40" Padding="0" Visibility="Collapsed" Click="OnCompactNewClick" ToolTipService.ToolTip="新建" AutomationProperties.Name="新建"><FontIcon Glyph="&#xE710;" FontSize="16"/></Button>
     <Button x:Name="RecheckButton" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="OnRecheckClick"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="16"/><TextBlock x:Name="RecheckLabel" Text="重新检查"/></StackPanel></Button>
     <Button x:Name="SettingsAccountHeader" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource IconButtonStyle}" Padding="8,10" Visibility="Collapsed" Tag="settings:account" Click="OnShellMenuClick">
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <PersonPicture x:Name="PaneAccountPicture" Width="40" Height="40"/>
       <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock x:Name="AccountNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="AccountEmailText" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
      </Grid>
     </Button>
    </StackPanel>
   </muxc:NavigationView.PaneHeader>
   <muxc:NavigationView.MenuItems>
    <muxc:NavigationViewItem x:Name="AllItemsNavItem" Content="全部条目" Tag="vault:allitems"><muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" FontSize="16"/></muxc:NavigationViewItem.Icon></muxc:NavigationViewItem>
    <muxc:NavigationViewItem x:Name="FavoritesNavItem" Content="收藏" Tag="vault:favorites"><muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" FontSize="16"/></muxc:NavigationViewItem.Icon></muxc:NavigationViewItem>
    <muxc:NavigationViewItem x:Name="TotpNavItem" Content="验证码" Tag="vault:totp"><muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE916;" FontSize="16"/></muxc:NavigationViewItem.Icon></muxc:NavigationViewItem>
    <muxc:NavigationViewItem x:Name="FoldersNavItem" Content="文件夹" SelectsOnInvoked="False" IsExpanded="True"><muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" FontSize="16"/></muxc:NavigationViewItem.Icon></muxc:NavigationViewItem>
    <muxc:NavigationViewItem x:Name="OrganizationsNavItem" Content="共享" SelectsOnInvoked="False" IsExpanded="True"><muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE716;" FontSize="16"/></muxc:NavigationViewItem.Icon></muxc:NavigationViewItem>
    <muxc:NavigationViewItem x:Name="CollectionsNavItem" Content="集合" SelectsOnInvoked="False"><muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" FontSize="16"/></muxc:NavigationViewItem.Icon></muxc:NavigationViewItem>
   </muxc:NavigationView.MenuItems>
   <muxc:NavigationView.FooterMenuItems>
    <muxc:NavigationViewItem x:Name="ArchiveNavItem" Content="归档" Tag="vault:archive"><muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE7B8;" FontSize="16"/></muxc:NavigationViewItem.Icon></muxc:NavigationViewItem>
    <muxc:NavigationViewItem x:Name="TrashNavItem" Content="回收站" Tag="vault:trash"><muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;" FontSize="16"/></muxc:NavigationViewItem.Icon></muxc:NavigationViewItem>
   </muxc:NavigationView.FooterMenuItems>
   <Border Background="{ThemeResource WardenLayerBrush}" BorderBrush="{ThemeResource WardenSurfaceStrokeBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0"><Frame x:Name="ContentFrame"/></Border>
  </muxc:NavigationView>
  <Grid x:Name="LoginHost" Grid.Row="1" Visibility="Collapsed"><Frame x:Name="LoginFrame"/></Grid>
  <Grid x:Name="StatusBar" Grid.Row="2" Height="28" Padding="10,0,6,0" BorderBrush="{ThemeResource WardenSurfaceStrokeBrush}" BorderThickness="0,1,0,0" ColumnSpacing="16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="SyncStatusButton" Height="22" MinHeight="22" Padding="6,0" Style="{StaticResource IconButtonStyle}" Click="OnSyncClick" ToolTipService.ToolTip="立即同步"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE895;" FontSize="14"/><TextBlock x:Name="SyncStatusText" Text="密码库已解锁" FontSize="12"/></StackPanel></Button>
   <TextBlock x:Name="AccountServerText" Grid.Column="1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
   <Button x:Name="SshStatusButton" Grid.Column="2" Height="22" MinHeight="22" Style="{StaticResource IconButtonStyle}" Padding="0" Tag="settings:ssh" Click="OnShellMenuClick" ToolTipService.ToolTip="SSH 代理设置"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE756;" FontSize="14"/><TextBlock x:Name="SshStatusLabel" Text="SSH 代理未启用" FontSize="12"/></StackPanel></Button>
   <StackPanel x:Name="GraceStatus" Grid.Column="4" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" VerticalAlignment="Center"><FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/><TextBlock x:Name="GraceStatusText" FontSize="12" VerticalAlignment="Center"/><Button Content="结束" Height="22" MinHeight="22" Padding="4,0" FontSize="12" Style="{StaticResource IconButtonStyle}" Click="OnEndGraceClick"/></StackPanel>
   <StackPanel x:Name="ClipboardStatus" Grid.Column="5" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" VerticalAlignment="Center"><FontIcon Glyph="&#xE77F;" FontSize="14"/><TextBlock x:Name="ClipboardStatusText" FontSize="12" VerticalAlignment="Center"/><Button x:Name="ClearClipboardButton" Content="立即清除" Height="22" MinHeight="22" Padding="4,0" FontSize="12" Style="{StaticResource IconButtonStyle}" Click="OnClearClipboardClick"/></StackPanel>
  </Grid>
  <Border x:Name="NoticeHost" Grid.Row="1" Background="{ThemeResource WardenLayerBrush}" BorderBrush="{ThemeResource WardenSurfaceStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16,8,8,8" Margin="20,0,20,20" VerticalAlignment="Bottom" HorizontalAlignment="Center" Visibility="Collapsed">
   <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    <TextBlock x:Name="NoticeText" Grid.Column="1" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
    <Button Grid.Column="2" Click="OnDismissNoticeClick" Style="{StaticResource IconButtonStyle}" AutomationProperties.Name="关闭通知" ToolTipService.ToolTip="关闭通知"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button>
   </Grid>
  </Border>
 </Grid>
</Window>
