<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="App.Controls.FieldRow"
    x:Name="Root"
    FontSize="14"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="RowBorder" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
        <Grid x:Name="RowGrid" MinHeight="48" ColumnSpacing="16" Padding="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LabelColumn" Width="112" />
                <ColumnDefinition x:Name="ValueColumn" Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LabelText" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <StackPanel x:Name="ValuePanel" Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <!-- Adjacent Run elements avoid implicit whitespace in secret masks. -->
                <TextBlock x:Name="ValueText" FontSize="{x:Bind FontSize, Mode=OneWay}" LineHeight="20"
                           LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis"><Run x:Name="PrimaryValueRun" /><Run x:Name="SecondaryValueRun" /></TextBlock>
                <TextBlock x:Name="CopyFeedback" Visibility="Collapsed" FontSize="12" LineHeight="16"
                           LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel x:Name="ActionsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Uid="L8E1A707B572C47DC" x:Name="RevealButton" Visibility="Collapsed" Click="OnReveal" Style="{StaticResource IconButtonStyle}"
                        Width="32" Height="32" AutomationProperties.Name="显示" ToolTipService.ToolTip="显示（需 Windows Hello）">
                    <FontIcon x:Name="RevealIcon" Glyph="&#xE890;" FontSize="16" />
                </Button>
                <Button x:Uid="LE79B396842D0750F" x:Name="OpenButton" Visibility="Collapsed" Click="OnOpen" Style="{StaticResource IconButtonStyle}"
                        Width="32" Height="32" AutomationProperties.Name="在浏览器中打开" ToolTipService.ToolTip="在浏览器中打开">
                    <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                </Button>
                <Button x:Uid="LC49CD99FA7E71B10" x:Name="CopyButton" Click="OnCopy" Style="{StaticResource IconButtonStyle}"
                        MinWidth="32" Height="32" AutomationProperties.Name="字段，复制" ToolTipService.ToolTip="复制">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="CopyIcon" Glyph="&#xE8C8;" FontSize="16" />
                        <TextBlock x:Name="CopyLabel" Visibility="Collapsed" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
