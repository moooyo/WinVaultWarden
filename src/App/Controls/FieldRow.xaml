<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="App.Controls.FieldRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FieldRowIconCopyButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}" />
        <Style x:Key="FieldRowTextCopyButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Padding" Value="12,6" />
        </Style>
    </UserControl.Resources>
    <Grid ColumnSpacing="12" Padding="0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="5" VerticalAlignment="Center">
            <TextBlock x:Name="LabelText" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
            <TextBlock x:Name="ValueText" FontSize="14" TextWrapping="Wrap" />
            <TextBlock x:Name="CopyFeedback" Visibility="Collapsed" TextWrapping="Wrap"
                       Style="{StaticResource CaptionSecondaryTextBlockStyle}"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button x:Name="RevealButton" Visibility="Collapsed" Click="OnReveal"
                    Style="{StaticResource IconButtonStyle}"
                    AutomationProperties.Name="显示"
                    ToolTipService.ToolTip="显示">
                <FontIcon x:Name="RevealIcon" Glyph="&#xE890;" FontSize="14" />
            </Button>
            <Button x:Name="OpenButton" Visibility="Collapsed" Click="OnOpen"
                    Style="{StaticResource IconButtonStyle}"
                    AutomationProperties.Name="打开链接"
                    ToolTipService.ToolTip="打开">
                <FontIcon Glyph="&#xE8A7;" FontSize="14" />
            </Button>
            <Button x:Name="CopyButton"
                    Click="OnCopy"
                    Style="{StaticResource FieldRowIconCopyButtonStyle}"
                    AutomationProperties.Name="字段，复制"
                    ToolTipService.ToolTip="复制">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    <TextBlock x:Name="CopyLabel" Visibility="Collapsed" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
