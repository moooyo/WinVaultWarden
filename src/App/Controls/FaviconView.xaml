<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="App.Controls.FaviconView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="TileBorder" CornerRadius="6">
      <Grid>
        <TextBlock x:Name="LetterText" FontSize="14" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   AutomationProperties.AccessibilityView="Raw" />
        <FontIcon x:Name="GlyphIcon" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
        <Image x:Name="IconImage" Stretch="Uniform" Visibility="Collapsed"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               ImageOpened="OnImageOpened" ImageFailed="OnImageFailed"
               AutomationProperties.AccessibilityView="Raw" />
      </Grid>
    </Border>
</UserControl>
