<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="App.Controls.DetailCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       Margin="0,14,0,6"
                       Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
            <ContentPresenter x:Name="CardContentPresenter" />
        </StackPanel>
    </Border>
</UserControl>
