<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="App.Controls.TotpField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="RowBorder" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
        <Grid x:Name="RowGrid" MinHeight="48" ColumnSpacing="16" Padding="0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LabelColumn" Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LabelText" Text="验证码" FontSize="14" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock x:Name="CodeText" FontFamily="{StaticResource MonospaceFontFamily}" FontSize="26"
                               FontWeight="SemiBold" CharacterSpacing="20" LineHeight="32" VerticalAlignment="Center" />
                    <StackPanel x:Name="CountdownPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ProgressRing x:Name="Ring" Width="16" Height="16" MinWidth="16" MinHeight="16"
                                      IsIndeterminate="False" Minimum="0" Maximum="30" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="SecondsText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   MinWidth="14" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="CopyFeedback" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <Button x:Name="CopyButton" Grid.Column="2" Click="OnCopy" Width="32" Height="32"
                    Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                    AutomationProperties.Name="复制验证码" ToolTipService.ToolTip="复制验证码">
                <FontIcon x:Name="CopyIcon" Glyph="&#xE8C8;" FontSize="16" />
            </Button>
        </Grid>
    </Border>
</UserControl>
