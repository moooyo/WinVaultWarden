<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="App.Controls.TotpField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <Grid ColumnSpacing="12" Padding="0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="5">
            <TextBlock Text="验证码 (TOTP)" Style="{StaticResource CaptionSecondaryTextBlockStyle}" />
            <TextBlock x:Name="CodeText"
                   FontFamily="{StaticResource MonospaceFontFamily}"
                   FontSize="26"
                   VerticalAlignment="Center" />
            <TextBlock x:Name="CopyFeedback" Visibility="Collapsed" TextWrapping="Wrap"
                       Style="{StaticResource CaptionSecondaryTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <muxc:ProgressRing x:Name="Ring" Width="18" Height="18" IsIndeterminate="False"
                               Minimum="0" Maximum="30" VerticalAlignment="Center" />
            <TextBlock x:Name="SecondsText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       MinWidth="16" TextAlignment="Right" VerticalAlignment="Center" />
            <Button x:Name="CopyButton" Click="OnCopy"
                    Style="{StaticResource IconButtonStyle}"
                    AutomationProperties.Name="TOTP，复制"
                    ToolTipService.ToolTip="复制">
                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
