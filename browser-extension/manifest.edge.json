{
  "manifest_version": 3,
  "name": "WinVaultWarden Browser Integration",
  "description": "WinVaultWarden passkey bridge for the browser.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/error-map.js",
        "src/request-coordinator.js",
        "src/page-webauthn.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/request-coordinator.js",
        "src/content-webauthn.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
