  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Core/Core.csproj" />
    <ProjectReference Include="../../src/Crypto/Crypto.csproj" />
    <ProjectReference Include="../../src/Vault/Vault.csproj" />
    <Compile Include="../../src/App/Services/IWindowsPasskeyProvider.cs" Link="Production/IWindowsPasskeyProvider.cs" />
    <Compile Include="../../src/App/Services/WindowsPasskeyPlatformApi.cs" Link="Production/WindowsPasskeyPlatformApi.cs" />
